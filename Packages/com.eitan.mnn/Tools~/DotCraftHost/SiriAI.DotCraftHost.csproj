<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <DefineConstants>$(DefineConstants);DOTCRAFT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../HarnessHost/*.cs" LinkBase="Host" />
    <ProjectReference Include="../HarnessCore/MNN.HarnessCore.csproj" />
    <PackageReference Include="DotCraft.Harness" Version="[0.10.4]" />
  </ItemGroup>
</Project>
