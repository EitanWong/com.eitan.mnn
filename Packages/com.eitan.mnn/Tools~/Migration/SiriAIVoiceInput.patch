diff --git a/Assets/Samples/SiriAI/Scripts/Tests/Editor/Conversation/SiriAIUnityRecordingTests.cs b/Assets/Samples/SiriAI/Scripts/Tests/Editor/Conversation/SiriAIUnityRecordingTests.cs
--- a/Assets/Samples/SiriAI/Scripts/Tests/Editor/Conversation/SiriAIUnityRecordingTests.cs
+++ b/Assets/Samples/SiriAI/Scripts/Tests/Editor/Conversation/SiriAIUnityRecordingTests.cs
@@ -36,6 +36,70 @@
             yield return new EnterPlayMode();
             yield return RunPhysicalRecordings();
             yield return new ExitPlayMode();
+        }
+
+        [UnityTest, Explicit("Uses the connected C930c camera and its microphone together; stores counters only, no recordings.")]
+        public IEnumerator C930cCameraAndMicrophoneCaptureTogether()
+        {
+            yield return new EnterPlayMode();
+            foreach (bool microphoneFirst in new[] { true, false })
+                yield return CaptureC930c(microphoneFirst);
+            yield return new ExitPlayMode();
+        }
+
+        private static IEnumerator CaptureC930c(bool microphoneFirst)
+        {
+            string cameraName = Array.Find(Array.ConvertAll(WebCamTexture.devices, camera => camera.name),
+                name => name.IndexOf("C930", StringComparison.OrdinalIgnoreCase) >= 0);
+            string microphoneName = Array.Find(Microphone.devices,
+                name => name.IndexOf("C930", StringComparison.OrdinalIgnoreCase) >= 0);
+            Assert.IsNotNull(cameraName, "Connect the C930c camera.");
+            Assert.IsNotNull(microphoneName, "Connect the C930c microphone.");
+            var root = new GameObject("C930c simultaneous capture");
+            var microphone = root.AddComponent<MNNUnityMicrophoneCapture>();
+            var device = root.AddComponent<MNNRealtimeAudioDevice>();
+            var output = new MNNRealtimeOutputPipeline(new MNNPcmFormat(48000, 2), 480);
+            var camera = new WebCamTexture(cameraName, 1280, 720, 30);
+            try
+            {
+                Action startMicrophone = () => microphone.StartCaptureNegotiated(device,
+                    (format, capacity) => device.Bind(output, format, 64, capacity), microphoneName);
+                if (microphoneFirst) startMicrophone(); else camera.Play();
+                double deadline = Time.realtimeSinceStartupAsDouble + 15;
+                while ((microphoneFirst ? !microphone.IsCapturing : camera.width <= 16) &&
+                    Time.realtimeSinceStartupAsDouble < deadline) yield return null;
+                if (microphoneFirst) camera.Play(); else startMicrophone();
+                deadline = Time.realtimeSinceStartupAsDouble + 15;
+                while ((!microphone.IsCapturing || camera.width <= 16) &&
+                    Time.realtimeSinceStartupAsDouble < deadline) yield return null;
+                Assert.IsTrue(microphone.IsCapturing, microphone.Fault?.ToString());
+                Assert.Greater(camera.width, 16);
+                var pcm = new float[device.MaximumCaptureSamples];
+                for (int window = 0; window < 3; ++window)
+                {
+                    long samples = 0; int videoFrames = 0;
+                    deadline = Time.realtimeSinceStartupAsDouble + 1;
+                    while (Time.realtimeSinceStartupAsDouble < deadline)
+                    {
+                        while (device.TryReadCapture(pcm, 0, out _, out int count)) samples += count;
+                        if (camera.didUpdateThisFrame) ++videoFrames;
+                        yield return null;
+                    }
+                    TestContext.WriteLine("C930c microphoneFirst=" + microphoneFirst + " window=" + window +
+                        " videoFrames=" + videoFrames + " audioSamples=" + samples + " format=" + device.CaptureFormat);
+                    Assert.Greater(videoFrames, 0, "Camera frames stopped while microphone was active.");
+                    Assert.Greater(samples, 0, "Microphone stopped while the camera was active.");
+                    Assert.IsTrue(Microphone.IsRecording(microphoneName));
+                    Assert.IsNull(microphone.Fault);
+                }
+            }
+            finally
+            {
+                camera.Stop();
+                microphone.StopCapture();
+                UnityEngine.Object.DestroyImmediate(camera);
+                UnityEngine.Object.DestroyImmediate(root);
+            }
         }
 
         private static IEnumerator RunPhysicalRecordings()
