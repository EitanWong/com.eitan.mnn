+// Convert the emitting surface's projected height and tilt into the existing
+// calibrated wall response. This preserves its appearance without giving the
+// wall its own clock. The small second-order terms belong to the quiet curve.
+float2 thinkingWallResponse(float height, float tilt)
+{
+    float2 observation = float2(height + .0114565980, tilt - .0101424932);
+    float2 response = float2(dot(observation, float2(-4.72539739, -3.64030394)),
+        dot(observation, float2(-7.09187648, 2.18105169)));
+    [unroll] for (int iteration = 0; iteration < 3; ++iteration)
+    {
+        response /= max(length(response), 1.0);
+        float cosine2 = response.x * response.x - response.y * response.y;
+        float sine2 = 2.0 * response.x * response.y;
+        float2 second = float2(.0002684393 * cosine2 - .0057132570 * sine2,
+            .0063189001 * cosine2 - .0047713661 * sine2);
+        float2 corrected = observation - second;
+        response = float2(dot(corrected, float2(-4.72539739, -3.64030394)),
+            dot(corrected, float2(-7.09187648, 2.18105169)));
+    }
+    return response / max(length(response), 1.0);
+}
+
+float2 thinkingRibbonReflectionResponse()
+{
+    float morph = saturate(_ThinkingBlend), talking = saturate(_TalkingBlend);
+    float3 phases = thinkingPhases(morph, talking);
+    UNITY_BRANCH
+    if (phases.y >= 1.0) return 0;
+    float time = _ThinkingTime >= 0.0 ? _ThinkingTime : _Time.y;
+    float scale = thinkingProjectionScale(time, phases.y, talking);
+    float extent = max(_StrandWidth * _StrandSize, .0001);
+    float2 left = thinkingRibbonPosition(float2(-.2 * extent, thinkingRibbonCenter(-.2 * extent)), morph, talking);
+    float2 center = thinkingRibbonPosition(float2(0, thinkingRibbonCenter(0)), morph, talking);
+    float2 right = thinkingRibbonPosition(float2(.2 * extent, thinkingRibbonCenter(.2 * extent)), morph, talking);
+    const float authoredHeight = 2.50 * .399 * .77;
+    return thinkingWallResponse(center.y * scale / authoredHeight,
+        (right.y - left.y) * scale / (authoredHeight * .4));
+}
+
+float3 thinkingGlassReflectionResponse(float2 disc, float4 poses[6], float2 ribbon)
+{
+    float morph = saturate(_ThinkingBlend), talking = saturate(_TalkingBlend);
+    float3 phases = thinkingPhases(morph, talking);
+    float time = _ThinkingTime >= 0.0 ? _ThinkingTime : _Time.y;
+    float scale = thinkingProjectionScale(time, phases.y, talking);
+    float2 compact = 0;
+    float illumination = 1.0;
+    UNITY_BRANCH
+    if (phases.y > 0.0)
+    {
+        // Nearby emitters contribute more to this patch of the wall. Their
+        // actual centers/radii carry Thinking motion and the Talking wander.
+        float3 wall = float3(disc, sqrt(saturate(1.0 - dot(disc, disc))));
+        float2 mean = 0;
+        float covariance = 0, weight = 0;
+        [unroll] for (int index = 0; index < 6; ++index)
+        {
+            float4 droplet = poses[index];
+            float2 position = droplet.xy * scale;
+            float dose = siriGlassEmitterIrradiance(wall,
+                float3(position * 2.0, _TalkingCenter.z * 2.0), droplet.z * scale * 2.0);
+            mean += position * dose;
+            covariance += (position.x - _TalkingCenter.x) * (position.y - _TalkingCenter.y) * dose;
+            weight += dose;
+        }
+        mean /= max(weight, .0001);
+        covariance /= max(weight, .0001);
+        float fusion = thinkingEase(.62, 1.0, thinkingConvergence(talking));
+        mean = lerp(mean, _TalkingCenter.xy, fusion);
+        covariance *= 1.0 - fusion;
+        compact = thinkingWallResponse(mean.y / (2.50 * .399 * .77), covariance * 12.0);
+        UNITY_BRANCH
+        if (fusion > 0.0)
+        {
+            // Preserve the centered profile. Relative finite-source irradiance
+            // redistributes its light when the nucleus moves sideways/in depth.
+            float3 source = _TalkingCenter.xyz * 2.0;
+            float radius = siriTalkingRadius() * 2.0;
+            float dose = siriGlassEmitterIrradiance(wall, source, radius);
+            float reference = siriGlassEmitterIrradiance(wall, float3(0, source.y, 0), radius);
+            illumination = lerp(1.0, dose / max(reference, .0001),
+                phases.y * fusion * saturate(_StrandIntensity / 2.05));
+        }
+    }
+    // Empty glass keeps the stationary part of the existing material only.
+    return float3(lerp(ribbon, compact, phases.y) * saturate(_StrandIntensity / 2.05), illumination);
+}
