+        private static float SideReflectionRadiance(Color[] pixels, bool right)
+        {
+            int size = SiriAIOrbStyleView.Size, count = 0;
+            float sum = 0;
+            for (int y = 0; y < size; ++y)
+            for (int x = 0; x < size; ++x)
+            {
+                Vector2 p = new Vector2(x + .5f - size * .5f, y + .5f - size * .5f) * (2.36f / size);
+                if (p.magnitude < .86f || p.magnitude > .985f || Mathf.Abs(p.y) > .35f
+                    || (right ? p.x < .75f : p.x > -.75f)) continue;
+                Color color = pixels[y * size + x];
+                sum += .2126f * color.r + .7152f * color.g + .0722f * color.b;
+                ++count;
+            }
+            Assert.Greater(count, 0);
+            return sum / count;
+        }
