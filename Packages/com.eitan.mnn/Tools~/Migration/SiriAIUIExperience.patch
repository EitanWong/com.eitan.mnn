+using System.Collections;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.EventSystems;
+using UnityEngine.TestTools;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIExperienceAudioTests
+    {
+        [UnityTest]
+        public IEnumerator ProgressSearchDisclosureAndScrimClicksPlayThroughTheSelectedEndpoint()
+        {
+            yield return new EnterPlayMode();
+            var root = new GameObject("UI feedback audio routing");
+            root.SetActive(false);
+            var clip = AudioClip.Create("UI tap", 1600, 1, 16000, false);
+            try
+            {
+                var chat = root.AddComponent<SiriAIChat>();
+                chat.enabled = false;
+                var endpoint = root.AddComponent<SiriAIRecordingAudioEndpoint>();
+                chat.Configure(endpoint, root.AddComponent<MNN.Unity.MNNRealtimeSessionComponent>());
+                var view = root.AddComponent<SiriAIChatView>();
+                view.enabled = false;
+                SiriAITestAccess.Call(view, "InitializeView", false);
+                root.SetActive(true);
+                SiriAITestAccess.Call(view, "ResetSetupWizard");
+                root.GetComponentInChildren<SiriAILifecycleTransition>(true).SetDesktopMode(true);
+                var bus = root.GetComponentInChildren<SiriAIInteractionFeedback>(true);
+                var settings = new SiriAIInteractionSettings { soundVolume = 1f };
+                settings.Find(SiriAIInteractionCue.Click).sound = clip;
+                bus.Configure(settings, chat);
+                bus.SetPreferences(new SiriAIChatViewPreferences { interactionSounds = true });
+
+                var progress = SiriAITestAccess.Field<Button>(view, "_preparationDetailsButton");
+                progress.gameObject.SetActive(true);
+                Assert.IsTrue(progress.IsActive() && progress.IsInteractable(), "Progress is usable after onboarding yields control.");
+                progress.onClick.Invoke();
+                Assert.AreEqual(1, endpoint.Channels.Count);
+                Assert.AreSame(clip, endpoint.Channels[0].Clip);
+                yield return new WaitForSecondsRealtime(.07f);
+                SiriAITestAccess.Call(view, "CloseFeedback");
+                SiriAITestAccess.Field<SiriAISurfaceTransition>(view, "_feedbackTransition").AdvanceMotion(2f);
+
+                var search = SiriAITestAccess.Field<InputField>(view, "_conversationSearch");
+                SiriAITestAccess.Call(view, "SetConversationNavigationVisible", true);
+                view.ApplyViewport(new Rect(0, 0, 390, 844), 1f, false);
+                var searchFeedback = search.GetComponent<SiriAIControlFeedback>();
+                Assert.IsNotNull(searchFeedback);
+                Assert.IsTrue(search.IsActive() && search.IsInteractable(), "Open navigation owns an editable search field.");
+                // This reuses the composer input type, with voice-hold disabled.
+                searchFeedback.OnPointerClick(new PointerEventData(null) { pointerId = -1 });
+                Assert.AreEqual(2, endpoint.Channels.Count);
+                Assert.AreSame(clip, endpoint.Channels[1].Clip);
+                yield return new WaitForSecondsRealtime(.07f);
+
+                SiriAITestAccess.Call(view, "SetConversationNavigationVisible", false);
+                var history = SiriAITestAccess.Field<SiriAIChatHistory>(view, "_entries");
+                history.AddExecution(new MNN.Unity.MNNConversationTranscriptEntry(MNN.Unity.MNNChatRole.System,
+                    new string('x', 3000), MNN.Unity.MNNConversationEntryKind.ToolResult,
+                    "feedback-tool", "", "Tool details", MNN.Unity.MNNConversationEntryState.Completed));
+                SiriAITestAccess.Call(view, "ShowHistoryPage", 0, true);
+                SiriAITestAccess.Call(view, "LateUpdate");
+                var rows = SiriAITestAccess.Field<System.Collections.IList>(view, "_messageRows");
+                var disclosure = SiriAITestAccess.Field<Button>(rows[0], "Disclosure");
+                Assert.IsTrue(disclosure.IsActive() && disclosure.IsInteractable(), "A tool result exposes its disclosure.");
+                disclosure.onClick.Invoke();
+                Assert.AreEqual(3, endpoint.Channels.Count);
+                yield return new WaitForSecondsRealtime(.07f);
+
+                SiriAITestAccess.Call(view, "SetConversationNavigationVisible", true);
+                view.ApplyViewport(new Rect(0, 0, 390, 844), 1f, false);
+                var scrim = SiriAITestAccess.Field<Graphic>(view, "_conversationPopupScrim").GetComponent<Button>();
+                scrim.onClick.Invoke();
+                Assert.AreEqual(4, endpoint.Channels.Count);
+                foreach (var channel in endpoint.Channels) Assert.AreSame(clip, channel.Clip);
+                yield return new WaitForSecondsRealtime(.07f);
+                settings.sounds = false;
+                progress.onClick.Invoke();
+                Assert.AreEqual(4, endpoint.Channels.Count, "The sound preference must still mute every control.");
+            }
+            finally
+            {
+                Object.DestroyImmediate(root);
+                Object.DestroyImmediate(clip);
+            }
+            yield return new ExitPlayMode();
+        }
+    }
+}
