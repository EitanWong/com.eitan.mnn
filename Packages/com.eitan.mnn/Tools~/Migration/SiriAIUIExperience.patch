+            _view = _root.AddComponent<SiriAIChatView>();
+            _view.TickEditorPreview(new Rect(0, 0, 390, 844), 1);
+            _feedback = _root.AddComponent<SiriAIInteractionFeedback>();
+            _feedback.Configure(new SiriAIInteractionSettings());
+            SiriAITestAccess.Set(_view, "_interactionFeedback", _feedback);
+            for (int i = 0; i < 12; ++i)
+                Call("AddUser", "Message " + i + new string('x', 200));
+            Call("LateUpdate");
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            Object.DestroyImmediate(_root);
+            SiriAIGraphicsQuality.Apply(SiriAIQualityTier.High);
+        }
+
+        private T Field<T>(string name) => SiriAITestAccess.Field<T>(_view, name);
+        private void Call(string name, params object[] args) => SiriAITestAccess.Call(_view, name, args);
+        private ScrollRect Scroll => Field<ScrollRect>("_scroll");
+
+        private void ReadEarlierMessages()
+        {
+            Scroll.GetComponent<SiriAITranscriptScrollInput>().OnScroll(new PointerEventData(null) { scrollDelta = Vector2.up });
+            Scroll.verticalNormalizedPosition = .7f;
+            Call("LateUpdate");
+            SiriAITestAccess.Set(_view, "_editorPreview", false);
+        }
+
+        [Test]
+        public void LatestButtonMovesContinuouslyAndRetargetsStreamingUntilSettled()
+        {
+            ReadEarlierMessages();
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            Assert.AreEqual(.7f, Scroll.verticalNormalizedPosition, .01f, "A click starts from the presented position.");
+            Call("LateUpdate");
+            Assert.Greater(Scroll.verticalNormalizedPosition, .01f, "The first frame must not teleport to the bottom.");
+            Call("AdvanceHistoryScroll", 1f / 60f);
+            Assert.That(Scroll.verticalNormalizedPosition, Is.InRange(.01f, .699f));
+            Call("SetAssistant", new string('y', 3000));
+            Call("LateUpdate");
+            Assert.Greater(Scroll.verticalNormalizedPosition, 0f, "Streaming must retarget the running spring.");
+            for (int i = 0; i < 180; ++i) Call("AdvanceHistoryScroll", 1f / 60f);
+            Assert.AreEqual(0f, Scroll.verticalNormalizedPosition, .001f);
+            Assert.IsTrue(Field<bool>("_historyFollowing"));
+            Assert.IsFalse(Field<bool>("_historyScrollAnimating"));
+        }
+
+        [Test]
+        public void WheelCancelsLatestMotionAndStreamingCannotStealThePosition()
+        {
+            ReadEarlierMessages();
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            Call("LateUpdate");
+            float before = Scroll.verticalNormalizedPosition;
+            Scroll.GetComponent<SiriAITranscriptScrollInput>().OnScroll(new PointerEventData(null) { scrollDelta = Vector2.up });
+            Call("SetAssistant", new string('z', 2000));
+            Call("LateUpdate");
+            float held = Scroll.content.anchoredPosition.y;
+            for (int i = 0; i < 30; ++i) Call("AdvanceHistoryScroll", 1f / 60f);
+            Assert.AreEqual(held, Scroll.content.anchoredPosition.y, .01f);
+            Assert.IsFalse(Field<bool>("_historyFollowing"));
+            Assert.IsFalse(Field<bool>("_historyScrollAnimating"));
+            Assert.Greater(before, 0f);
+        }
+
+        [Test]
+        public void ReducedMotionFinishesInFlightScrollImmediately()
+        {
+            ReadEarlierMessages();
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            Call("LateUpdate");
+            Assert.Greater(Scroll.verticalNormalizedPosition, 0f);
+            _feedback.Settings.reducedMotion = true;
+            Call("AdvanceHistoryScroll", 1f / 60f);
+            Assert.AreEqual(0f, Scroll.verticalNormalizedPosition, .001f);
+            Assert.IsFalse(Field<bool>("_historyScrollAnimating"));
+        }
+
+        [Test]
+        public void EveryBuiltButtonIncludingProgressDisclosureAndScrimsHasFeedback()
+        {
+            Call("BuildFeedbackSheet");
+            Call("BuildConversationPopup");
+            Call("OpenComposerEditor");
+            var missing = new List<string>();
+            var canvas = Field<GameObject>("_canvasRoot");
+            foreach (var button in canvas.GetComponentsInChildren<Button>(true))
+                if (button.GetComponent<SiriAIControlFeedback>() == null) missing.Add(button.name);
+            Assert.IsEmpty(missing, "Every button must use the shared audio and motion feedback: " + string.Join(", ", missing));
+        }
+
+        [Test]
+        public void ReconfiguringControlKeepsOneOpacityGroupAndOriginalScale()
+        {
+            var button = Field<Button>("_historyLatestButton");
+            var feedback = button.GetComponent<SiriAIControlFeedback>();
+            feedback.Configure(_feedback);
+            feedback.Configure(_feedback);
+            Assert.AreEqual(1, button.GetComponents<CanvasGroup>().Length);
+            Assert.AreEqual(Vector3.one, button.transform.localScale);
+        }
+
+        [Test]
+        public void PressInterruptsBeforeTheDragThresholdAndAnotherClickResumes()
+        {
+            ReadEarlierMessages();
+            var button = Field<Button>("_historyLatestButton");
+            button.onClick.Invoke();
+            Call("LateUpdate");
+            Call("AdvanceHistoryScroll", .04f);
+            ExecuteEvents.Execute(Scroll.gameObject, new PointerEventData(null), ExecuteEvents.pointerDownHandler);
+            float held = Scroll.content.anchoredPosition.y;
+            Call("AdvanceHistoryScroll", .2f);
+            Assert.AreEqual(held, Scroll.content.anchoredPosition.y, .01f);
+            Assert.IsFalse(Field<bool>("_historyScrollAnimating"));
+            button.onClick.Invoke();
+            Call("AdvanceHistoryScroll", .04f);
+            Assert.Greater(Scroll.content.anchoredPosition.y, held);
+        }
+
+        [Test]
+        public void RepeatedLatestClicksPreservePositionAndMomentum()
+        {
+            ReadEarlierMessages();
+            var button = Field<Button>("_historyLatestButton");
+            button.onClick.Invoke();
+            Call("AdvanceHistoryScroll", .04f);
+            float position = Scroll.content.anchoredPosition.y;
+            float velocity = Field<float>("_historyScrollVelocity");
+            button.onClick.Invoke();
+            Assert.AreEqual(position, Scroll.content.anchoredPosition.y);
+            Assert.AreEqual(velocity, Field<float>("_historyScrollVelocity"));
+            Assert.Less(velocity, 0f);
+        }
+
+        [TestCase(30)]
+        [TestCase(60)]
+        [TestCase(120)]
+        public void ScrollHasTheSameTrajectoryAcrossRefreshRates(int fps)
+        {
+            ReadEarlierMessages();
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            for (int i = 0; i < fps / 10; ++i) Call("AdvanceHistoryScroll", 1f / fps);
+            float position = Scroll.verticalNormalizedPosition;
+            Scroll.GetComponent<SiriAITranscriptScrollInput>().OnScroll(new PointerEventData(null));
+            Scroll.verticalNormalizedPosition = .7f;
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            Call("AdvanceHistoryScroll", .1f);
+            Assert.AreEqual(position, Scroll.verticalNormalizedPosition, .0001f);
+        }
+
+        [Test]
+        public void JumpFromAnOldPageKeepsThePoolBoundedAndStillAnimates()
+        {
+            for (int i = 12; i < 60; ++i) Call("AddUser", "Older message " + i + new string('x', 200));
+            Call("ShowHistoryPage", 0, false);
+            Call("LateUpdate");
+            ReadEarlierMessages();
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            Call("LateUpdate");
+            Assert.AreEqual(48, Field<int>("_historyPageStart"));
+            Assert.AreEqual(.7f, Scroll.verticalNormalizedPosition, .01f);
+            Call("AdvanceHistoryScroll", .04f);
+            Assert.That(Scroll.verticalNormalizedPosition, Is.InRange(.01f, .699f));
+            Assert.Less(Field<RectTransform>("_messageWindow").childCount, SiriAIChatView.HistoryPageSize);
+        }
+
+        [Test]
+        public void LatestAffordanceFadesWithoutFightingPressScaleAndRejectsClosingClicks()
+        {
+            ReadEarlierMessages();
+            var button = Field<Button>("_historyLatestButton");
+            var transition = button.GetComponent<SiriAIVisualTransition>();
+            transition.SetVisible(false);
+            transition.AdvanceMotion(.04f);
+            float alpha = button.GetComponent<CanvasGroup>().alpha;
+            Assert.That(alpha, Is.InRange(.01f, .99f));
+            Assert.IsFalse(button.GetComponent<CanvasGroup>().blocksRaycasts);
+            button.transform.localScale = Vector3.one * .97f;
+            transition.SetVisible(true);
+            Assert.AreEqual(alpha, button.GetComponent<CanvasGroup>().alpha);
+            transition.AdvanceMotion(.04f);
+            Assert.AreEqual(.97f, button.transform.localScale.x, .0001f);
+            Assert.IsTrue(button.GetComponent<CanvasGroup>().blocksRaycasts);
+        }
+
+        [Test]
+        public void ReopeningFeedbackReversesThePresentedSurfaceAndDiscardsItsOldClose()
+        {
+            SiriAITestAccess.Set(_view, "_editorPreview", false);
+            Call("ShowFeedback", "Loading details", "First details", false);
+            var transition = Field<SiriAISurfaceTransition>("_feedbackTransition");
+            transition.AdvanceMotion(.12f);
+            Call("CloseFeedback");
+            transition.AdvanceMotion(.025f);
+            Rect bounds = transition.VisibleBounds;
+            float progress = transition.Progress;
+            Call("ShowFeedback", "Loading details", "Updated details", false);
+            Assert.AreEqual(bounds, transition.VisibleBounds);
+            Assert.AreEqual(progress, transition.Progress);
+            for (int i = 0; i < 120; ++i) transition.AdvanceMotion(1f / 60f);
+            Assert.IsTrue(Field<RectTransform>("_feedbackRoot").gameObject.activeSelf);
+            Assert.AreEqual("Updated details", Field<Text>("_feedbackText").text);
+        }
+
+        [Test]
+        public void DynamicWakeWordControlsReceiveFeedbackAfterAddRemoveAndRebuild()
+        {
+            var host = new GameObject("Wake words", typeof(RectTransform));
+            host.transform.SetParent(_root.transform);
+            var list = host.AddComponent<SiriAIWakeWordList>();
+            list.Configure(Resources.GetBuiltinResource<Font>("Arial.ttf"), text => text, null, Color.white, Color.gray);
+            SiriAITestAccess.Call(list, "DecorateControls", new Action<Selectable>(control =>
+                control.gameObject.AddComponent<SiriAIControlFeedback>().Configure(_feedback)));
+            list.SetWords(new[] { "Siri", "Hey Siri" });
+            list.AddWord("Hello Siri");
+            list.RemoveWord(0);
+            foreach (var control in host.GetComponentsInChildren<Selectable>(true))
+                Assert.IsNotNull(control.GetComponent<SiriAIControlFeedback>(), control.name);
+            Assert.AreEqual(2, list.ReadWords().Length);
+        }
+
+        [Test]
+        public void ActiveScrollFramesDoNotAllocateManagedMemory()
+        {
+            SiriAIAllocationCounter.RequireSupport();
+            ReadEarlierMessages();
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            var method = typeof(SiriAIChatView).GetMethod("AdvanceHistoryScroll",
+                System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);
+            var advance = (Action<float>)Delegate.CreateDelegate(typeof(Action<float>), _view, method);
+            advance(.001f);
+            long before = GC.GetAllocatedBytesForCurrentThread();
+            for (int i = 0; i < 30; ++i) advance(1f / 120f);
+            long bytes = GC.GetAllocatedBytesForCurrentThread() - before;
+            Assert.AreEqual(0, bytes);
+        }
+
+        [Test]
+        public void ScrollIntegrationKeepsActiveFrameWorkSmallWithoutGrowingTheMessagePool()
+        {
+            ReadEarlierMessages();
+            Field<Button>("_historyLatestButton").onClick.Invoke();
+            var method = typeof(SiriAIChatView).GetMethod("AdvanceHistoryScroll",
+                System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);
+            var advance = (Action<float>)Delegate.CreateDelegate(typeof(Action<float>), _view, method);
+            int rows = Field<RectTransform>("_messageWindow").childCount;
+            for (int i = 0; i < 20; ++i) advance(.00001f);
+            var timer = System.Diagnostics.Stopwatch.StartNew();
+            for (int i = 0; i < 1000; ++i) advance(.00001f);
+            timer.Stop();
+            Assert.IsTrue(Field<bool>("_historyScrollAnimating"), "Measure moving frames, not the settled early return.");
+            Assert.AreEqual(rows, Field<RectTransform>("_messageWindow").childCount);
+            Assert.Less(timer.Elapsed.TotalMilliseconds, 1000d);
+            TestContext.WriteLine("1000 active scroll integrations: " + timer.Elapsed.TotalMilliseconds.ToString("F3") + " ms; rows=" + rows);
+        }
+    }
+}
