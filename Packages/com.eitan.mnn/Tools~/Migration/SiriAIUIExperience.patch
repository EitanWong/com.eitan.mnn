@@ -0,0 +1,61 @@
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private bool _historyScrollAnimating;
+        private float _historyScrollVelocity;
+
+        private void ScrollToLatestHistory()
+        {
+            if (_editorPreview || !UiMotion)
+            {
+                JumpToLatestHistory();
+                return;
+            }
+            int latest = _entries.Count == 0 ? 0 : (_entries.Count - 1) / HistoryPageSize * HistoryPageSize;
+            if (latest != _historyPageStart)
+            {
+                float position = Mathf.Clamp01(_scroll.verticalNormalizedPosition);
+                ShowHistoryPage(latest, true);
+                // Paging still bounds layout work. Start the new page at the presented
+                // relative offset; never animate through thousands of hidden rows.
+                _historyScrollRequest = position;
+            }
+            _historySeenCount = _entries.Count;
+            _historyFollowing = _scrollLatest = true;
+            _scrollToStatus = false;
+            // Repeated activation retargets the same spring without resetting momentum.
+            _historyScrollAnimating = true;
+            _scroll.StopMovement();
+        }
+
+        private void CancelHistoryScroll()
+        {
+            _historyScrollAnimating = false;
+            _historyScrollVelocity = 0f;
+        }
+
+        private void AdvanceHistoryScroll(float deltaTime)
+        {
+            if (!_historyScrollAnimating || HistoryGestureActive || _historyScrollRequest.HasValue) return;
+            float range = Mathf.Max(0f, _scroll.content.rect.height - _scroll.viewport.rect.height);
+            // Integrate in pixels, after layout. Streaming and resizing can move the
+            // destination while the spring preserves its current position and velocity.
+            float distance = Mathf.Clamp01(_scroll.verticalNormalizedPosition) * range;
+            if (!UiMotion || range <= 2f)
+            {
+                distance = 0f;
+                _historyScrollVelocity = 0f;
+            }
+            else
+                SiriAIMotion.Spring(ref distance, ref _historyScrollVelocity, 0f,
+                    Mathf.Max(0f, deltaTime), 22f, 1f);
+            bool settled = distance < .25f && Mathf.Abs(_historyScrollVelocity) < 5f;
+            _scroll.StopMovement();
+            _scroll.verticalNormalizedPosition = settled || range <= 0f ? 0f : Mathf.Clamp01(distance / range);
+            if (settled) CancelHistoryScroll();
+        }
+    }
+}
