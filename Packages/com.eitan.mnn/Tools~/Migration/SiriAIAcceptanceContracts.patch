+using System;
+using System.Collections;
+using System.Threading;
+using System.Threading.Tasks;
+using MNN.Unity;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIChatResourceTests
+    {
+        [UnityTest]
+        public IEnumerator ReleasedSessionFaultStillReleasesAuxiliaryModelsAndAcoustics()
+        { return StopAfterFault(false); }
+
+        [UnityTest]
+        public IEnumerator FailedQuiescenceRetainsResourcesUntilASuccessfulRetry()
+        { return StopAfterFault(true); }
+
+        private static IEnumerator StopAfterFault(bool failQuiescence)
+        {
+            var root = new GameObject("Faulted chat resource ownership");
+            var chat = root.AddComponent<SiriAIChat>();
+            var component = root.AddComponent<MNNRealtimeSessionComponent>();
+            var acoustic = chat.AcousticProcessing;
+            var runtime = new FaultRuntime { FailQuiescence = failQuiescence };
+            var output = new MNNRealtimeOutputPipeline(new MNNPcmFormat(16000, 1), 160);
+            var session = new MNNRealtimeSession(runtime, output);
+            int releases = 0;
+            var original = new InvalidOperationException("Injected synthesis failure.");
+            try
+            {
+                SiriAITestAccess.Set(acoustic, "preferencesKey", "");
+                acoustic.StageSettings(new SiriAIAcousticSettings { enabled = true });
+                Task prepared = acoustic.PrepareAsync(CancellationToken.None);
+                yield return Join(prepared); Assert.False(prepared.IsFaulted, prepared.Exception?.ToString());
+                Assert.NotNull(acoustic.Frontend);
+                SiriAITestAccess.Set(component, "_mainThreadId", Thread.CurrentThread.ManagedThreadId);
+                SiriAITestAccess.Set(component, "_session", session);
+                SiriAITestAccess.Set(chat, "_session", component);
+                var caps = new MNNRealtimeCapabilities(MNNRealtimeFeature.None, "managed ownership test", "Injected resources; no native inference.", execution: MNNRealtimeExecution.Managed);
+                SiriAITestAccess.Set(chat, "_registration", new SiriAIBackendRegistration(new UnusedFactory(), caps, caps,
+                    releaseAsync: () => { ++releases; return Task.CompletedTask; }));
+
+                Task faulted = session.ReportFaultAsync(original); yield return Join(faulted);
+                Assert.True(faulted.IsFaulted); StringAssert.Contains(original.Message, session.Fault.ToString());
+                Assert.AreEqual(!failQuiescence, session.ResourcesReleased);
+                Task stopped = chat.StopConversationAsync(); yield return Join(stopped);
+                Assert.True(stopped.IsFaulted, "The original runtime failure must remain observable.");
+                StringAssert.Contains(original.Message, stopped.Exception.ToString());
+                if (failQuiescence)
+                {
+                    Assert.AreEqual(0, releases, "Auxiliary providers may still be used by unjoined workers.");
+                    Assert.NotNull(acoustic.Frontend, "Capture may still use the acoustic owner.");
+                    Assert.AreEqual(0, runtime.Disposals);
+                    runtime.FailQuiescence = false;
+                    stopped = chat.StopConversationAsync(); yield return Join(stopped);
+                    Assert.True(stopped.IsFaulted); StringAssert.Contains(original.Message, stopped.Exception.ToString());
+                    Assert.True(session.ResourcesReleased);
+                }
+                Assert.AreEqual(1, releases, "A released runtime's retained fault must not abandon auxiliary ownership.");
+                Assert.IsNull(acoustic.Frontend);
+                Assert.AreEqual(1, runtime.Disposals);
+            }
+            finally
+            {
+                runtime.FailQuiescence = false;
+                SiriAITestAccess.Set(chat, "_session", null);
+                SiriAITestAccess.Set(chat, "_registration", null);
+                SiriAITestAccess.Set(component, "_session", null);
+                acoustic.Release();
+                UnityEngine.Object.DestroyImmediate(root);
+            }
+        }
+
+        private static IEnumerator Join(Task task)
+        {
+            double until = UnityEditor.EditorApplication.timeSinceStartup + 10;
+            while (!task.IsCompleted && UnityEditor.EditorApplication.timeSinceStartup < until) yield return null;
+            Assert.True(task.IsCompleted, "Managed ownership transition did not finish in ten seconds.");
+        }
+
+        private sealed class UnusedFactory : IMNNRealtimeRuntimeFactory
+        {
+            public Task<IMNNRealtimeSessionRuntime> CreateAsync(MNNRealtimeReport report,
+                MNNRealtimeOutputPipeline output, CancellationToken token) => throw new NotSupportedException();
+        }
+
+        private sealed class FaultRuntime : IMNNRealtimeSessionRuntime
+        {
+            public bool FailQuiescence;
+            public int Disposals;
+            public Task PrepareAsync(CancellationToken token) => Task.CompletedTask;
+            public Task StartListeningAsync(CancellationToken token) => Task.CompletedTask;
+            public Task RequestCancellationAsync(MNNResponseId response) => Task.CompletedTask;
+            public Task WaitForInferenceQuiescenceAsync(MNNResponseId response) => Task.CompletedTask;
+            public Task RestoreContextAsync(MNNResponseId response) => Task.CompletedTask;
+            public Task StopListeningAsync() => Task.CompletedTask;
+            public Task WaitForQuiescenceAsync() => FailQuiescence ? Task.FromException(new InvalidOperationException("Worker is still live.")) : Task.CompletedTask;
+            public Task DisposeAsync() { ++Disposals; return Task.CompletedTask; }
+        }
+    }
+}
