+        private static IEnumerator CaptureCleanup(Task task, Action<Exception> failure, float seconds = 90)
+        {
+            float until = Time.realtimeSinceStartup + seconds;
+            while (!task.IsCompleted && Time.realtimeSinceStartup < until) yield return null;
+            if (!task.IsCompleted) { failure(new TimeoutException("Timed out waiting for cleanup task.")); yield break; }
+            if (task.IsFaulted) failure(task.Exception.GetBaseException());
+            else if (task.IsCanceled) failure(new TaskCanceledException(task));
+        }
