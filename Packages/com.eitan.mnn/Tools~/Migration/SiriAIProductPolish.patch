+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private static string[] NumericChoices(string title, int min, int max, int current)
+        {
+            var values = new SortedSet<int> { current, min, max };
+            if (max - min <= 64)
+                for (int value = min; value <= max; ++value) values.Add(value);
+            else
+                foreach (int value in new[] { 0, 1, 2, 4, 8, 16, 20, 30, 32, 50, 60, 64, 100, 128, 200, 256, 500, 512, 1000, 1024, 2000, 2048, 4096, 8192, 16384, 32768, 65536 })
+                    if (value >= min && value <= max) values.Add(value);
+            var choices = new List<string>();
+            foreach (int value in values) choices.Add(value.ToString(CultureInfo.InvariantCulture));
+            return choices.ToArray();
+        }
+
+        private void AddPresetChoices(InputField input, string title, string[] values, string[] labels = null)
+        {
+            var row = input.transform.parent;
+            var button = SettingsButton(row, "", GlassInset, Ink); FixedHeight(button.gameObject, 52);
+            button.transform.SetSiblingIndex(input.transform.GetSiblingIndex());
+            AddSettingsChevron((RectTransform)button.transform);
+            var text = button.GetComponentInChildren<Text>();
+            var choices = new List<string>();
+            for (int i = 0; i < values.Length; ++i) choices.Add(labels == null ? values[i] : Localize(labels[i]));
+            choices.Add(Localize("Custom value…"));
+            Action refresh = () =>
+            {
+                int selected = Array.IndexOf(values, input.text);
+                text.text = selected >= 0 ? choices[selected] : input.text;
+            };
+            _settingsChoiceLabels.Add(refresh); refresh();
+            input.gameObject.SetActive(Array.IndexOf(values, input.text) < 0);
+            input.onValueChanged.AddListener(_ => refresh());
+            button.onClick.AddListener(() => OpenSettingsOptions((RectTransform)button.transform, title, choices,
+                Array.IndexOf(values, input.text), selected =>
+                {
+                    bool custom = selected == values.Length;
+                    input.gameObject.SetActive(custom);
+                    if (custom) { if (!_editorPreview) input.ActivateInputField(); }
+                    else { input.text = values[selected]; ReadSettingsFields(); }
+                    LayoutRebuilder.MarkLayoutForRebuild((RectTransform)row);
+                }, false));
+        }
+
+        private void AddLanguageChoice(string title, SiriAIEndpointConfiguration endpoint)
+        {
+            var input = AddTextField(title, "Automatic recognition follows the spoken language; override only when needed.",
+                () => endpoint.language, value => endpoint.language = value.Trim().ToLowerInvariant());
+            if (title == "Language")
+                AddPresetChoices(input, title, new[] { "", "en", "ko", "es", "pt", "fr" },
+                    new[] { "Model default", "English", "Korean", "Spanish", "Portuguese", "French" });
+            else
+            {
+                var adapter = _settingsDraft.Catalog?.ForStage(2).Find(entry => entry.modelId == endpoint.model)?.adapter;
+                bool senseVoice = adapter == SiriAIModelAdapter.SenseVoice;
+                AddPresetChoices(input, title,
+                    senseVoice ? new[] { "", "auto", "en", "zh", "ja", "ko", "yue" } :
+                        new[] { "", "auto", "en", "zh", "ja", "ko", "yue", "de", "es", "fr", "it", "pt", "ru" },
+                    senseVoice ? new[] { "Model default", "Automatic recognition", "English", "Simplified Chinese", "Japanese", "Korean", "Cantonese" } :
+                        new[] { "Model default", "Automatic recognition", "English", "Simplified Chinese", "Japanese", "Korean", "Cantonese", "German", "Spanish", "French", "Italian", "Portuguese", "Russian" });
+            }
+        }
+    }
+}
