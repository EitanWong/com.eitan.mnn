+            var root = new GameObject("Feedback glass motion"); var quality = SiriAIGraphicsQuality.Selection;
+            try
+            {
+                SiriAIGraphicsQuality.Apply(SiriAIQualityTier.High);
+                var view = root.AddComponent<SiriAIChatView>(); view.TickEditorPreview(new Rect(0, 0, 390, 844), 1);
+                SiriAITestAccess.Field<SiriAIChatViewPreferences>(view, "_viewPreferences").reduceMotion = false;
+                SiriAITestAccess.Set(view, "_editorPreview", false);
+                SiriAITestAccess.Call(view, "SetErrorDetails", "Offline", "Copyable diagnostic");
+                var panel = SiriAITestAccess.Field<RectTransform>(view, "_feedbackPanel");
+                var material = panel.GetComponent<SiriAIRoundedRect>().material;
+                Assert.AreEqual("Hidden/SiriAI/LiquidGlassBackdrop", material.shader.name);
+                Assert.AreEqual(1, material.GetFloat("_ReadableSurface"));
+                var transition = panel.GetComponent<SiriAISurfaceTransition>(); Assert.IsNotNull(transition);
+                Assert.Less(transition.Progress, 1);
+                SiriAITestAccess.Call(transition, "AdvanceMotion", 1f / fps);
+                Assert.Greater(transition.Progress, 0);
+                for (int i = 0; i < fps; ++i) SiriAITestAccess.Call(transition, "AdvanceMotion", 1f / fps);
+                Assert.AreEqual(1, transition.Progress);
+                SiriAITestAccess.Call(view, "CloseFeedback"); SiriAITestAccess.Call(transition, "AdvanceMotion", 1f / fps);
+                SiriAITestAccess.Call(view, "SetErrorDetails", "Retry failed", "Fresh diagnostic");
+                for (int i = 0; i < fps; ++i) SiriAITestAccess.Call(transition, "AdvanceMotion", 1f / fps);
+                Assert.IsTrue(SiriAITestAccess.Field<RectTransform>(view, "_feedbackRoot").gameObject.activeSelf);
+                Assert.AreEqual("Fresh diagnostic", SiriAITestAccess.Field<Text>(view, "_feedbackText").text);
+                SiriAITestAccess.Call(view, "CloseFeedback");
+                for (int i = 0; i < fps; ++i) SiriAITestAccess.Call(transition, "AdvanceMotion", 1f / fps);
+                Assert.IsFalse(SiriAITestAccess.Field<RectTransform>(view, "_feedbackRoot").gameObject.activeSelf);
+                Assert.AreEqual("", SiriAITestAccess.Field<Text>(view, "_feedbackText").text);
