+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.UI;
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIDesktopReadabilityTests
+    {
+        [Test]
+        public void SetupGuideMorphsBeforeHandingOffToSettings()
+        {
+            var root = new GameObject("Setup transition handoff"); var quality = SiriAIGraphicsQuality.Selection;
+            try
+            {
+                SiriAIGraphicsQuality.Apply(SiriAIQualityTier.High);
+                var view = root.AddComponent<SiriAIChatView>(); view.TickEditorPreview(new Rect(0, 0, 390, 844), 1);
+                SiriAITestAccess.Field<SiriAIChatViewPreferences>(view, "_viewPreferences").reduceMotion = false;
+                SiriAITestAccess.Set(view, "_editorPreview", false); view.OpenSetupWizard();
+                var card = SiriAITestAccess.Field<RectTransform>(view, "_setupCard");
+                var transition = card.GetComponent<SiriAISurfaceTransition>(); Assert.IsNotNull(transition);
+                for (int i = 0; i < 60; ++i) SiriAITestAccess.Call(transition, "AdvanceMotion", 1f / 60);
+                Assert.AreEqual(1, transition.Progress);
+                SiriAITestAccess.Call(view, "ConfigureSetup");
+                Assert.IsTrue(view.IsSetupOpen); Assert.IsFalse(view.IsSettingsOpen);
+                for (int i = 0; i < 60; ++i) SiriAITestAccess.Call(transition, "AdvanceMotion", 1f / 60);
+                Assert.IsFalse(view.IsSetupOpen); Assert.IsTrue(view.IsSettingsOpen);
+                TestContext.WriteLine("Setup opens with a morph; closing completes before settings takes over");
+            }
+            finally { Object.DestroyImmediate(root); SiriAIGraphicsQuality.Apply(quality); }
+        }
+
+        [Test]
+        public void EveryCategoryUsesItsOwnRelevantIcon()
+        {
+            var root = new GameObject("Category icon meaning");
+            try
+            {
+                var view = root.AddComponent<SiriAIChatView>(); view.TickEditorPreview(new Rect(0, 0, 390, 844), 1); view.OpenSettings();
+                var tabs = SiriAITestAccess.Field<System.Collections.Generic.List<Button>>(view, "_settingsTabs");
+                var expected = new[] { "Conversation", "Models", "Appearance", "Audio", "System", "Keyboard", "Performance" };
+                Assert.AreEqual(expected.Length, tabs.Count);
+                for (int i = 0; i < tabs.Count; ++i)
+                {
+                    var icon = tabs[i].GetComponentInChildren<SiriAIActionIcon>();
+                    Assert.AreEqual(expected[i], icon.Glyph.ToString());
+                    Assert.IsFalse(icon.raycastTarget);
+                    Assert.IsNotEmpty(tabs[i].GetComponent<SiriAIControlHint>().Label);
+                }
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+
