+                SiriAITestAccess.Call(view, "ShowSettingsTab", 7, false); capture("keyboard-settings");
+                Assert.IsNotNull(SiriAITestAccess.Field<ScrollRect>(view, "_settingsNavigationScroll").viewport.GetComponent<RectMask2D>());
+            }
+            finally
+            {
+                RenderTexture.active = active; Object.DestroyImmediate(root); Object.DestroyImmediate(cameraRoot);
