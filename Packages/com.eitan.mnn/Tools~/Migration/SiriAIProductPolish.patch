@@ -0,0 +1,66 @@
+using System;
+using System.IO;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.Rendering;
+using Object = UnityEngine.Object;
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIGlassBalanceTests
+    {
+        [TestCase(true, true)] [TestCase(false, true)]
+        [TestCase(true, false)] [TestCase(false, false)]
+        public void ReadableGlassRetainsBackdropTransmissionAndTextContrast(bool dark, bool captured)
+        {
+            if (SystemInfo.graphicsDeviceType == GraphicsDeviceType.Null) Assert.Ignore("GPU required.");
+            var root = new GameObject("Glass balance"); var cameraRoot = new GameObject("Glass balance camera");
+            var target = new RenderTexture(256, 256, 24, RenderTextureFormat.ARGBFloat);
+            var readback = new Texture2D(256, 256, TextureFormat.RGBAFloat, false, true);
+            var desktop = new Texture2D(1, 1, TextureFormat.RGBA32, false);
+            var active = RenderTexture.active;
+            float mode = Shader.GetGlobalFloat("_SiriDesktopMode"), availability = Shader.GetGlobalFloat("_SiriDesktopBackdropAvailable");
+            var original = Shader.GetGlobalTexture("_SiriDesktopBackdrop"); Material glass = null;
+            try
+            {
+                var view = root.AddComponent<SiriAIChatView>(); view.TickEditorPreview(new Rect(0, 0, 256, 256), 1);
+                SiriAITestAccess.Field<SiriAIChatViewPreferences>(view, "_viewPreferences").desktopMode = true;
+                SiriAITestAccess.Call(view, "ApplySystemAppearance", dark); view.OpenSettings();
+                glass = new Material(SiriAITestAccess.Field<Material>(view, "_settingsGlassMaterial"));
+                glass.shader = Shader.Find("UI/LiquidGlass"); glass.SetFloat("_UseBackdropTexture", 0); glass.SetFloat("_GlassLayer", 0);
+                glass.SetFloat("_RimIntensity", 0);
+                var canvasRoot = SiriAITestAccess.Field<GameObject>(view, "_canvasRoot"); canvasRoot.SetActive(false);
+                var specimen = new GameObject("Specimen", typeof(RectTransform), typeof(Canvas)); specimen.transform.SetParent(cameraRoot.transform);
+                var camera = cameraRoot.AddComponent<Camera>(); camera.targetTexture = target; camera.clearFlags = CameraClearFlags.SolidColor; camera.backgroundColor = Color.clear;
+                var canvas = specimen.GetComponent<Canvas>(); canvas.renderMode = RenderMode.ScreenSpaceCamera; canvas.worldCamera = camera; canvas.planeDistance = 1;
+                var surface = SiriAIUIFactory.CreateSurface(canvas.transform, "Text surface", glass, Color.white, false);
+                surface.rectTransform.anchorMin = surface.rectTransform.anchorMax = new Vector2(.5f, .5f); surface.rectTransform.sizeDelta = new Vector2(220, 220);
+                Shader.SetGlobalFloat("_SiriDesktopMode", 1); Shader.SetGlobalFloat("_SiriDesktopBackdropAvailable", captured ? 1 : 0); Shader.SetGlobalTexture("_SiriDesktopBackdrop", desktop);
+                Color Frame(float wallpaper)
+                {
+                    desktop.SetPixel(0, 0, new Color(wallpaper, wallpaper, wallpaper)); desktop.Apply();
+                    camera.Render(); RenderTexture.active = target; readback.ReadPixels(new Rect(0, 0, 256, 256), 0, 0); readback.Apply();
+                    var pixel = readback.GetPixel(128, 128);
+                    if (!captured) pixel = new Color(pixel.r + wallpaper * (1 - pixel.a), pixel.g + wallpaper * (1 - pixel.a), pixel.b + wallpaper * (1 - pixel.a), pixel.a);
+                    return pixel;
+                }
+                Color black = Frame(0), white = Frame(1);
+                TestContext.WriteLine("dark=" + dark + " capture=" + captured + " black=" + black + " white=" + white);
+                float Linear(float value) => Mathf.GammaToLinearSpace(value);
+                float Contrast(Color color)
+                {
+                    float background = Linear(color.r) * .2126f + Linear(color.g) * .7152f + Linear(color.b) * .0722f;
+                    float ink = dark ? Linear(.90f) : Linear(.29f);
+                    return (Mathf.Max(background, ink) + .05f) / (Mathf.Min(background, ink) + .05f);
+                }
+                Assert.Greater(Mathf.Abs(white.grayscale - black.grayscale), captured ? .075f : .17f, "Readable glass must visibly transmit backdrop changes.");
+                Assert.GreaterOrEqual(Mathf.Min(Contrast(black), Contrast(white)), 4.5f, "Normal text must remain readable over opposite wallpapers.");
+                if (!captured) Assert.Less(white.a, .82f, "Native desktop glass must remain visible through the color backing.");
+            }
+            finally
+            {
+                Shader.SetGlobalFloat("_SiriDesktopMode", mode); Shader.SetGlobalFloat("_SiriDesktopBackdropAvailable", availability); Shader.SetGlobalTexture("_SiriDesktopBackdrop", original);
+                RenderTexture.active = active; Object.DestroyImmediate(root); Object.DestroyImmediate(cameraRoot); Object.DestroyImmediate(target); Object.DestroyImmediate(readback); Object.DestroyImmediate(desktop); if (glass != null) Object.DestroyImmediate(glass);
+            }
+        }
+    }
+}
