+using System;
+using System.Threading.Tasks;
+using MNN.Samples.SiriAI.Harnesses;
+using MNN.Unity;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIHarnessController
+    {
+        private MNNHarnessBackendSetup _localSetup;
+        private bool _localConnecting;
+        public const string DesktopHostPreferenceKey = "SiriAI.DesktopHost.";
+        public MNNHarnessBackendSetup LocalSetup
+        {
+            get
+            {
+                if (_localSetup != null) return _localSetup;
+                _localSetup = GetComponent<MNNHarnessBackendSetup>() ?? gameObject.AddComponent<MNNHarnessBackendSetup>();
+                if (_localSetup.ServiceDirectory == null)
+                {
+                    string assembly = UnityEngine.PlayerPrefs.GetString(DesktopHostPreferenceKey + "assembly", "");
+                    if (string.IsNullOrWhiteSpace(assembly))
+                        assembly = HarnessDesktopPaths.FindHost(new[] { System.IO.Path.Combine(UnityEngine.Application.dataPath, "Samples", "SiriAI") });
+                    _localSetup.Configure(UnityEngine.PlayerPrefs.GetString(DesktopHostPreferenceKey + "runtime", ""), assembly,
+                        UnityEngine.PlayerPrefs.GetString(DesktopHostPreferenceKey + "directory", ""));
+                }
+                _localSetup.Changed += Notify;
+                return _localSetup;
+            }
+        }
+        public Task<HarnessHostCatalog> InspectHostAsync(string profileId, string address, string token) =>
+            connection != null ? connection.InspectHostAsync(profileId, address, token, _lifetime?.Token ?? default) :
+                Task.FromException<HarnessHostCatalog>(new InvalidOperationException("Assign a harness connection."));
+        public async Task ConnectLocalAsync(string backend, string workspace, string endpoint = null, string model = null, string apiKey = null)
+        {
+            if (IsBusy) throw new InvalidOperationException("Wait for backend setup to finish.");
+            _localConnecting = true; Notify();
+            try
+            {
+                var setup = await LocalSetup.PrepareAsync(backend, workspace, endpoint: endpoint, model: model, apiKey: apiKey);
+                await LocalSetup.StartHostAsync();
+                await ConnectAsync(new HarnessHostProfile("local-desktop-" + setup.ScopeId, "Local · " + HarnessBackendCatalog.DisplayName(backend), setup.Address,
+                    setup.Backend, setup.Workspace), LocalSetup.ReadAccessToken(setup), false);
+                await RefreshAsync();
+            }
+            finally { _localConnecting = false; Notify(); }
+        }
+    }
+}
