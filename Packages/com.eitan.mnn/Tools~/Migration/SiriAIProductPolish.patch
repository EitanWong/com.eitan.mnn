+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private const int DesktopTab = 6, InteractionTab = 7, VisualsTab = 8, GraphicsTab = 9,
+            SystemTab = 10, AcousticTab = 11, SpeechTab = 12;
+        private bool _settingsAudioAdvanced;
+        private RectTransform _settingsNavigationContent;
+        private ScrollRect _settingsNavigationScroll;
+        private readonly System.Collections.Generic.List<int> _settingsTabIds = new System.Collections.Generic.List<int>();
+
+        private void BuildAudioPreferences()
+        {
+            BuildAudioSettings();
+            AddBoolField("Advanced audio settings", "Echo control, speech input and wake words.",
+                () => _settingsAudioAdvanced, value => UpdateAudioSettings(() => _settingsAudioAdvanced = value));
+            if (!_settingsAudioAdvanced) return;
+            BuildAcousticSettings();
+            BuildSpeechInputSettings();
+        }
+
+        private void BuildSystemSettings()
+        {
+            AddSettingsTitle("Permissions & application", null);
+            var setup = SettingsButton(_settingsContent, "Setup guide", GlassInset, Ink);
+            FixedHeight(setup.gameObject, 44); setup.onClick.AddListener(OpenSetupWizard);
+            BuildDesktopPermissionSettings(); BuildQuitSettings();
+        }
+        private void BuildGraphicsSettings()
+        {
+            AddSettingsTitle("Graphics & performance", null); BuildQualitySettings();
+            AddBoolField("Performance details", null,
+                () => _settingsDraft.Appearance.showPerformance, value => _settingsDraft.Appearance.showPerformance = value);
+        }
+        private void BuildAcousticSettings()
+        {
+            AddSettingsTitle("Acoustic processing", "Saving restarts audio.");
+            var endpoint = _chat?.AudioEndpoint;
+            if (endpoint == null || _settingsDraft.Audio == null)
+            { SettingsDescription("Assign an audio endpoint to select devices. EasyMic APM requires a license."); return; }
+            var access = endpoint.GetAudioSettingsAccess(_settingsDraft.Audio);
+            var input = access.inputs.Find(device => device.id == _settingsDraft.Audio.inputDevice);
+            if (_settingsDraft.Audio.EffectiveBackendId == "easymic") BuildEasyMicAcousticProcessing(access, input);
+            BuildAcousticProcessing(endpoint, access);
+        }
+        private void BuildSettingsNavigation()
+        {
+            _settingsNavigationScroll = _settingsNavigation.gameObject.AddComponent<ScrollRect>();
+            _settingsNavigationScroll.horizontal = false; _settingsNavigationScroll.vertical = true;
+            _settingsNavigationScroll.movementType = ScrollRect.MovementType.Clamped;
+            _settingsNavigationScroll.scrollSensitivity = 44;
+            _settingsNavigation.gameObject.AddComponent<Image>().color = new Color(1, 1, 1, .001f);
+            _settingsNavigation.gameObject.AddComponent<RectMask2D>();
+            _settingsNavigationContent = RectObject("Settings Categories", _settingsNavigation);
+            _settingsNavigationContent.anchorMin = new Vector2(0, 1); _settingsNavigationContent.anchorMax = Vector2.one;
+            _settingsNavigationContent.pivot = new Vector2(.5f, 1);
+            _settingsNavigationScroll.viewport = _settingsNavigation; _settingsNavigationScroll.content = _settingsNavigationContent;
+        }
+        private void RevealSettingsCategory()
+        {
+            int selected = _settingsTabIds.IndexOf(_settingsTab);
+            if (selected < 0 || _settingsNavigationScroll == null) return;
+            var tab = (RectTransform)_settingsTabs[selected].transform;
+            float top = _settingsNavigationContent.rect.height - tab.anchoredPosition.y - tab.rect.height;
+            float range = _settingsNavigationContent.rect.height - _settingsNavigation.rect.height;
+            _settingsNavigationScroll.verticalNormalizedPosition = range > 0 ? 1 - Mathf.Clamp01(top / range) : 1;
+        }
+
+        private void LayoutSettingsCategories(bool wide, float width, float height)
+        {
+            float requiredWidth = 0;
+            foreach (var button in _settingsTabs)
+                requiredWidth = Mathf.Max(requiredWidth, ActionWidth(button));
+            int columns = wide ? 1 : Mathf.Max(1, Mathf.FloorToInt((width + 8) / (requiredWidth + 8)));
+            int rows = Mathf.CeilToInt((float)_settingsTabs.Count / columns);
+            float contentHeight = rows * 44 + Mathf.Max(0, rows - 1) * 8;
+            _settingsNavigationContent.sizeDelta = new Vector2(0, Mathf.Max(height, contentHeight));
+            float cellWidth = Mathf.Max(0, (width - (columns - 1) * 8) / columns);
+            for (int i = 0; i < _settingsTabs.Count; ++i)
+            {
+                _settingsTabs[i].GetComponent<SiriAIResponsiveAction>().SetGroupLabelVisibility(true);
+                Place((RectTransform)_settingsTabs[i].transform,
+                    new Rect(i % columns * (cellWidth + 8), _settingsNavigationContent.rect.height - 44 - i / columns * 52, cellWidth, 44));
+            }
+        }
+    }
+}
