+                }
+                finally
+                {
+                    caller.Cancel();
+                    try { await reply; } catch (OperationCanceledException) { }
+                }
+            }
+        }
+
+        [Test]
+        public void MatchingReceiptReturnsExactTaskWithoutWaitingForWork() => Task.Run(MatchingReceiptReturnsExactTaskWithoutWaitingForWorkAsync).GetAwaiter().GetResult();
+
+        private async Task MatchingReceiptReturnsExactTaskWithoutWaitingForWorkAsync()
+        {
+            using (var client = new RemoteTaskClient(new Uri("http://127.0.0.1:1"), "fixture-only"))
+            {
+                int calls = 0;
+                var tool = new HarnessTaskTool(client, (request, token) =>
+                { ++calls; return Task.FromResult(Receipt(request.SubmissionKey)); },
+                    "conversation", HarnessTaskToolOperation.Submit, "harness", "workspace", false);
+                var reply = await tool.ExecuteAsync("Investigate the startup failure", CancellationToken.None);
+                StringAssert.Contains("Task accepted: confirmed-task", reply);
+                StringAssert.Contains("Running", reply); Assert.AreEqual(1, calls);
+            }
+        }
+
+        private static HarnessTask Receipt(string key) => TaskHostJson.Read<HarnessTask>(Encoding.UTF8.GetBytes(
+            "{\"Id\":\"confirmed-task\",\"ConversationId\":\"conversation\",\"SubmissionKey\":\"" + key +
+            "\",\"HarnessId\":\"harness\",\"WorkspaceKey\":\"workspace\",\"State\":1}"));
+    }
+}
