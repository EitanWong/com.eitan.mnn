+        private static IEnumerator RunC930cCameraWithEasyMic()
+        {
+            var root = new GameObject("C930c EasyMic camera startup");
+            root.SetActive(false);
+            var input = new GameObject("Input"); input.transform.SetParent(root.transform);
+            var output = new GameObject("Output"); output.transform.SetParent(root.transform);
+            var audio = root.AddComponent<SiriAIEasyMicAudio>();
+            audio.Configure(input.AddComponent<EasyMicrophone>(), output.AddComponent<PlaybackAudioSourceBehaviour>());
+            var chat = root.AddComponent<SiriAIChat>(); chat.enabled = false;
+            root.SetActive(true);
+            SetField(chat, "_stopTask", null);
+            string name = Array.Find(Array.ConvertAll(WebCamTexture.devices, d => d.name),
+                device => device.IndexOf("C930", StringComparison.OrdinalIgnoreCase) >= 0);
+            Assert.IsNotNull(name);
+            var audioSettings = audio.ReadAudioSettings();
+            audioSettings.inputDevice = name;
+            audioSettings.inputChannels = 2;
+            audioSettings.aec = audioSettings.ans = audioSettings.agc = audioSettings.dtlnAec = false;
+            audio.StageAudioSettings(audioSettings);
+            var interaction = root.AddComponent<MNNInteractionComponent>();
+            var settings = new MNNInteractionSettings { visualPresence = true, requirePresenceForVoice = true };
+            Assert.IsNotNull(settings.camera, "Camera settings must be initialized.");
+            settings.camera.deviceName = name;
+            TestContext.WriteLine("camera selected=" + name);
+            interaction.Configure(settings); chat.ConfigureInteraction(interaction);
+            chat.PresenceSourceFactory = (_, token) =>
+                MNNFacePresenceSource.Load(System.IO.Path.Combine(
+                    Environment.GetEnvironmentVariable("SIRIAI_TEST_MODELS") ?? SiriAIModelInstallation.ModelsDirectory, settings.detectorDirectory),
+                    backend: MNNBackendType.CPU);
+            var apply = typeof(SiriAIChat).GetMethod("ApplyPresenceSettingsAsync", PrivateFields);
+            try
+            {
+                Task opening = audio.OpenAsync(CancellationToken.None);
+                double audioDeadline = Time.realtimeSinceStartupAsDouble + 20;
+                while (!opening.IsCompleted && Time.realtimeSinceStartupAsDouble < audioDeadline) yield return null;
+                Assert.IsTrue(opening.IsCompleted, "EasyMic startup timed out.");
+                opening.GetAwaiter().GetResult();
+                audio.SetCaptureEnabled(true);
+                for (int cycle = 0; cycle < 3; ++cycle)
+                {
+                    var startup = (Task)apply.Invoke(chat, new object[] { settings, Task.CompletedTask, 0 });
+                    while (!startup.IsCompleted) yield return null;
+                    TestContext.WriteLine("C930c EasyMic cycle=" + cycle + " camera=" + chat.VisualCameraStatus +
+                        " error=" + (startup.Exception?.GetBaseException().Message ?? "none"));
+                    startup.GetAwaiter().GetResult();
+                    long samples = 0; int frames = 0;
+                    var pcm = new float[audio.Capture.MaximumCaptureSamples];
+                    double deadline = Time.realtimeSinceStartupAsDouble + 2;
+                    while (Time.realtimeSinceStartupAsDouble < deadline)
+                    {
+                        while (audio.Capture.TryReadCapture(pcm, 0, out _, out int count)) samples += count;
+                        if (chat.VisualCamera.didUpdateThisFrame) ++frames;
+                        yield return null;
+                    }
+                    TestContext.WriteLine("C930c EasyMic cycle=" + cycle + " videoFrames=" + frames + " samples=" + samples);
+                    Assert.Greater(frames, 0);
+                    Assert.Greater(samples, 0);
+                    Assert.IsNull(audio.Fault);
+                }
+                var stopping = (Task)typeof(SiriAIChat).GetMethod("StopInteractionAsync", PrivateFields).Invoke(chat, null);
+                while (!stopping.IsCompleted) yield return null;
+                stopping.GetAwaiter().GetResult();
+            }
+            finally
+            {
+                var stop = (Task)typeof(SiriAIChat).GetMethod("StopInteractionAsync", PrivateFields).Invoke(chat, null);
+                if (!stop.IsCompleted) Debug.LogWarning("Camera cleanup is still completing.");
+                audio.Close(); UnityEngine.Object.DestroyImmediate(root);
+            }
+        }
 
