+    public sealed class SiriAIResetTestBackend : SiriAIChatBackend
+    {
+        public MNNConversationRuntimeFactory Factory;
+        public TaskCompletionSource<bool> ReleaseGate;
+        public int Registrations, ReleaseFailuresRemaining;
+        public readonly System.Collections.Generic.List<Model> Models = new System.Collections.Generic.List<Model>();
+
+        public override SiriAIBackendRegistration CreateRegistration(SiriAIChatContext context)
+        {
+            ++Registrations;
+            var model = new Model();
+            Models.Add(model);
+            var factory = Factory = new MNNConversationRuntimeFactory(new SiriAIConversationRuntime.Context(context),
+                new MNNConversationOptions { speechOutput = false },
+                new MNNConversationRegistrations { Model = new MNNConversationStageRegistration(model.Capabilities, () => model) });
+            return new SiriAIBackendRegistration(factory, model.Capabilities, context.DeviceCapabilities,
+                submitTextAsync: factory.SubmitTextAsync, speechOutput: false, requireMeasuredSpeech: false,
+                resetConversationAsync: factory.ResetConversationAsync, restoreConversationAsync: factory.RestoreConversationAsync,
+                releaseAsync: async () =>
+                {
+                    if (ReleaseGate != null) await ReleaseGate.Task;
+                    if (ReleaseFailuresRemaining-- > 0) throw new InvalidOperationException("Injected auxiliary cleanup failure.");
+                    await factory.ReleaseAsync();
+                });
+        }
+
+        public sealed class Model : IMNNConversationTextProvider
+        {
+            public int Disposals;
+            public string LastInput;
+            public string Prompt;
+            public MNNRealtimeCapabilities Capabilities => new MNNRealtimeCapabilities(MNNRealtimeFeature.TextInput |
+                MNNRealtimeFeature.ContextRecovery | MNNRealtimeFeature.BoundedCancellation,
+                "Managed reset fixture", "No native inference.", execution: MNNRealtimeExecution.Managed);
+            public Task PrepareAsync(CancellationToken token) => Task.CompletedTask;
+            public Task GenerateAsync(System.Collections.Generic.IReadOnlyList<MNNOpenAIMessage> history,
+                float[] audio, int rate, Func<string, Task> delta, CancellationToken token)
+            {
+                LastInput = history[history.Count - 1].Text;
+                Prompt = string.Join("\n", System.Linq.Enumerable.Select(history, item => item.Text));
+                return delta("Fresh answer.");
+            }
+            public void Dispose() { ++Disposals; }
+        }
+    }
