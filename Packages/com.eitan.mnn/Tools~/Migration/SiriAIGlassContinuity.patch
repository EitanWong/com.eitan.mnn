     public sealed class SiriAIWovenRibbonTests
     {
         private const int Size = 256;
+
+        [TestCase(false)]
+        [TestCase(true)]
+        public void SpeechFoldsRemainReadableAtTheAuthoredExposure(bool mobile)
+        {
+            using (var view = new SiriAIOrbStyleView(SiriAIOrbStyle.Original, false))
+            {
+                if (mobile) view.Material.shader = Shader.Find("Hidden/SiriAI/OrbMobile");
+                view.EnableCameraQuality();
+                var quality = SiriAIGraphicsQuality.Selection;
+                var tonemapping = SiriAIGraphicsQuality.TonemappingMode;
+                try
+                {
+                    SiriAIGraphicsQuality.Apply(SiriAIQualityTier.Ultra, SiriAITonemappingMode.Aces);
+                    view.SetScale(1);
+                    view.Material.SetFloat("_StrandWidth", 1.54f * 1.8f);
+                    view.Material.SetFloat("_StrandSaturation", .38f);
+                    view.Material.SetFloat("_StrandLevel", .802f);
+                    var pixels = view.Render(4f, level: 1, motionTime: 4f * 6.37f / 3.05f);
+                    int size = SiriAIOrbStyleView.Size, x = size / 2;
+                    int bottom = 0, top = 0;
+                    for (int y = size / 3; y < size * 2 / 3; ++y)
+                        if (DisplayLuminance(pixels[y * size + x]) > .55f)
+                        { if (bottom == 0) bottom = y; top = y; }
+                    Assert.Greater(top - bottom, size / 16, "The active ribbon must open visibly.");
+                    int middle = (bottom + top) / 2;
+                    float lower = 0, upper = 0;
+                    for (int y = bottom; y < middle; ++y)
+                        lower = Mathf.Max(lower, DisplayLuminance(pixels[y * size + x]));
+                    for (int y = middle + 1; y <= top; ++y)
+                        upper = Mathf.Max(upper, DisplayLuminance(pixels[y * size + x]));
+                    Assert.Greater(Mathf.Min(lower, upper) - DisplayLuminance(pixels[middle * size + x]), .10f,
+                        "At the reference's 4 s turn the two folds must stay visible after actual exposure and tonemapping, rather than merging into an opaque white band.");
+                }
+                finally { SiriAIGraphicsQuality.Apply(quality, tonemapping); }
+            }
+        }
+
+        private static float DisplayLuminance(Color color)
+        {
+            if (QualitySettings.activeColorSpace == ColorSpace.Linear) color = color.gamma;
+            return color.r * .2126f + color.g * .7152f + color.b * .0722f;
+        }
 
         [TestCase(SiriAIOrbStyle.Original, 1f)]
         [TestCase(SiriAIOrbStyle.LiquidSpectrum, 1f)]
