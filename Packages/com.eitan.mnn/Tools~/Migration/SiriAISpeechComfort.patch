+++ b/Assets/Samples/SiriAI/Scripts/Runtime/Components/Presentation/Chat/SiriAIChatView.Settings.IdentityManager.cs
@@ -0,0 +1,97 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using MNN.Unity;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private const int PeopleTab = 16;
+        private readonly List<Texture2D> _identityThumbnails = new List<Texture2D>();
+
+        private void BuildPeopleSettings()
+        {
+            var settings = _settingsDraft?.Acoustics?.interaction;
+            if (settings == null) return;
+            settings.identities = settings.identities ?? Array.Empty<MNNInteractionIdentity>();
+            AddSettingsTitle("People", "Name, preview and manage everyone recorded on this device. Save settings to apply changes.");
+            var addFace = SettingsButton(_settingsContent, "Add face", GlassInset, Ink);
+            FixedHeight(addFace.gameObject, 44);
+            addFace.onClick.AddListener(() => OpenIdentityGuide(null, true, false));
+            var addVoice = SettingsButton(_settingsContent, "Add voice", GlassInset, Ink);
+            FixedHeight(addVoice.gameObject, 44);
+            addVoice.onClick.AddListener(() => OpenIdentityGuide(null, false, true));
+            if (settings.identities.Length == 0) SettingsDescription("No people recorded yet.");
+            for (int i = 0; i < settings.identities.Length; ++i)
+                BuildPersonSettings(settings, settings.identities[i], i + 1);
+        }
+
+        private void BuildPersonSettings(MNNInteractionSettings settings, MNNInteractionIdentity person, int number)
+        {
+            var row = AddSettingsField(LocalizeFormat("Person {0}", number),
+                Localize(person.face.Length > 0 ? "Face recorded" : "No face recording") + " · " +
+                Localize(person.voice.Length > 0 ? "Voice recorded" : "No voice recording"));
+            var frame = RectObject("Person portrait", row);
+            FixedHeight(frame.gameObject, 96);
+            var portrait = RectObject("Person preview", frame).gameObject.AddComponent<RawImage>();
+            portrait.raycastTarget = false;
+            portrait.texture = ReadIdentityThumbnail(person);
+            var aspect = portrait.gameObject.AddComponent<AspectRatioFitter>();
+            aspect.aspectMode = AspectRatioFitter.AspectMode.FitInParent;
+            aspect.aspectRatio = (float)portrait.texture.width / portrait.texture.height;
+            AddTextField("Person name", "Up to 64 characters.",
+                () => string.IsNullOrWhiteSpace(person.displayName) ? LocalizeFormat("Person {0}", number) : person.displayName,
+                name =>
+                {
+                    name = name.Trim();
+                    if (name.Length == 0 || name.Length > 64) throw new ArgumentException(Localize("Enter a name of 1 to 64 characters."));
+                    person.displayName = name;
+                }).characterLimit = 64;
+            AddBoolField("Allow interaction", null, () => person.allowed, allowed => UpdateAudioSettings(() =>
+            { person.allowed = allowed; UpdateIdentityPolicy(settings); }));
+            var face = SettingsButton(_settingsContent, "Update face", GlassInset, Ink); FixedHeight(face.gameObject, 44);
+            face.onClick.AddListener(() => OpenIdentityGuide(person.id, true, false));
+            var voice = SettingsButton(_settingsContent, "Update voice", GlassInset, Ink); FixedHeight(voice.gameObject, 44);
+            voice.onClick.AddListener(() => OpenIdentityGuide(person.id, false, true));
+            var remove = SettingsButton(_settingsContent, "Delete registration", GlassInset, Ink); FixedHeight(remove.gameObject, 44);
+            remove.onClick.AddListener(() => UpdateAudioSettings(() =>
+            {
+                settings.identities = settings.identities.Where(entry => entry.id != person.id).ToArray();
+                UpdateIdentityPolicy(settings);
+            }));
+        }
+
+        private Texture2D ReadIdentityThumbnail(MNNInteractionIdentity person)
+        {
+            var texture = new Texture2D(2, 2, TextureFormat.RGB24, false) { hideFlags = HideFlags.DontSave };
+            bool loaded = false;
+            try
+            {
+                if (!string.IsNullOrEmpty(person.facePreviewPng))
+                {
+                    person.Validate();
+                    loaded = texture.LoadImage(Convert.FromBase64String(person.facePreviewPng));
+                }
+            }
+            catch (ArgumentException) { }
+            catch (FormatException) { }
+            if (!loaded)
+            {
+                texture.SetPixels(new[] { new Color(.17f, .24f, .29f), new Color(.23f, .32f, .37f),
+                    new Color(.23f, .32f, .37f), new Color(.17f, .24f, .29f) });
+                texture.Apply();
+            }
+            _identityThumbnails.Add(texture);
+            return texture;
+        }
+
+        private void ReleaseIdentityPreviews()
+        {
+            foreach (var texture in _identityThumbnails) if (texture != null) Release(texture);
+            _identityThumbnails.Clear();
+        }
+    }
+}
