@@ -0,0 +1,73 @@
+using System;
+using NUnit.Framework;
+
+namespace MNN.Unity.Tests
+{
+    public sealed class SpeechComfortTests
+    {
+        [TestCase(.3f, -16f, .5f)]
+        [TestCase(1f, 36f, -.4f)]
+        [TestCase(3f, 25f, .35f)]
+        public void FacingAllowsNodsRollAndDistance(float scale, float noseY, float roll)
+        {
+            var p = new[] { new MNNImagePoint(-18, 0), new MNNImagePoint(18, 0), new MNNImagePoint(5, noseY), new MNNImagePoint(-14, 40), new MNNImagePoint(14, 40) };
+            for (int i = 0; i < p.Length; ++i)
+                p[i] = new MNNImagePoint(320 + scale * (p[i].X * (float)Math.Cos(roll) - p[i].Y * (float)Math.Sin(roll)),
+                    240 + scale * (p[i].X * (float)Math.Sin(roll) + p[i].Y * (float)Math.Cos(roll)));
+            Assert.Greater(MNNFaceFacing.Estimate(p), .7f, "Comfortable yaw must remain facing despite nods, roll or scale.");
+        }
+        [Test]
+        public void TargetRemainsTheSameWhileMovingCloser()
+        {
+            var tracker = new MNNFaceTargetTracker();
+            var first = new MNNDetection(0, "face", .95f, 100, 100, 60, 80);
+            Assert.AreEqual(0, tracker.Select(new[] { first }, 1, 640, 480, true));
+            string track = tracker.TrackId;
+            var closer = new MNNDetection(0, "face", .95f, 70, 60, 120, 160);
+            Assert.AreEqual(0, tracker.Select(new[] { closer }, 1.1, 640, 480, true));
+            Assert.AreEqual(track, tracker.TrackId, "Distance changes must not erase an unambiguous target's lip evidence.");
+        }
+
+        private static float[] Face(int dx, int dy, bool mouth, float light = 0)
+        {
+            var frame = new float[112 * 112];
+            for (int y = 0; y < 112; ++y)
+                for (int x = 0; x < 112; ++x)
+                {
+                    int px = x - dx, py = y - dy;
+                    float texture = (float)(.18 * Math.Sin(px * .43) + .14 * Math.Cos(py * .37) + .1 * Math.Sin((px + py) * .25));
+                    frame[y * 112 + x] = texture * (py > 70 ? 2 : .4f) + light + (mouth && px >= 40 && px < 72 && py >= 80 && py < 99 ? .3f : 0);
+                }
+            return frame;
+        }
+        [TestCase(.1)]
+        [TestCase(.16)]
+        public void MouthKeepsSpeakingAtVariableCadenceThenBecomesQuiet(double interval)
+        {
+            var activity = new MNNVisualSpeechActivity();
+            for (int i = 0; i <= 12; ++i)
+            {
+                double t = 1 + i * interval;
+                activity.ObserveFacing(1, t, "target");
+                activity.Observe(Face(i % 3 - 1, i % 2, i % 2 == 1, i * .005f), t, "target");
+                if (i >= 3) Assert.AreEqual(MNNVisualSpeechActivityState.Speaking, activity.GetState(t));
+            }
+            for (int i = 13; i <= 19; ++i)
+            { double t = 1 + i * interval; activity.ObserveFacing(1, t, "target"); activity.Observe(Face(0, 0, false), t, "target"); }
+            Assert.AreEqual(MNNVisualSpeechActivityState.Quiet, activity.GetState(1 + 19 * interval));
+            Assert.AreEqual(MNNVisualSpeechActivityState.WaitingForVideo, activity.GetState(2 + 19 * interval));
+        }
+        [Test]
+        public void WholeFaceTranslationAndLightCannotStartSpeech()
+        {
+            var activity = new MNNVisualSpeechActivity();
+            for (int i = 0; i < 12; ++i)
+            {
+                double t = 1 + i * .06;
+                activity.ObserveFacing(1, t, "target");
+                activity.Observe(Face(i % 4 - 2, i % 3 - 1, false, i * .012f), t, "target");
+                Assert.AreEqual(MNNVisualSpeechActivityState.Quiet, activity.GetState(t));
+            }
+        }
+    }
+}
