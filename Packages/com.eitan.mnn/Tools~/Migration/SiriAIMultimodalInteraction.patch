+            var interaction = _chat?.Interaction;
+            bool detecting = interaction != null && interaction.ReadSettings().visualPresence;
+            UpdateCameraOverlay(ready && detecting ? interaction.Camera.LatestObservation : null,
+                detecting ? interaction.Presence.Current : default, Time.realtimeSinceStartupAsDouble, ready && detecting);
