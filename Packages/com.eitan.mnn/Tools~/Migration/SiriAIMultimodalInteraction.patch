+using System;
+using System.Reflection;
+using MNN.Unity;
+using NUnit.Framework;
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class InteractionSettingsTests
+    {
+        [Test]
+        public void IndependentSwitchesSurviveSavedSettingsAndSnapshots()
+        {
+            string key = "SiriAI.Interaction.Test." + Guid.NewGuid().ToString("N");
+            var settings = new SiriAIAcousticSettings
+            {
+                interaction = new MNNInteractionSettings { referenceSpeaker = true, separateSpeakers = true }
+            };
+            settings.interaction.camera.deviceName = "preferred camera";
+            settings.interaction.camera.automaticQuality = false;
+            settings.interaction.camera.width = 1920; settings.interaction.camera.height = 1080;
+            try
+            {
+                SiriAIAcousticPreferencesStore.Save(key, settings);
+                var restored = SiriAIAcousticPreferencesStore.Read(key);
+                Assert.That(restored.interaction.referenceSpeaker, Is.True);
+                Assert.That(restored.interaction.separateSpeakers, Is.True);
+                Assert.That(restored.interaction.audioVisualSpeech, Is.False);
+                Assert.That(restored.interaction.visualPresence, Is.False);
+                Assert.That(restored.interaction.camera.deviceName, Is.EqualTo("preferred camera"));
+                Assert.That(restored.interaction.camera.RequestedWidth, Is.EqualTo(1920));
+                var snapshot = restored.Snapshot();
+                snapshot.interaction.referenceSpeaker = false;
+                snapshot.interaction.camera.deviceName = "changed";
+                Assert.That(restored.interaction.referenceSpeaker, Is.True);
+                Assert.That(restored.interaction.camera.deviceName, Is.EqualTo("preferred camera"));
+            }
+            finally { PlayerPrefs.DeleteKey(key); }
+        }
+
+        [Test]
+        public void InteractionChangesRequireRestartAndCannotBeMisclassifiedAsWakeOnly()
+        {
+            var before = new SiriAIAcousticSettings();
+            var after = before.Snapshot();
+            after.interaction.visualPresence = true;
+            Assert.That(SiriAIWakeWordSettings.OnlyWakeChanged(before, after), Is.False);
+        }
+
+        [Test]
+        public void MeasuredDefaultsApplyOnlyWithoutUserOverrideAndMatchingEvidence()
+        {
+            string key = "SiriAI.Defaults.Test." + Guid.NewGuid().ToString("N");
+            var root = new GameObject("quality-default-test");
+            try
+            {
+                var owner = root.AddComponent<SiriAIAcousticProcessing>();
+                typeof(SiriAIAcousticProcessing).GetField("preferencesKey", BindingFlags.Instance | BindingFlags.NonPublic).SetValue(owner, key);
+                owner.RecognitionDefaults = new MNNRecognitionDefaults(new[] {
+                    new MNNRecognitionPreset(new MNNRecognitionQuality("evaluated-config", "corpus", "device", "zh", "CER", 2, 100, 50, true),
+                        new MNNAcousticSettings(), new MNNInteractionSettings()) });
+                owner.EvaluationCorpusId = "corpus"; owner.EvaluationDeviceId = "device"; owner.EvaluationLanguage = "zh";
+                var user = new SiriAIAcousticSettings(); user.interaction.referenceSpeaker = true;
+                SiriAIAcousticPreferencesStore.Save(key, user);
+                Assert.That(owner.ReadSettings().interaction.referenceSpeaker, Is.True);
+                Assert.That(owner.ReadSettings().interaction.measuredConfigurationId, Is.Null.Or.Empty);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); PlayerPrefs.DeleteKey(key); }
+        }
+    }
+}
