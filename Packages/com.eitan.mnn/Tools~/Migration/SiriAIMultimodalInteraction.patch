+using System.Collections.Generic;
+using MNN.Unity;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private sealed class CameraDetectionBox
+        {
+            public RectTransform Root;
+            public Text Caption;
+            public Image[] Edges;
+        }
+
+        private RectTransform _cameraPreviewSurface;
+        private Text _cameraPresenceStatus;
+        private readonly List<CameraDetectionBox> _cameraDetectionBoxes = new List<CameraDetectionBox>();
+        private static readonly Color CameraConfirmed = new Color(.22f, 1, .58f);
+        private static readonly Color CameraPending = new Color(1, .78f, .25f);
+        private static readonly Color CameraDetected = new Color(.3f, .8f, 1);
+
+        private void BuildCameraPreview()
+        {
+            _cameraDetectionBoxes.Clear();
+            var frame = RectObject("Camera Preview", _settingsContent);
+            FixedHeight(frame.gameObject, 260);
+            var background = frame.gameObject.AddComponent<Image>();
+            background.color = new Color(.035f, .045f, .06f); background.raycastTarget = false;
+            _cameraPreviewSurface = RectObject("Upright Camera Surface", frame);
+            Stretch(_cameraPreviewSurface);
+            _cameraSettingsAspect = _cameraPreviewSurface.gameObject.AddComponent<AspectRatioFitter>();
+            _cameraSettingsAspect.aspectMode = AspectRatioFitter.AspectMode.FitInParent;
+            _cameraSettingsAspect.aspectRatio = 16f / 9;
+            var preview = RectObject("Live Camera", _cameraPreviewSurface);
+            _cameraSettingsPreview = preview.gameObject.AddComponent<RawImage>();
+            _cameraSettingsPreview.raycastTarget = false; _cameraSettingsPreview.enabled = false;
+            _cameraPresenceStatus = Label(frame, "Enable visual presence and save to see live detection.", 15, Color.white);
+            _cameraPresenceStatus.name = "Presence Preview Status";
+            var badge = _cameraPresenceStatus.rectTransform;
+            badge.anchorMin = new Vector2(0, 1); badge.anchorMax = Vector2.one; badge.pivot = new Vector2(.5f, 1);
+            badge.offsetMin = new Vector2(12, -58); badge.offsetMax = new Vector2(-12, -8);
+            _cameraPresenceStatus.alignment = TextAnchor.UpperLeft;
+            _cameraPresenceStatus.gameObject.AddComponent<Shadow>().effectColor = Color.black;
+            Label(_settingsContent, "Live applied settings. Save changes to update detection.", 14, Muted);
+        }
+
+        private void LayoutCameraPreview(int width, int height, int rotation, bool mirrored)
+        {
+            bool quarterTurn = rotation % 180 != 0;
+            _cameraSettingsAspect.aspectRatio = quarterTurn ? (float)height / width : (float)width / height;
+            var raw = _cameraSettingsPreview.rectTransform;
+            raw.anchorMin = raw.anchorMax = raw.pivot = new Vector2(.5f, .5f);
+            raw.anchoredPosition = Vector2.zero;
+            var size = _cameraPreviewSurface.rect.size;
+            raw.sizeDelta = quarterTurn ? new Vector2(size.y, size.x) : size;
+            raw.localEulerAngles = new Vector3(0, 0, -rotation);
+            _cameraSettingsPreview.uvRect = mirrored ? new Rect(0, 1, 1, -1) : new Rect(0, 0, 1, 1);
+        }
+
+        private void UpdateCameraOverlay(MNNPresenceObservation? observation, MNNPresenceSnapshot presence, double now, bool ready)
+        {
+            for (int i = 0; i < _cameraDetectionBoxes.Count; ++i) _cameraDetectionBoxes[i].Root.gameObject.SetActive(false);
+            bool fresh = ready && observation.HasValue && now >= observation.Value.CapturedAt && now - observation.Value.CapturedAt <= .75;
+            var frame = fresh ? observation.Value.DetectionFrame : null;
+            bool admitted = fresh && presence.CanStartInteraction && presence.TrackId == observation.Value.TrackId;
+            _cameraPresenceStatus.color = admitted ? CameraConfirmed : CameraPending;
+            if (!ready)
+            {
+                _cameraPresenceStatus.text = Localize(_editorPreview ? "Preview only. Camera is not started." :
+                    _chat != null && _chat.IsVisualLoading ? _chat.VisualCameraStatus : "Enable visual presence and save to see live detection.");
+                return;
+            }
+            string state = PresencePreviewState(presence.State, admitted);
+            if (!fresh) { _cameraPresenceStatus.text = Localize("Waiting for fresh detection…") + " · " + state; return; }
+            _cameraPresenceStatus.text = (frame == null ? Localize("Detection boxes unavailable") :
+                frame.Detections.Count == 0 ? Localize("No face detected") : Localize("Faces") + ": " + frame.Detections.Count) + " · " + state;
+            if (frame == null) return;
+            for (int i = 0; i < System.Math.Min(32, frame.Detections.Count); ++i)
+            {
+                var detection = frame.Detections[i];
+                float left = Mathf.Clamp01(detection.X / frame.Width), right = Mathf.Clamp01((detection.X + detection.Width) / frame.Width);
+                float top = Mathf.Clamp01(detection.Y / frame.Height), bottom = Mathf.Clamp01((detection.Y + detection.Height) / frame.Height);
+                if (right <= left || bottom <= top) continue;
+                while (_cameraDetectionBoxes.Count <= i) _cameraDetectionBoxes.Add(CreateCameraDetectionBox());
+                var box = _cameraDetectionBoxes[i];
+                box.Root.gameObject.SetActive(true);
+                box.Root.anchorMin = new Vector2(left, 1 - bottom); box.Root.anchorMax = new Vector2(right, 1 - top);
+                box.Root.offsetMin = box.Root.offsetMax = Vector2.zero;
+                bool target = frame.SelectedIndex == i;
+                Color color = target ? admitted ? CameraConfirmed : CameraPending : CameraDetected;
+                foreach (var edge in box.Edges) edge.color = color;
+                box.Caption.color = color;
+                box.Caption.text = Localize(target ? "Target" : "Face") + " " + detection.Score.ToString("P0");
+            }
+        }
+
+        private string PresencePreviewState(MNNPresenceState state, bool admitted)
+        {
+            switch (state)
+            {
+                case MNNPresenceState.Present: return Localize(admitted ? "Ready to interact" : "Interaction not admitted");
+                case MNNPresenceState.Acquiring: return Localize("Confirming presence…");
+                case MNNPresenceState.Grace: return Localize("Brief absence · keeping interface");
+                case MNNPresenceState.Standby: return Localize("Standby");
+                default: return Localize("Sleeping · watching for return");
+            }
+        }
+
+        private CameraDetectionBox CreateCameraDetectionBox()
+        {
+            var root = RectObject("Detection Box", _cameraPreviewSurface);
+            var edges = new Image[4];
+            for (int i = 0; i < edges.Length; ++i)
+            {
+                var rect = RectObject("Box Edge", root);
+                bool horizontal = i < 2;
+                rect.anchorMin = horizontal ? new Vector2(0, i) : new Vector2(i - 2, 0);
+                rect.anchorMax = horizontal ? new Vector2(1, i) : new Vector2(i - 2, 1);
+                rect.sizeDelta = horizontal ? new Vector2(0, 2) : new Vector2(2, 0);
+                rect.anchoredPosition = Vector2.zero;
+                edges[i] = rect.gameObject.AddComponent<Image>(); edges[i].raycastTarget = false;
+            }
+            var caption = Label(root, "", 13, CameraDetected, false);
+            caption.name = "Detection Caption"; caption.raycastTarget = false;
+            caption.alignment = TextAnchor.UpperLeft;
+            caption.rectTransform.anchorMin = new Vector2(0, 1); caption.rectTransform.anchorMax = Vector2.one;
+            caption.rectTransform.pivot = Vector2.up;
+            caption.rectTransform.offsetMin = new Vector2(4, -24); caption.rectTransform.offsetMax = new Vector2(-4, -3);
+            caption.gameObject.AddComponent<Shadow>().effectColor = Color.black;
+            return new CameraDetectionBox {Root = root, Edges = edges, Caption = caption};
+        }
+    }
+}
