+using MNN.Unity;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private MNNPresenceComponent _presencePresentation;
+        private CanvasGroup _presenceCanvas, _presenceBlack;
+        private Transform _presenceOrbContainer;
+        private bool _presencePresentationActive;
+
+        private void TickInteractionPresentation()
+        {
+            if (Input.GetKeyDown(KeyCode.Comma) && (Input.GetKey(KeyCode.LeftControl) || Input.GetKey(KeyCode.RightControl) ||
+                Input.GetKey(KeyCode.LeftCommand) || Input.GetKey(KeyCode.RightCommand))) OpenSettings();
+            var interaction = _chat?.Interaction;
+            bool enabled = interaction != null && interaction.ReadSettings().visualPresence;
+            if (!enabled && !_presencePresentationActive) return;
+            if (_presenceCanvas == null && _canvasRoot != null)
+                _presenceCanvas = _canvasRoot.GetComponent<CanvasGroup>() ?? _canvasRoot.AddComponent<CanvasGroup>();
+            if (!enabled)
+            {
+                if (_presencePresentation != null) _presencePresentation.ConfigurePresentation(null, null, MNNPresenceSleepDisplay.Hidden);
+                if (_presenceCanvas != null) { _presenceCanvas.alpha = 1; _presenceCanvas.interactable = _presenceCanvas.blocksRaycasts = true; }
+                if (_presenceBlack != null) _presenceBlack.alpha = 0;
+                if (_presenceOrbContainer != null) _presenceOrbContainer.localScale = Vector3.one;
+                _presencePresentationActive = false;
+                return;
+            }
+            if (_presenceBlack == null && _canvasRoot != null)
+            {
+                var overlay = new GameObject("Presence Black Screen", typeof(RectTransform), typeof(Canvas), typeof(CanvasGroup), typeof(Image));
+                overlay.transform.SetParent(_canvasRoot.transform.parent, false);
+                var rect = (RectTransform)overlay.transform;
+                rect.anchorMin = Vector2.zero; rect.anchorMax = Vector2.one; rect.offsetMin = rect.offsetMax = Vector2.zero;
+                var canvas = overlay.GetComponent<Canvas>(); canvas.renderMode = RenderMode.ScreenSpaceOverlay; canvas.sortingOrder = short.MaxValue;
+                overlay.GetComponent<Image>().color = Color.black;
+                _presenceBlack = overlay.GetComponent<CanvasGroup>(); _presenceBlack.alpha = 0;
+                _presenceBlack.interactable = _presenceBlack.blocksRaycasts = false;
+            }
+            if (_presenceOrbContainer == null && siriOrb != null)
+            {
+                _presenceOrbContainer = new GameObject("Presence Orb Container").transform;
+                _presenceOrbContainer.SetParent(siriOrb.transform.parent, false);
+                siriOrb.transform.SetParent(_presenceOrbContainer, true);
+                interaction.Presence.ConfigureVisualRoot(_presenceOrbContainer);
+            }
+            _presencePresentation = interaction.Presence;
+            // Keep settings usable so camera gating can always be disabled without a visible face.
+            bool settingsOpen = IsSettingsOpen || IsSetupOpen;
+            _presencePresentation.ConfigurePresentation(settingsOpen ? null : _presenceCanvas,
+                settingsOpen ? null : _presenceBlack, interaction.ReadSettings().sleepDisplay);
+            if (settingsOpen)
+            {
+                if (_presenceCanvas != null) { _presenceCanvas.alpha = 1; _presenceCanvas.interactable = _presenceCanvas.blocksRaycasts = true; }
+                if (_presenceBlack != null) _presenceBlack.alpha = 0;
+            }
+            _presencePresentationActive = true;
+        }
+
+        private void ReleaseInteractionPresentation()
+        {
+            if (_presencePresentation != null)
+            { _presencePresentation.ConfigurePresentation(null, null, MNNPresenceSleepDisplay.Hidden); _presencePresentation.ConfigureVisualRoot(null); }
+            if (_presenceOrbContainer != null)
+            {
+                if (siriOrb != null) siriOrb.transform.SetParent(_presenceOrbContainer.parent, true);
+                Release(_presenceOrbContainer.gameObject);
+            }
+            if (_presenceBlack != null) Release(_presenceBlack.gameObject);
+            _presencePresentation = null; _presenceBlack = null; _presenceOrbContainer = null;
+            _presenceCanvas = null; _presencePresentationActive = false;
+        }
+    }
+}
