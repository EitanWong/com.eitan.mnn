+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using System.IO;
+using System.Collections;
+using UnityEngine.TestTools;
+using System.Threading.Tasks;
+using MNN.Unity;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class VisionSettingsTests
+    {
+        private const BindingFlags Private = BindingFlags.Instance | BindingFlags.NonPublic;
+        private static Transform Active(Transform root, string name)
+        {
+            for (int i = 0; i < root.childCount; ++i)
+            {
+                var child = root.GetChild(i);
+                if (child.name == name && child.gameObject.activeSelf) return child;
+            }
+            return null;
+        }
+        [Test]
+        public void VisionShowsCameraPreviewDirectlyWithoutAnExtraToggle()
+        {
+            var root = new GameObject("Direct visual feedback");
+            try
+            {
+                root.AddComponent<SiriAIChat>().enabled = false;
+                var view = root.AddComponent<SiriAIChatView>();
+                typeof(SiriAIChatView).GetMethod("InitializeView", Private).Invoke(view, new object[] {true});
+                view.OpenSettings();
+                typeof(SiriAIChatView).GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {13, true});
+                var content = (RectTransform)typeof(SiriAIChatView).GetField("_settingsContent", Private).GetValue(view);
+                var preview = Active(content, "Camera Preview");
+                Assert.That(preview, Is.Not.Null, "Vision should directly show the live preview surface without another switch.");
+                Assert.That(preview.GetComponentInChildren<RawImage>(), Is.Not.Null);
+                Assert.That(Active(content, "Camera preview"), Is.Null, "A second preview switch hides the requested immediate feedback.");
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); }
+        }
+
+        [Test]
+        public void PreviewOverlaysUprightTargetAndExpiresStaleEvidence()
+        {
+            var root = new GameObject("Camera overlay feedback");
+            try
+            {
+                root.AddComponent<SiriAIChat>().enabled = false;
+                var view = root.AddComponent<SiriAIChatView>();
+                var type = typeof(SiriAIChatView);
+                type.GetMethod("InitializeView", Private).Invoke(view, new object[] {true});
+                view.OpenSettings();
+                type.GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {13, true});
+                var constructor = typeof(MNNDetection).GetConstructors(Private)[0];
+                var box = (MNNDetection)constructor.Invoke(new object[] {0, "face", .9f, 160f, 120f, 320f, 240f});
+                var frame = new MNNPresenceDetectionFrame(640, 480, new[] {box}, 0);
+                var gate = new MNNPresenceController();
+                gate.Observe(new MNNPresenceObservation(1, MNNPresenceKind.Face, "target", .9f), 1);
+                var observation = new MNNPresenceObservation(1.4, MNNPresenceKind.Face, "target", .9f, null, frame);
+                var present = gate.Observe(observation, 1.4);
+                var update = type.GetMethod("UpdateCameraOverlay", Private);
+                update.Invoke(view, new object[] {observation, present, 1.4, true});
+                var surface = (RectTransform)type.GetField("_cameraPreviewSurface", Private).GetValue(view);
+                var outline = surface.Find("Detection Box") as RectTransform;
+                Assert.That(outline.gameObject.activeSelf, Is.True);
+                Assert.That(outline.anchorMin, Is.EqualTo(new Vector2(.25f, .25f)));
+                Assert.That(outline.anchorMax, Is.EqualTo(new Vector2(.75f, .75f)));
+                var status = (Text)type.GetField("_cameraPresenceStatus", Private).GetValue(view);
+                StringAssert.Contains("Ready to interact", status.text);
+                StringAssert.Contains("Target", outline.GetComponentInChildren<Text>().text);
+                Assert.That(outline.GetComponentInChildren<Image>().color.g, Is.EqualTo(1));
+                type.GetMethod("LayoutCameraPreview", Private).Invoke(view, new object[] {640, 480, 90, true});
+                var aspect = (AspectRatioFitter)type.GetField("_cameraSettingsAspect", Private).GetValue(view);
+                Assert.That(aspect.aspectRatio, Is.EqualTo(.75f));
+                var preview = (RawImage)type.GetField("_cameraSettingsPreview", Private).GetValue(view);
+                Assert.That(preview.uvRect, Is.EqualTo(new Rect(0, 1, 1, -1)));
+                update.Invoke(view, new object[] {observation, gate.Tick(1.5), 2.2, true});
+                Assert.That(outline.gameObject.activeSelf, Is.False, "Do not draw stale boxes over live video.");
+                StringAssert.Contains("Waiting for fresh detection", status.text);
+                var absent = MNNPresenceObservation.Absent(2.3, new MNNPresenceDetectionFrame(640, 480, new MNNDetection[0]));
+                update.Invoke(view, new object[] {absent, gate.Observe(absent, 2.3), 2.3, true});
+                StringAssert.Contains("No face detected", status.text);
+                update.Invoke(view, new object[] {null, gate.Tick(18), 18d, false});
+                Assert.That(outline.gameObject.activeSelf, Is.False);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); }
+        }
+
+        [Test]
+        public void VisionOffersCameraDeviceQualityTimingAndPreviewSettings()
+        {
+            var root = new GameObject("Visual camera settings");
+            try
+            {
+                root.AddComponent<SiriAIChat>().enabled = false;
+                var view = root.AddComponent<SiriAIChatView>();
+                var type = typeof(SiriAIChatView);
+                type.GetMethod("InitializeView", Private).Invoke(view, new object[] {true});
+                view.OpenSettings();
+                type.GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {13, true});
+                var content = (RectTransform)type.GetField("_settingsContent", Private).GetValue(view);
+                foreach (string label in new[] { "Camera", "Automatic camera quality", "Camera Preview", "Refresh cameras" })
+                    Assert.That(Active(content, label), Is.Not.Null, label);
+                Active(content, "Automatic camera quality").GetComponentInChildren<Button>().onClick.Invoke();
+                foreach (string label in new[] { "Camera resolution", "Camera frame rate", "Detection frame rate", "Sleep detection frame rate", "Detection image size", "Camera startup timeout (s)" })
+                    Assert.That(Active(content, label), Is.Not.Null, label);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); }
+        }
+
+        private sealed class OwnedVisualSource : IMNNPresenceSource, IDisposable
+        {
+            public bool Disposed;
+            public void Dispose() => Disposed = true;
+            public void Reset() { }
+            public MNNPresenceObservation Process(MNNRgbImage image, double capturedAt, System.Threading.CancellationToken token)
+                => MNNPresenceObservation.Absent(capturedAt);
+        }
+
+        [UnityTest]
+        public IEnumerator StoppingConversationReleasesOwnedVisualProvider()
+        {
+            var root = new GameObject("Visual provider session ownership");
+            try
+            {
+                var chat = root.AddComponent<SiriAIChat>(); chat.enabled = false;
+                // OnDisable has already stopped the empty fixture. Begin a new owned session state.
+                typeof(SiriAIChat).GetField("_stopTask", Private).SetValue(chat, null);
+                var source = new OwnedVisualSource();
+                typeof(SiriAIChat).GetField("_presenceSource", Private).SetValue(chat, source);
+                var stop = chat.StopConversationAsync();
+                while (!stop.IsCompleted) yield return null;
+                Assert.That(stop.IsFaulted, Is.False);
+                Assert.That(source.Disposed, Is.True, "Stopping a conversation must release its owned visual provider.");
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); }
+        }
+
+        [Test]
+        public void PresenceLoadingKeepsApplicationVisibleWithoutAdmittingSpeech()
+        {
+            var root = new GameObject("Presence loading presentation");
+            try
+            {
+                var chat = root.AddComponent<SiriAIChat>(); chat.enabled = false;
+                var view = root.AddComponent<SiriAIChatView>();
+                var type = typeof(SiriAIChatView);
+                type.GetMethod("InitializeView", Private).Invoke(view, new object[] {true});
+                var interaction = root.AddComponent<MNNInteractionComponent>();
+                interaction.Configure(new MNNInteractionSettings { visualPresence = true });
+                chat.ConfigureInteraction(interaction);
+                type.GetMethod("TickInteractionPresentation", Private).Invoke(view, null);
+                var canvas = (CanvasGroup)type.GetField("_presenceCanvas", Private).GetValue(view);
+                for (int i = 0; i < 100; ++i)
+                    typeof(MNNPresenceComponent).GetMethod("Update", Private).Invoke(interaction.Presence, null);
+                type.GetMethod("TickInteractionPresentation", Private).Invoke(view, null);
+                Assert.That(canvas.alpha, Is.EqualTo(1), "Loading UI must stay visible before camera/model observations are ready.");
+                Assert.That(canvas.interactable, Is.True);
+                Assert.That(interaction.CanStartInteraction, Is.False, "Visibility while loading must not admit unverified audio.");
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); }
+        }
+
+        [UnityTest]
+        public IEnumerator DetectionUsesSharedPicker() => CheckVisualPicker("Face detection model", 20, MNNImageTaskProfile.Scrfd500M, "det_500m.mnn");
+        [UnityTest]
+        public IEnumerator RecognitionUsesSharedPicker() => CheckVisualPicker("Face recognition model", 21, MNNImageTaskProfile.MobileFaceNet, "w600k_mbf.mnn");
+        private IEnumerator CheckVisualPicker(string label, int stage, MNNImageTaskProfile profile, string graph)
+        {
+            var root = new GameObject("Visual model picker");
+            string directory = Path.GetFullPath(Path.Combine(Application.dataPath, "../TestArtifacts~/VisionPickerTests/" + Guid.NewGuid().ToString("N")));
+            try
+            {
+                string model = Path.Combine(directory, "local-visual-model");
+                Directory.CreateDirectory(model);
+                File.WriteAllText(Path.Combine(model, MNNImageTaskConfig.FileName), JsonUtility.ToJson(new MNNImageTaskConfig { profile = profile }));
+                File.WriteAllBytes(Path.Combine(model, graph), new byte[] {1}); // File-presence UI fixture; not inference validation.
+                root.AddComponent<SiriAIChat>().enabled = false;
+                var view = root.AddComponent<SiriAIChatView>();
+                var type = typeof(SiriAIChatView);
+                type.GetMethod("InitializeView", Private).Invoke(view, new object[] {true});
+                type.GetField("_acousticModelsDirectory", Private).SetValue(view, (Func<string>)(() => directory));
+                view.TickEditorPreview(new Rect(0, 0, 844, 800), 1);
+                view.OpenSettings();
+                type.GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {13, true});
+                var content = (RectTransform)type.GetField("_settingsContent", Private).GetValue(view);
+                var row = Active(content, label);
+                Assert.That(row, Is.Not.Null, "Visual models must use the existing model picker even when detection is off.");
+                Assert.That(row.GetComponentInChildren<InputField>(), Is.Null);
+                row.GetComponentInChildren<Button>().onClick.Invoke();
+                Assert.That((bool)type.GetField("_settingsOptionsCatalog", Private).GetValue(view), Is.True);
+                Assert.That((int)type.GetField("_modelPickerStage", Private).GetValue(view), Is.EqualTo(stage));
+                var search = (InputField)type.GetField("_settingsSearch", Private).GetValue(view);
+                search.text = "local-visual-model";
+                var choices = ((RectTransform)type.GetField("_settingsOptionsContent", Private).GetValue(view)).GetComponentsInChildren<Button>();
+                Assert.That(choices.Length, Is.EqualTo(1));
+                choices[0].onClick.Invoke();
+                var draft = (SiriAISettingsDraft)type.GetProperty("SettingsDraft", Private).GetValue(view);
+                Assert.That(stage == 20 ? draft.Acoustics.interaction.detectorDirectory : draft.Acoustics.interaction.recognizerDirectory, Is.EqualTo("local-visual-model"), ((Text)type.GetField("_settingsNotice", Private).GetValue(view)).text);
+                Assert.That(draft.Acoustics.interaction.visualPresence, Is.False, "Choosing a model must not enable the camera.");
+                // Real selection must reject the deliberately non-publisher fixture graph.
+                type.GetField("_editorPreview", Private).SetValue(view, false);
+                bool acceptedInvalidGraph = false;
+                var selection = (Task)type.GetMethod("SelectVisionModelAsync", Private).Invoke(view, new object[] {
+                    stage, new SiriAIModelCatalog.Entry { installedDirectory = model }, (Action<string>)(_ => acceptedInvalidGraph = true) });
+                while (!selection.IsCompleted) yield return null;
+                Assert.That(selection.IsFaulted, Is.False);
+                type.GetField("_editorPreview", Private).SetValue(view, true);
+                Assert.That(acceptedInvalidGraph, Is.False, "The picker may hint file presence but a real selection must verify publisher SHA.");
+
+                type.GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {3, true});
+                type.GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {13, true});
+                Assert.That(stage == 20 ? draft.Acoustics.interaction.detectorDirectory : draft.Acoustics.interaction.recognizerDirectory, Is.EqualTo("local-visual-model"), ((Text)type.GetField("_settingsNotice", Private).GetValue(view)).text);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); if (Directory.Exists(directory)) Directory.Delete(directory, true); }
+        }
+
+        [Test]
+        public void VisionHasDedicatedNavigationAndDoesNotDuplicateAudioControls()
+        {
+            var root = new GameObject("Vision settings navigation");
+            try
+            {
+                root.AddComponent<SiriAIChat>();
+                var view = root.AddComponent<SiriAIChatView>();
+                view.TickEditorPreview(new Rect(0, 0, 844, 800), 1);
+                view.OpenSettings();
+                var type = typeof(SiriAIChatView);
+                var tabs = (List<Button>)type.GetField("_settingsTabs", Private).GetValue(view);
+                var ids = (List<int>)type.GetField("_settingsTabIds", Private).GetValue(view);
+                int vision = tabs.FindIndex(button => button.name == "Vision");
+                Assert.That(vision, Is.GreaterThanOrEqualTo(0), "Vision needs its own visible settings category.");
+                var icon = tabs[vision].GetComponentInChildren<SiriAIActionIcon>();
+                Assert.That(icon.Glyph.ToString(), Is.EqualTo("Eye"));
+                tabs[vision].onClick.Invoke();
+                var content = (RectTransform)type.GetField("_settingsContent", Private).GetValue(view);
+                foreach (string label in new[] { "Visual presence", "Recognized identities only", "Image context" })
+                    Assert.That(Active(content, label), Is.Not.Null, label);
+                Assert.That(Active(content, "Reference speaker extraction"), Is.Null);
+                Active(content, "Visual presence").GetComponentInChildren<Button>().onClick.Invoke();
+                Assert.That(Active(content, "Sleep display"), Is.Not.Null);
+                Assert.That(Active(content, "Face detection model"), Is.Not.Null);
+                var draft = (SiriAISettingsDraft)type.GetProperty("SettingsDraft", Private).GetValue(view);
+                Assert.That(draft.Acoustics.interaction.visualPresence, Is.True);
+                Active(content, "Confirmation time (s)").GetComponentInChildren<InputField>().text = "1.2";
+                Assert.That(Active(content, "Brief absence grace (s)"), Is.Not.Null);
+                Assert.That(Active(content, "Sleep after absence (s)"), Is.Not.Null);
+                type.GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {11, true});
+                Assert.That(draft.Acoustics.interaction.confirmationSeconds, Is.EqualTo(1.2f));
+                Assert.That(Active(content, "Visual presence"), Is.Null);
+                Assert.That(Active(content, "Reference speaker extraction"), Is.Not.Null);
+                type.GetMethod("ShowSettingsTab", Private).Invoke(view, new object[] {ids[vision], true});
+                Assert.That(draft.Acoustics.interaction.visualPresence, Is.True, "Navigating categories preserves the unsaved visual draft.");
+                Assert.That(Active(content, "Sleep display"), Is.Not.Null);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(root); }
+        }
+    }
+}
