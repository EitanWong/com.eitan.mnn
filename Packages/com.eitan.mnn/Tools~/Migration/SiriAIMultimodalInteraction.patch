+using System;
+using MNN.Unity;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private const int VisionTab = 13;
+
+        private void BuildVisionSettings()
+        {
+            var acoustics = _settingsDraft?.Acoustics;
+            if (acoustics == null)
+            { SettingsDescription("Add Acoustic Processing to configure visual interaction."); return; }
+            var value = acoustics.interaction ?? (acoustics.interaction = new MNNInteractionSettings());
+            AddSettingsTitle("Vision", "Changes apply after saving and restarting the conversation.");
+            BuildCameraPreview();
+            AddBoolField("Visual presence", "Allow new voice interactions only while a confirmed target is visible.",
+                () => value.visualPresence, enabled => UpdateAudioSettings(() => value.visualPresence = enabled));
+            AddBoolField("Recognized identities only", "Requires enrolled identities and a ready recognition provider.",
+                () => value.faceRecognition, enabled => UpdateAudioSettings(() => value.faceRecognition = enabled));
+            AddBoolField("Image context", "Use a fresh target image for supported multimodal requests.",
+                () => value.imageContext, enabled => UpdateAudioSettings(() => value.imageContext = enabled));
+            BuildVisionModelSelection("Face detection model", "Choose an installed model or download a supported detector.",
+                FaceDetectionModelStage, () => value.detectorDirectory, directory => value.detectorDirectory = directory);
+            BuildVisionModelSelection("Face recognition model", "Used only when identity matching is enabled.",
+                FaceRecognitionModelStage, () => value.recognizerDirectory, directory => value.recognizerDirectory = directory);
+            BuildCameraSettings(value);
+            if (value.visualPresence)
+            {
+                var form = new SettingsForm(this);
+                form.Number("Confirmation time (s)", "Continuous visibility required before interaction starts.",
+                    () => value.confirmationSeconds, seconds => value.confirmationSeconds = seconds, 0, 10);
+                form.Number("Brief absence grace (s)", "Keep the interface while a person briefly looks away or leaves.",
+                    () => value.graceSeconds, seconds => value.graceSeconds = seconds, 0, 120);
+                form.Number("Sleep after absence (s)", "Must be at least the brief absence grace period.",
+                    () => value.sleepSeconds, seconds => value.sleepSeconds = seconds, 0, 3600);
+                AddEnumField("Sleep display", null, () => (int)value.sleepDisplay,
+                    selected => value.sleepDisplay = (MNNPresenceSleepDisplay)selected, new[] { "Hide UI", "Dimmed standby", "Black screen" });
+                AddTextField("Allowed identities", "Comma-separated enrolled identifiers.", () => string.Join(", ", value.allowedIdentities ?? Array.Empty<string>()),
+                    text => value.allowedIdentities = text.Split(new[] { ',', ';', '\n' }, StringSplitOptions.RemoveEmptyEntries));
+            }
+        }
+
+        private void BuildTargetSpeechSettings()
+        {
+            var acoustics = _settingsDraft?.Acoustics;
+            if (acoustics == null) return;
+            var value = acoustics.interaction ?? (acoustics.interaction = new MNNInteractionSettings());
+            AddSettingsTitle("Target speech pickup", "Audio-visual pickup uses the camera configured in Vision.");
+            AddBoolField("Audio-visual target speech", "Requires a synchronized visual speech provider; stale video is rejected.",
+                () => value.audioVisualSpeech, enabled => UpdateAudioSettings(() => value.audioVisualSpeech = enabled));
+            AddBoolField("Reference speaker extraction", "Requires an enrolled voice and a target extraction provider.",
+                () => value.referenceSpeaker, enabled => UpdateAudioSettings(() => value.referenceSpeaker = enabled));
+            AddBoolField("Overlapping speaker separation", "Requires a separator and target identity selector; ambiguity is rejected.",
+                () => value.separateSpeakers, enabled => UpdateAudioSettings(() => value.separateSpeakers = enabled));
+            SettingsDescription(string.IsNullOrEmpty(value.measuredConfigurationId)
+                ? "No comparable CER/WER measurement is selected. Current defaults are not ranked for recognition accuracy."
+                : "Measured configuration: " + value.measuredConfigurationId);
+        }
+    }
+}
