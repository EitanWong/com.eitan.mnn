+            var devices = _cameraDevices();
+            var names = new string[devices.Length + 1]; names[0] = "Automatic (prefer front camera)";
+            for (int i = 0; i < devices.Length; ++i) names[i + 1] = devices[i].name;
+            int missing = -1;
+            if (!string.IsNullOrEmpty(camera.deviceName) && Array.FindIndex(devices, device => device.name == camera.deviceName) < 0)
+            {
+                missing = names.Length;
+                Array.Resize(ref names, names.Length + 1); names[missing] = camera.deviceName + " · " + Localize("Disconnected");
+            }
+            AddEnumField("Camera", "The automatic choice prefers a front camera; an unavailable saved device is never silently replaced.",
+                () => string.IsNullOrEmpty(camera.deviceName) ? 0 : Math.Max(missing, Array.FindIndex(devices, device => device.name == camera.deviceName) + 1),
+                selected => { if (selected != missing) camera.deviceName = selected == 0 ? "" : devices[selected - 1].name; }, names);
+            var refresh = SettingsButton(_settingsContent, "Refresh cameras", GlassInset, Ink, 17);
+            refresh.name = "Refresh cameras"; FixedHeight(refresh.gameObject, 44);
+            refresh.onClick.AddListener(() => { if (ReadSettingsFields()) ShowSettingsTab(VisionTab, false); });
+            AddBoolField("Automatic camera quality", "Requests 1280 × 720 at 30 FPS; analyzes up to 640 pixels at 10 FPS, or 2 FPS while asleep. Actual capture depends on the camera.",
+                () => camera.automaticQuality, enabled => UpdateAudioSettings(() => camera.automaticQuality = enabled));
+            if (!camera.automaticQuality)
+            {
+                int[] widths = {640, 1280, 1920, 3840}, heights = {480, 720, 1080, 2160};
+                AddEnumField("Camera resolution", "Requested resolution; the device may negotiate another size.",
+                    () => Array.IndexOf(widths, camera.width), selected => { camera.width = widths[selected]; camera.height = heights[selected]; },
+                    new[] { "640 × 480", "1280 × 720", "1920 × 1080", "3840 × 2160" });
+                AddIntField("Camera frame rate", "Requested capture FPS.", () => camera.framesPerSecond, value => camera.framesPerSecond = value, 1, 60);
+                AddIntField("Detection frame rate", "Maximum inference FPS; busy frames are dropped.", () => camera.detectionFramesPerSecond,
+                    value => camera.detectionFramesPerSecond = value, 1, 30);
+                AddIntField("Sleep detection frame rate", "Keep low-frequency detection active to wake when a person returns.", () => camera.sleepFramesPerSecond,
+                    value => camera.sleepFramesPerSecond = value, 1, 10);
+                AddIntField("Detection image size", "Maximum image edge in pixels, before model preprocessing.", () => camera.maximumImageEdge,
+                    value => camera.maximumImageEdge = value, 160, 1280);
+            }
+            new SettingsForm(this).Number("Camera startup timeout (s)", "Keep the loading interface visible while waiting for camera frames.",
+                () => camera.startupTimeoutSeconds, value => camera.startupTimeoutSeconds = value, 1, 120);
+            _cameraSettingsStatus = Label(_settingsContent, "", 16, Muted);
+            _cameraSettingsStatus.name = "Camera Status";
+            _cameraSettingsStatus.gameObject.AddComponent<LayoutElement>().minHeight = 64;
+            var retry = SettingsButton(_settingsContent, "Retry camera", GlassInset, Ink, 17);
+            FixedHeight(retry.gameObject, 44); retry.onClick.AddListener(() => { if (!_editorPreview) _chat?.RetryVisualCamera(); });
+            TickCameraSettings();
+        }
+
+        private void TickCameraSettings()
+        {
+            if (!IsSettingsOpen || _settingsTab != VisionTab || _cameraSettingsStatus == null) return;
+            string permission = Application.HasUserAuthorization(UserAuthorization.WebCam) ? "Camera permission granted" : "Camera permission required";
+            _cameraSettingsStatus.text = Localize(permission) + "\n" + (_editorPreview ? Localize("Preview only. Camera is not started.") : Localize(_chat?.VisualCameraStatus ?? "Camera unavailable"));
+            if (_cameraSettingsPreview == null) return;
