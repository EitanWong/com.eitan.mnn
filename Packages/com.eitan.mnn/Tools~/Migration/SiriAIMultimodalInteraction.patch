+using System;
+using System.Threading.Tasks;
+using System.Threading;
+using System.Collections;
+using System.IO;
+using MNN.Unity;
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChat
+    {
+        private MNNInteractionComponent _interaction;
+        private string _interactionConfiguration;
+        private MNNInteractionSettings _interactionSettings;
+        private double _nextInteractionSettingsRead;
+        private bool _lastPresenceAdmission;
+        private WebCamTexture _interactionCamera;
+        private IMNNPresenceSource _presenceSource;
+        private CancellationTokenSource _presenceLifetime;
+        private Task _presenceChange = Task.CompletedTask;
+        private int _presenceRevision;
+        private bool _visualReady;
+        private bool _visualStarting;
+        private string _visualCameraError;
+        public WebCamTexture VisualCamera => _interactionCamera;
+        public bool IsVisualLoading => !_visualReady || _visualStarting || !_presenceChange.IsCompleted || IsPreparingConversation ||
+            _interactionCamera == null || !_interactionCamera.isPlaying;
+        public string VisualCameraStatus => !string.IsNullOrEmpty(_visualCameraError) ? _visualCameraError :
+            _interaction == null || !_interaction.ReadSettings().visualPresence ? "Camera is off. Enable visual presence and save." :
+            _visualStarting ? "Starting camera and visual models…" : !_visualReady ? "Waiting for camera and first visual observation…" :
+            _interactionCamera == null ? "Camera unavailable" : _interactionCamera.deviceName + " · " + _interactionCamera.width + " × " +
+                _interactionCamera.height + " · " + _interactionCamera.requestedFPS + " FPS requested";
+        /// <summary>Retry permission/device/model startup after the user corrects settings or reconnects the camera.</summary>
+        public void RetryVisualCamera() { _interactionConfiguration = null; _nextInteractionSettingsRead = 0; }
+        private void VisualObservation(MNNPresenceObservation observation) { _visualReady = true; }
+        private void VisualCameraFailed(Exception error)
+        {
+            _visualReady = false; _visualCameraError = error.Message;
+            if (_interactionCamera != null) _interactionCamera.Stop();
+        }
+        /// <summary>Optional model-family adapter; invoked on a worker. Caller transfers source ownership to this session.</summary>
+        public Func<MNNInteractionSettings, CancellationToken, IMNNPresenceSource> PresenceSourceFactory { get; set; }
+        public MNNFaceGallery EnrolledFaces { get; } = new MNNFaceGallery();
+        /// <summary>Supported multimodal request adapters may explicitly consume this fresh image; never retain it across targets.</summary>
+        public bool TryGetInteractionImage(out MNNRgbImage image)
+        {
+            image = null;
+            return _interaction != null && _interaction.ReadSettings().imageContext &&
+                _interaction.VisionContext.TryGet(_interaction.Presence.Current.TrackId, Time.realtimeSinceStartupAsDouble, out image);
+        }
+        public MNNInteractionComponent Interaction => _interaction;
+        private bool InteractionAdmission => _interaction == null || _interaction.CanStartInteraction;
+
+        private void UpdateInteractionPresence()
+        {
+            if (_context == null || _stopTask != null) return;
+            if (_visualReady && _interactionCamera != null && !_interactionCamera.isPlaying)
+            { _visualReady = false; RetryVisualCamera(); }
+            if (_interactionSettings == null || Time.realtimeSinceStartupAsDouble >= _nextInteractionSettingsRead)
+            {
+                _interactionSettings = GetAcousticSettings().interaction ?? new MNNInteractionSettings();
+                _nextInteractionSettingsRead = Time.realtimeSinceStartupAsDouble + .25;
+            }
+            var settings = _interactionSettings;
+            string configuration = JsonUtility.ToJson(settings);
+            if (configuration != _interactionConfiguration)
+            {
+                _interactionConfiguration = configuration;
+                _visualReady = false; _visualCameraError = null;
+                bool needed = settings.visualPresence || settings.audioVisualSpeech || settings.referenceSpeaker || settings.separateSpeakers;
+                if (needed)
+                {
+                    _interaction = GetComponent<MNNInteractionComponent>() ?? gameObject.AddComponent<MNNInteractionComponent>();
+                    _interaction.Camera.Observation -= VisualObservation;
+                    _interaction.Camera.Failed -= VisualCameraFailed;
+                    _interaction.Camera.Observation += VisualObservation;
+                    _interaction.Camera.Failed += VisualCameraFailed;
+                    _interaction.Configure(settings);
+                }
+                else if (_interaction != null) _interaction.Configure(settings);
+                _context.Interaction = needed ? _interaction : null;
+                _presenceLifetime?.Cancel();
+                _presenceChange = ApplyPresenceSettingsAsync(settings.Snapshot(), _presenceChange, ++_presenceRevision);
+                Observe(() => _presenceChange);
+            }
+            _context.Interaction = settings.visualPresence || settings.audioVisualSpeech || settings.referenceSpeaker || settings.separateSpeakers ? _interaction : null;
+            if (_interaction == null || !settings.visualPresence) return;
+            _interaction.Presence.SetInteractionBusy(IsProcessing || IsRecordingVoice);
+            var snapshot = _interaction.Presence.Current;
+            bool entered = snapshot.CanStartInteraction && !_lastPresenceAdmission;
+            _lastPresenceAdmission = snapshot.CanStartInteraction;
+            if (entered && !IsRealtimeConversation && !IsPreparingRealtime && !IsRecordingVoice &&
+                _session?.State == MNNRealtimeSessionState.Running && SupportsRealtimeConversation)
+                SetRealtimeConversation(true);
+            if (!snapshot.KeepCurrentInteraction && !snapshot.CanStartInteraction)
+            {
+                if (IsRecordingVoice) CancelVoiceRecording();
+                if (IsRealtimeConversation) SetRealtimeConversation(false);
+            }
+        }
+
+        /// <summary>Attach any package-compatible sensor/capture provider. Scene composition only;
+        /// detection, confirmation, sleep and pickup routing stay in com.eitan.mnn components.</summary>
+        public void ConfigureInteraction(MNNInteractionComponent interaction)
+        {
+            if (_interaction != null && _interaction != interaction)
+                throw new InvalidOperationException("Configure the interaction owner before starting the session.");
+            _interaction = interaction;
+            if (_context != null) _context.Interaction = interaction;
+        }
+
+        private async Task ApplyPresenceSettingsAsync(MNNInteractionSettings settings, Task previousChange, int revision)
+        {
+            try { await previousChange; } catch (Exception) { /* Cleanup still runs after a reported failure. */ }
+            if (revision != _presenceRevision) return;
+            var previous = _presenceLifetime;
+            previous?.Cancel();
+            var lifetime = _presenceLifetime = new CancellationTokenSource();
+            _visualReady = false; _visualStarting = settings.visualPresence; _visualCameraError = null;
+            IMNNPresenceSource source = null;
+            try
+            {
+                if (_interaction != null) await _interaction.StopCameraAsync();
+                (_presenceSource as IDisposable)?.Dispose(); _presenceSource = null;
+                ReleaseVisualCamera();
+                previous?.Dispose();
+                if (!settings.visualPresence) return;
+                var camera = settings.camera ?? new MNNCameraSettings(); camera.Validate();
+                if (!Application.HasUserAuthorization(UserAuthorization.WebCam) && !await RequestCameraPermission(lifetime.Token))
+                    throw new UnauthorizedAccessException("Camera permission is required for visual presence. Allow camera access in system settings, then retry.");
+                lifetime.Token.ThrowIfCancellationRequested();
+                var devices = WebCamTexture.devices;
+                int selected = MNNCameraSettings.SelectDevice(Array.ConvertAll(devices, device => device.name),
+                    Array.ConvertAll(devices, device => device.isFrontFacing), camera.deviceName);
+                if (selected < 0) throw new InvalidOperationException(string.IsNullOrEmpty(camera.deviceName)
+                    ? "No camera is connected. Connect a camera, then retry." : "The selected camera is disconnected. Choose another camera or retry.");
+                _interaction.Camera.Configure(camera);
+                // Start capture immediately after permission; model loading must not delay camera startup.
+                _interactionCamera = new WebCamTexture(devices[selected].name, camera.RequestedWidth, camera.RequestedHeight, camera.RequestedFramesPerSecond);
+                _interactionCamera.Play();
+                string root = SiriAIModelInstallation.ModelsDirectory;
+                var factory = PresenceSourceFactory;
+                source = await Task.Run(() => factory != null ? factory(settings, lifetime.Token) :
+                    MNNFacePresenceSource.Load(Path.Combine(root, settings.detectorDirectory),
+                        settings.faceRecognition ? Path.Combine(root, settings.recognizerDirectory) : null,
+                        settings.faceRecognition ? EnrolledFaces : null), lifetime.Token);
+                lifetime.Token.ThrowIfCancellationRequested();
+                // Verify readable camera pixels in the player loop; a transient new-frame flag is not a startup handshake.
+                var frameReady = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+                var frameWait = StartCoroutine(WaitForVisualCameraFrame(_interactionCamera, camera.startupTimeoutSeconds, frameReady));
+                try
+                {
+                    using (lifetime.Token.Register(() => frameReady.TrySetCanceled())) await frameReady.Task;
+                }
+                finally { if (frameWait != null) StopCoroutine(frameWait); }
+                lifetime.Token.ThrowIfCancellationRequested();
+                _interaction.StartCamera(_interactionCamera, source);
+                _presenceSource = source; source = null;
+            }
+            catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { ReleaseVisualCamera(); }
+            catch (Exception error)
+            {
+                _visualCameraError = error.Message; ReleaseVisualCamera();
+                throw;
+            }
+            finally { (source as IDisposable)?.Dispose(); _visualStarting = false; }
+        }
+
+        private static IEnumerator WaitForVisualCameraFrame(WebCamTexture camera, float timeoutSeconds, TaskCompletionSource<bool> completion)
+        {
+            double deadline = Time.realtimeSinceStartupAsDouble + timeoutSeconds;
+            while (!completion.Task.IsCompleted)
+            {
+                // A camera may deliver its first frame while models load. Accept its readable buffer
+                // even when didUpdateThisFrame is false in this phase; tracking still requires new frames.
+                yield return null;
+                if (camera == null)
+                {
+                    completion.TrySetException(new InvalidOperationException("Camera was released before delivering a frame."));
+                    yield break;
+                }
+                if (HasReadableVisualCameraFrame(camera))
+                    completion.TrySetResult(true);
+                else if (Time.realtimeSinceStartupAsDouble >= deadline)
+                    completion.TrySetException(new TimeoutException("Camera did not deliver frames. Check device access and retry."));
+            }
+        }
+
+        private static bool HasReadableVisualCameraFrame(WebCamTexture camera)
+        {
+            if (!camera.isPlaying || camera.width <= 16 || camera.height <= 16) return false;
+            try
+            {
+                var pixels = camera.GetPixels32();
+                return pixels != null && pixels.LongLength == (long)camera.width * camera.height;
+            }
+            catch (UnityException) { return false; } // Device may be negotiating its first readable buffer.
+        }
+
+        private void ReleaseVisualCamera()
+        {
+            if (_interactionCamera == null) return;
+            _interactionCamera.Stop(); Destroy(_interactionCamera); _interactionCamera = null;
+        }
+
+        private static async Task<bool> RequestCameraPermission(CancellationToken token)
+        {
+            var completion = new TaskCompletionSource<bool>();
+            var operation = Application.RequestUserAuthorization(UserAuthorization.WebCam);
+            operation.completed += _ => completion.TrySetResult(true);
+            if (operation.isDone) completion.TrySetResult(true);
+            using (token.Register(() => completion.TrySetCanceled())) await completion.Task;
+            return Application.HasUserAuthorization(UserAuthorization.WebCam);
+        }
+
+        private async Task StopInteractionAsync()
+        {
+            ++_presenceRevision;
+            _presenceLifetime?.Cancel();
+            try { await _presenceChange; } catch (Exception) { }
+            if (_interaction != null) await _interaction.StopCameraAsync();
+            (_presenceSource as IDisposable)?.Dispose(); _presenceSource = null;
+            ReleaseVisualCamera();
+            if (_interaction != null)
+            { _interaction.Camera.Observation -= VisualObservation; _interaction.Camera.Failed -= VisualCameraFailed; }
+            _presenceLifetime?.Dispose(); _presenceLifetime = null;
+            _interactionConfiguration = null; _interactionSettings = null; _lastPresenceAdmission = false;
+            _visualReady = _visualStarting = false; _visualCameraError = null;
+        }
+    }
+}
