+using System;
+using System.Threading.Tasks;
+using System.Threading;
+using System.Collections;
+using System.IO;
+using MNN.Unity;
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChat
+    {
+        private MNNInteractionComponent _interaction;
+        private string _interactionConfiguration;
+        private MNNInteractionSettings _interactionSettings;
+        private double _nextInteractionSettingsRead;
+        private bool _lastPresenceAdmission;
+        private WebCamTexture _interactionCamera;
+        private IMNNPresenceSource _presenceSource;
+        private CancellationTokenSource _presenceLifetime;
+        private Task _presenceChange = Task.CompletedTask;
+        /// <summary>Optional model-family adapter; invoked on a worker. Caller transfers source ownership to this session.</summary>
+        public Func<MNNInteractionSettings, CancellationToken, IMNNPresenceSource> PresenceSourceFactory { get; set; }
+        public MNNFaceGallery EnrolledFaces { get; } = new MNNFaceGallery();
+        /// <summary>Supported multimodal request adapters may explicitly consume this fresh image; never retain it across targets.</summary>
+        public bool TryGetInteractionImage(out MNNRgbImage image)
+        {
+            image = null;
+            return _interaction != null && _interaction.ReadSettings().imageContext &&
+                _interaction.VisionContext.TryGet(_interaction.Presence.Current.TrackId, Time.realtimeSinceStartupAsDouble, out image);
+        }
+        public MNNInteractionComponent Interaction => _interaction;
+        private bool InteractionAdmission => _interaction == null || _interaction.CanStartInteraction;
+
+        private void UpdateInteractionPresence()
+        {
+            if (_context == null) return;
+            if (_interactionSettings == null || Time.realtimeSinceStartupAsDouble >= _nextInteractionSettingsRead)
+            {
+                _interactionSettings = GetAcousticSettings().interaction ?? new MNNInteractionSettings();
+                _nextInteractionSettingsRead = Time.realtimeSinceStartupAsDouble + .25;
+            }
+            var settings = _interactionSettings;
+            string configuration = JsonUtility.ToJson(settings);
+            if (configuration != _interactionConfiguration)
+            {
+                _interactionConfiguration = configuration;
+                bool needed = settings.visualPresence || settings.audioVisualSpeech || settings.referenceSpeaker || settings.separateSpeakers;
+                if (needed)
+                {
+                    _interaction = GetComponent<MNNInteractionComponent>() ?? gameObject.AddComponent<MNNInteractionComponent>();
+                    _interaction.Configure(settings);
+                }
+                else if (_interaction != null) _interaction.Configure(settings);
+                _context.Interaction = needed ? _interaction : null;
+                _presenceLifetime?.Cancel();
+                _presenceChange = ApplyPresenceSettingsAsync(settings.Snapshot(), _presenceChange);
+                Observe(() => _presenceChange);
+            }
+            _context.Interaction = settings.visualPresence || settings.audioVisualSpeech || settings.referenceSpeaker || settings.separateSpeakers ? _interaction : null;
+            if (_interaction == null || !settings.visualPresence) return;
+            _interaction.Presence.SetInteractionBusy(IsProcessing || IsRecordingVoice);
+            var snapshot = _interaction.Presence.Current;
+            bool entered = snapshot.CanStartInteraction && !_lastPresenceAdmission;
+            _lastPresenceAdmission = snapshot.CanStartInteraction;
+            if (entered && !IsRealtimeConversation && !IsPreparingRealtime && !IsRecordingVoice &&
+                _session?.State == MNNRealtimeSessionState.Running && SupportsRealtimeConversation)
+                SetRealtimeConversation(true);
+            if (!snapshot.KeepCurrentInteraction && !snapshot.CanStartInteraction)
+            {
+                if (IsRecordingVoice) CancelVoiceRecording();
+                if (IsRealtimeConversation) SetRealtimeConversation(false);
+            }
+        }
+
+        /// <summary>Attach any package-compatible sensor/capture provider. Scene composition only;
+        /// detection, confirmation, sleep and pickup routing stay in com.eitan.mnn components.</summary>
+        public void ConfigureInteraction(MNNInteractionComponent interaction)
+        {
+            if (_interaction != null && _interaction != interaction)
+                throw new InvalidOperationException("Configure the interaction owner before starting the session.");
+            _interaction = interaction;
+            if (_context != null) _context.Interaction = interaction;
+        }
+
+        private async Task ApplyPresenceSettingsAsync(MNNInteractionSettings settings, Task previousChange)
+        {
+            try { await previousChange; } catch (Exception) { /* Prior failure was reported by Observe. Cleanup still must run. */ }
+            var previous = _presenceLifetime;
+            previous?.Cancel();
+            _presenceLifetime = new CancellationTokenSource();
+            var lifetime = _presenceLifetime;
+            if (_interaction != null) await _interaction.StopCameraAsync();
+            (_presenceSource as IDisposable)?.Dispose(); _presenceSource = null;
+            if (_interactionCamera != null) { _interactionCamera.Stop(); Destroy(_interactionCamera); _interactionCamera = null; }
+            previous?.Dispose();
+            if (!settings.visualPresence || lifetime.IsCancellationRequested) return;
+            if (!Application.HasUserAuthorization(UserAuthorization.WebCam))
+            {
+                if (!await RequestCameraPermission(lifetime.Token)) throw new UnauthorizedAccessException("Camera permission is required for visual presence.");
+            }
+            lifetime.Token.ThrowIfCancellationRequested();
+            var factory = PresenceSourceFactory;
+            string root = SiriAIModelInstallation.ModelsDirectory;
+            var source = await Task.Run(() => factory != null ? factory(settings, lifetime.Token) :
+                MNNFacePresenceSource.Load(Path.Combine(root, settings.detectorDirectory),
+                    settings.faceRecognition ? Path.Combine(root, settings.recognizerDirectory) : null,
+                    settings.faceRecognition ? EnrolledFaces : null), lifetime.Token);
+            if (lifetime.IsCancellationRequested) { (source as IDisposable)?.Dispose(); return; }
+            try
+            {
+                _interactionCamera = new WebCamTexture(640, 480, 30);
+                _interactionCamera.Play();
+                _interaction.StartCamera(_interactionCamera, source);
+                _presenceSource = source;
+            }
+            catch { (source as IDisposable)?.Dispose(); throw; }
+        }
+
+        private static async Task<bool> RequestCameraPermission(CancellationToken token)
+        {
+            var completion = new TaskCompletionSource<bool>();
+            var operation = Application.RequestUserAuthorization(UserAuthorization.WebCam);
+            operation.completed += _ => completion.TrySetResult(true);
+            if (operation.isDone) completion.TrySetResult(true);
+            using (token.Register(() => completion.TrySetCanceled())) await completion.Task;
+            return Application.HasUserAuthorization(UserAuthorization.WebCam);
+        }
+
+        private async Task StopInteractionAsync()
+        {
+            _presenceLifetime?.Cancel();
+            try { await _presenceChange; } catch (Exception) { }
+            if (_interaction != null) await _interaction.StopCameraAsync();
+            (_presenceSource as IDisposable)?.Dispose(); _presenceSource = null;
+            if (_interactionCamera != null) { _interactionCamera.Stop(); Destroy(_interactionCamera); _interactionCamera = null; }
+            _presenceLifetime?.Dispose(); _presenceLifetime = null;
+            _interactionConfiguration = null; _interactionSettings = null; _lastPresenceAdmission = false;
+        }
+    }
+}
