+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using MNN.Unity;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private const int FaceDetectionModelStage = 20, FaceRecognitionModelStage = 21;
+        private CancellationTokenSource _visionModelCancellation;
+        private bool VisionModelPicker => IsVisionModelStage(_modelPickerStage);
+        private static bool IsVisionModelStage(int stage) => stage == FaceDetectionModelStage || stage == FaceRecognitionModelStage;
+        private static MNNImageTaskProfile VisionProfile(int stage) => stage == FaceDetectionModelStage
+            ? MNNImageTaskProfile.Scrfd500M : stage == FaceRecognitionModelStage ? MNNImageTaskProfile.MobileFaceNet
+            : throw new ArgumentOutOfRangeException(nameof(stage));
+        private static string VisionCategory(int stage) => (stage == FaceDetectionModelStage
+            ? MNNModelCatalogCategory.FaceDetection : MNNModelCatalogCategory.FaceRecognition).ToString();
+        private static string VisionModelId(int stage, string directory) => "local:vision:" + stage + ":" + directory;
+        private bool CanSelectPickerModel(SiriAIModelCatalog.Entry entry) => VisionModelPicker
+            ? CanSelectVisionModel(entry, _modelPickerStage) : SiriAIModelCatalog.CanSelect(entry, _modelPickerStage);
+        private static bool CanSelectVisionModel(SiriAIModelCatalog.Entry entry, int stage) => entry.installedDirectory != null ||
+            MNNImageTaskConfig.TryGetProfile(entry.remote, out var profile) && profile == VisionProfile(stage);
+
+        private List<SiriAIModelCatalog.Entry> CompatibleVisionModels(int stage)
+        {
+            var result = _settingsDraft.Catalog.Entries.Where(entry => entry.installedDirectory == null && entry.remote != null &&
+                (entry.remote.category == VisionCategory(stage) ||
+                MNNImageTaskConfig.TryGetProfile(entry.remote, out var profile) && profile == VisionProfile(stage))).ToList();
+            var directories = new HashSet<string>(StringComparer.Ordinal);
+            string root = _acousticModelsDirectory();
+            try
+            {
+                if (Directory.Exists(root)) foreach (string directory in Directory.GetDirectories(root)) directories.Add(Path.GetFullPath(directory));
+                var settings = _settingsDraft.Acoustics.interaction;
+                directories.Add(SiriAIAcousticModelResources.ResolvePath(root, stage == FaceDetectionModelStage ? settings.detectorDirectory : settings.recognizerDirectory));
+            }
+            catch (Exception error) when (VisionFileError(error)) { }
+            foreach (string directory in directories)
+            {
+                try
+                {
+                    var config = MNNImageTaskConfig.Read(directory);
+                    if (config.profile != VisionProfile(stage)) continue;
+                    string graph = config.Resolve(directory, false); // Presence hint only; selection verifies SHA on a worker.
+                    result.Add(new SiriAIModelCatalog.Entry { modelId = VisionModelId(stage, directory),
+                        repository = Path.GetFileName(directory), installedDirectory = directory, bytes = new FileInfo(graph).Length,
+                        remote = new MNNRemoteModel { name = Path.GetFileName(directory), category = VisionCategory(stage) } });
+                }
+                catch (Exception error) when (VisionFileError(error)) { }
+            }
+            return result;
+        }
+        private static bool VisionFileError(Exception error) => error is IOException || error is ArgumentException ||
+            error is UnauthorizedAccessException || error is NotSupportedException || error is System.Security.SecurityException;
+
+        private void BuildVisionModelSelection(string title, string detail, int stage, Func<string> read, Action<string> write)
+        {
+            string current = string.IsNullOrWhiteSpace(read()) ? "Search for a model" : read();
+            BuildModelSelection(title, detail, current, title, stage, () =>
+            {
+                try { return VisionModelId(stage, SiriAIAcousticModelResources.ResolvePath(_acousticModelsDirectory(), read())); }
+                catch (Exception error) when (VisionFileError(error)) { return null; }
+            }, selected => _ = SelectVisionModelAsync(stage, selected, write));
+        }
+
+        private Func<string, MNNRemoteModel, CancellationToken, Task<string>> _installVisionModel = (root, model, token) =>
+            MNNModelInstallation.EnsureAsync(MNNModelInstallation.DirectoryFor(root, model,
+                MNNConversationModelCatalog.DefaultInstallationName(model)), model, token: token);
+
+        private async Task SelectVisionModelAsync(int stage, SiriAIModelCatalog.Entry selected, Action<string> write)
+        {
+            if (_visionModelCancellation != null) return;
+            var cancellation = _visionModelCancellation = new CancellationTokenSource();
+            int generation = _settingsGeneration;
+            try
+            {
+                if (!CanSelectVisionModel(selected, stage)) throw new NotSupportedException("No compatible visual model adapter.");
+                string root = Path.GetFullPath(_acousticModelsDirectory());
+                string directory = selected.installedDirectory;
+                if (directory == null)
+                {
+                    if (_editorPreview) return; // A preview must never download or pretend installation succeeded.
+                    SetSettingsNotice("Downloading visual model…");
+                    SetSettingsBusy(true, allowClose: true);
+                    directory = await _installVisionModel(root, selected.remote, cancellation.Token);
+                }
+                cancellation.Token.ThrowIfCancellationRequested();
+                if (!_editorPreview)
+                    await Task.Run(() =>
+                    {
+                        var config = MNNImageTaskConfig.Read(directory);
+                        if (config.profile != VisionProfile(stage)) throw new InvalidDataException("The selected model has an incompatible visual profile.");
+                        config.Resolve(directory, true);
+                        cancellation.Token.ThrowIfCancellationRequested();
+                    }, cancellation.Token);
+                cancellation.Token.ThrowIfCancellationRequested();
+                if (this == null || generation != _settingsGeneration || !IsSettingsOpen) return;
+                write(string.Equals(Path.GetDirectoryName(directory), root, StringComparison.Ordinal) ? Path.GetFileName(directory) : directory);
+                ShowSettingsTab(_settingsTab, false);
+            }
+            catch (OperationCanceledException) { }
+            catch (Exception error)
+            {
+                if (this != null && generation == _settingsGeneration && IsSettingsOpen) SetSettingsNotice(error.Message, true);
+            }
+            finally
+            {
+                if (_visionModelCancellation == cancellation) _visionModelCancellation = null;
+                cancellation.Dispose();
+                if (this != null && generation == _settingsGeneration && IsSettingsOpen) SetSettingsBusy(false);
+            }
+        }
+    }
+}
