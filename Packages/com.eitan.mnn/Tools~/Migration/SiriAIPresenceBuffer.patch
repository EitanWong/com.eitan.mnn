+        private float StabilizePresenceTarget(float target, ref float dt)
+        {
+            if (target <= 0 || target == _presenceAcceptedTarget)
+            {
+                _presencePendingSeconds = 0;
+                return _presenceAcceptedTarget = _presencePendingTarget = target;
+            }
+            if (target != _presencePendingTarget)
