     public sealed class SiriAILowPowerTests
     {
+        [Test]
+        public void PresenceFlickerWaitsForStableArrivalAndDepartureBeforeFading()
+        {
+            var root = new GameObject("Buffered presence view");
+            var content = new GameObject("UI");
+            var ball = new GameObject("Orb");
+            try
+            {
+                var view = root.AddComponent<SiriAIChatView>();
+                var orb = ball.AddComponent<SiriAIRenderer>(); orb.Refresh();
+                SiriAITestAccess.Set(view, "_canvasRoot", content);
+                SiriAITestAccess.Set(view, "siriOrb", ball.GetComponent<Renderer>());
+                var advance = typeof(SiriAIChatView).GetMethod("AdvancePresencePresentation", BindingFlags.Instance | BindingFlags.NonPublic);
+                Action<float, float> frame = (target, dt) => advance.Invoke(view, new object[] { target, dt });
+                Func<float> alpha = () => content.GetComponent<CanvasGroup>().alpha;
+                frame(1, .1f);
+                for (int i = 0; i < 6; ++i)
+                {
+                    frame(.25f, .2f); Assert.AreEqual(1, alpha(), .001f, "Brief face loss must not start fading.");
+                    frame(1, .1f);
+                }
+                frame(.25f, .6f); Assert.AreEqual(1, alpha(), .001f, "Departure needs a continuous buffer, not accumulated glitches.");
+                frame(.25f, .1f); Assert.Less(alpha(), 1); Assert.Greater(alpha(), .25f);
+                frame(.25f, .3f); Assert.AreEqual(.25f, alpha(), .001f);
+                for (int i = 0; i < 6; ++i)
+                {
+                    frame(1, .2f); Assert.AreEqual(.25f, alpha(), .001f, "Brief face re-entry must not brighten the view.");
+                    frame(.25f, .1f);
+                }
+                frame(1, .35f); Assert.AreEqual(.25f, alpha(), .001f);
+                frame(1, .1f); Assert.Greater(alpha(), .25f); Assert.Less(alpha(), 1);
+                frame(1, .3f); Assert.AreEqual(1, alpha(), .001f);
+                frame(.25f, .5f); frame(0, .4f); Assert.Zero(alpha(), "Real sleep must not wait for a second absence buffer.");
+                frame(1, .2f); Assert.Zero(alpha(), "Wake arrival is buffered too.");
+                frame(1, .5f); Assert.AreEqual(1, alpha(), .001f);
+                Assert.AreEqual(alpha(), ball.GetComponent<Renderer>().sharedMaterial.GetFloat("_PresenceVisibility"), .001f);
+                TestContext.WriteLine("Six departure/arrival glitches ignored; departure .6s unchanged then gradual fade to.25; arrival .35s unchanged then gradual fade to1; actual sleep hides; buffered wake restores UI/orb together.");
+            }
+            finally { Object.DestroyImmediate(root); Object.DestroyImmediate(content); Object.DestroyImmediate(ball); }
+        }
