+++ b/Assets/Samples/SiriAI/Scripts/Tests/Editor/Backends/SiriAIPocketDefaultsTests.cs
@@ -0,0 +1,55 @@
+using System.Linq;
+using System.Threading;
+using NUnit.Framework;
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIPocketDefaultsTests
+    {
+        [Test]
+        public void NewConfigurationSelectsPocketAndItsDownloadableExport()
+        {
+            var configuration = new SiriAIBackendConfiguration();
+            Assert.AreEqual("MNN/MNN-Pocket-0.3B", configuration.model.model);
+            var entry = new SiriAIModelCatalog().ForStage(0).Single(item => item.modelId == configuration.model.model);
+            Assert.False(entry.catalogOnly);
+            Assert.AreEqual("MNN/MNN-Pocket-0.3B-MNN", entry.repository);
+        }
+
+        [Test]
+        public void SourceWeightsCannotBecomeASelectedLanguageProvider()
+        {
+            var catalog = new SiriAIModelCatalog();
+            var source = catalog.ForStage(0).Single(entry => entry.repository == "MNN/MNN-Pocket-0.3B");
+            var configuration = new SiriAIBackendConfiguration();
+            configuration.model.model = configuration.model.localManifestId = source.modelId;
+            Assert.Throws<System.ArgumentException>(() => SiriAISettingsConstraints.Validate(configuration, catalog));
+            SiriAISettingsConstraints.Normalize(configuration, catalog);
+            Assert.AreEqual("MNN/MNN-Pocket-0.3B", configuration.model.model);
+        }
+
+        [Test]
+        public void DeviceDefaultsKeepPocketAndExplicitModelSelections()
+        {
+            var owner = new GameObject("Pocket defaults");
+            try
+            {
+                var backend = owner.AddComponent<SiriAIConfigurableBackend>();
+                var serialized = new UnityEditor.SerializedObject(backend);
+                serialized.FindProperty("loadSavedSettings").boolValue = false;
+                serialized.FindProperty("profile").stringValue = "pocket-defaults-" + System.Guid.NewGuid().ToString("N");
+                serialized.ApplyModifiedPropertiesWithoutUndo();
+                foreach (string model in new[] { "MNN/MNN-Pocket-0.3B", "my-explicit-model" })
+                {
+                    var configuration = new SiriAIBackendConfiguration();
+                    configuration.model.model = configuration.model.localManifestId = model;
+                    backend.ApplyConfiguration(configuration);
+                    backend.ApplyDeviceDefaultsAsync(CancellationToken.None).GetAwaiter().GetResult();
+                    Assert.AreEqual(model, backend.GetConfiguration().model.model);
+                }
+            }
+            finally { Object.DestroyImmediate(owner); }
+        }
+    }
+}
