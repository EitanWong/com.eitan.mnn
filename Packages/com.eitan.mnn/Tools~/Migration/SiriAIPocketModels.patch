diff --git a/Assets/Samples/SiriAI/Scripts/Tests/Editor/Backends/SiriAIPocketDefaultsTests.cs b/Assets/Samples/SiriAI/Scripts/Tests/Editor/Backends/SiriAIPocketDefaultsTests.cs
