+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using MNN.Unity;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIMiniMindONativeVoiceTests
+    {
+        [UnityTest, Explicit("Requires the existing MiniMind-o deployment; feeds generated speech PCM through SiriAI capture and renders model PCM. No download.")]
+        public IEnumerator CapturedSpeechAndSecondAudioTurnRenderTheModelsOwnVoice()
+        {
+            string directory = Path.Combine(Application.streamingAssetsPath, "MNN/Models", MNNMiniMindO.InstallationName);
+            Assert.True(MNNMiniMindO.IsComplete(directory));
+            float[] speech;
+            using (var seed = MNNMiniMindO.Load(directory))
+            {
+                var spoken = seed.Generate("请说：你好。", 128);
+                Assert.Greater(spoken.Waveform.Length, 2400);
+                speech = MNNAudioResampling.Resample(spoken.Waveform.Select(x => Math.Max(-1, Math.Min(1, x))).ToArray(), 24000, 16000);
+            }
+            var root = new GameObject("MiniMind-o SiriAI voice acceptance"); root.SetActive(false);
+            var backend = SiriAITestAccess.CreateBackend(root); backend.UseMiniMindOVoice();
+            var capture = new Capture();
+            var output = new MNNRealtimeOutputPipeline(new MNNPcmFormat(24000, 1), 240, blockCapacity: 1024);
+            var device = new MNNRealtimeCapabilities(MNNRealtimeFeature.DuplexDevice | MNNRealtimeFeature.PresentationClock |
+                MNNRealtimeFeature.HalfDuplexDevice, "Generated PCM test device", "Generated speech through SiriAI capture interface; software rendering", execution: MNNRealtimeExecution.Managed);
+            MNNRealtimeSession session = null;
+            var context = new SiriAIChatContext(capture, () => session, device);
+            var registration = backend.CreateRegistration(context);
+            var report = MNNRealtimeRouteSelector.SelectBest(registration.Model, registration.Device, registration.Tts,
+                registration.Asr, registration.Vad, registration.ExcludedRoutes, registration.RequireMeasuredSpeech,
+                registration.AllowBufferedSpeech).RequireSelected();
+            Assert.True(report.CanStart, report.ToString());
+            Assert.AreEqual(MNNRealtimeRoute.EndToEndSpeech, report.Route);
+            Assert.IsNull(registration.Tts); Assert.IsNull(registration.Asr);
+            var creating = registration.Factory.CreateAsync(report, output, CancellationToken.None);
+            while (!creating.IsCompleted) yield return null;
+            var runtime = creating.GetAwaiter().GetResult();
+            session = new MNNRealtimeSession(runtime, output);
+            var rendered = new List<float>();
+            long presented = 0;
+            var pcm = new float[2400];
+            Action render = () =>
+            {
+                while (context.TryReadTranscript(out var notice)) TestContext.WriteLine("TRANSCRIPT=" + notice.Text);
+                string warning = context.ReadInputWarning();
+                if (warning != null) TestContext.WriteLine("INPUT_WARNING=" + warning);
+                output.Render(pcm, 0, pcm.Length);
+                if (pcm.Any(x => Math.Abs(x) > 1e-6f)) rendered.AddRange(pcm);
+                presented += pcm.Length; output.DrainReceipts(4096); output.AcknowledgePresentation(presented, false);
+            };
+            try
+            {
+                var start = session.StartAsync();
+                while (!start.IsCompleted) yield return null;
+                start.GetAwaiter().GetResult();
+                CollectionAssert.AreEquivalent(new[] { "model", "vad", "turn" }, backend.RuntimeModels.Select(entry => entry.Stage));
+                foreach (var entry in backend.RuntimeModels)
+                    TestContext.WriteLine("PREPARED=" + entry.Stage + " | " + entry.Model + " | " + entry.State + " | " + entry.Backend);
+                context.Input.SetRealtime(true);
+                // Same bounded PCM port consumed by the real microphone adapter and the energy VAD/turn loop.
+                var input = speech.Concat(new float[16000]).ToArray();
+                int sent = 0;
+                double nextCapture = UnityEditor.EditorApplication.timeSinceStartup;
+                double deadline = UnityEditor.EditorApplication.timeSinceStartup + 60;
+                while ((sent < input.Length || rendered.Count == 0 || output.QueuedFrames > 0) && UnityEditor.EditorApplication.timeSinceStartup < deadline)
+                {
+                    if (sent < input.Length && UnityEditor.EditorApplication.timeSinceStartup >= nextCapture)
+                    { capture.Push(input, sent); sent += 512; nextCapture += .032; }
+                    render();
+                    if (session.Fault != null) throw session.Fault;
+                    yield return null;
+                }
+                TestContext.WriteLine("INPUT_DIAGNOSTICS=" + ((MNNConversationRuntime)runtime).InputDiagnostics);
+                Assert.Greater(rendered.Count, 2400, "Captured speech must produce rendered reply PCM without ASR/TTS.");
+                // Join the first response and drain its presentation before a second recorded input.
+                var join = session.InterruptAsync();
+                while (!join.IsCompleted) { render(); yield return null; }
+                join.GetAwaiter().GetResult();
+                int before = rendered.Count;
+                var second = registration.SubmitAudioAsync(speech, CancellationToken.None);
+                deadline = UnityEditor.EditorApplication.timeSinceStartup + 60;
+                while ((!second.IsCompleted || output.QueuedFrames > 0) && UnityEditor.EditorApplication.timeSinceStartup < deadline)
+                { render(); yield return null; }
+                Assert.True(second.IsCompleted); second.GetAwaiter().GetResult();
+                Assert.Greater(rendered.Count, before + 2400, "Historical raw audio must not break the next voice turn.");
+                Assert.IsNull(session.Fault);
+                string artifacts = Environment.GetEnvironmentVariable("SIRIAI_MINIMINDO_ARTIFACTS") ?? Path.GetFullPath("TestArtifacts~/MiniMindOSiriAI");
+                Directory.CreateDirectory(artifacts);
+                File.WriteAllBytes(Path.Combine(artifacts, "siriai-minimind-o-voice.wav"), MNNWaveAudio.EncodePcm16(rendered.Select(x => Math.Max(-1, Math.Min(1, x))).ToArray(), 24000));
+                TestContext.WriteLine("ROUTE=" + report.Route + "\nCAPTURED_SPEECH_SAMPLES=" + speech.Length +
+                    "\nFIRST_RENDERED_SAMPLES=" + before + "\nSECOND_RENDERED_SAMPLES=" + (rendered.Count - before) + "\nASR=none\nTTS=none");
+            }
+            finally
+            {
+                session.StopAsync().GetAwaiter().GetResult();
+                registration.ReleaseAsync?.Invoke().GetAwaiter().GetResult();
+                UnityEngine.Object.DestroyImmediate(root);
+            }
+        }
+        private sealed class Capture : IMNNAudioCaptureSource
+        {
+            private readonly MNNAudioCaptureBuffer _queue = new MNNAudioCaptureBuffer(128, 512);
+            private long _sequence;
+            public MNNPcmFormat CaptureFormat => new MNNPcmFormat(16000, 1);
+            public int MaximumCaptureSamples => 512;
+            public long DroppedCaptureBlocks => _queue.DroppedBlocks;
+            public bool HasPendingCaptureFrames => _queue.HasPendingFrames;
+            internal void Push(float[] source, int offset)
+            {
+                var block = new float[512]; Array.Copy(source, offset, block, 0, Math.Min(512, source.Length - offset));
+                var info = new MNNAudioFrameInfo(1, 1, _sequence, _sequence * 512,
+                    System.Diagnostics.Stopwatch.GetTimestamp(), CaptureFormat); ++_sequence;
+                Assert.True(_queue.TryWrite(block, 0, block.Length, info));
+            }
+            public bool TryReadCapture(float[] target, int offset, out MNNAudioFrameInfo info, out int count) =>
+                _queue.TryRead(target, offset, out info, out count);
+        }
+    }
+}
