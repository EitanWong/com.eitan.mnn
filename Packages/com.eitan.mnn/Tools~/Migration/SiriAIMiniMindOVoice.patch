+using MNN.Unity;
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIConfigurableBackend
+    {
+        /// <summary>Select direct audio input and MiniMind-o's own voice without a separate ASR or TTS model.</summary>
+        [ContextMenu("Use MiniMind-o voice")]
+        public void UseMiniMindOVoice()
+        {
+            profile = "minimind-o";
+            promptDocument = null;
+            ApplyConfiguration(CreateMiniMindOVoiceConfiguration());
+        }
+
+        internal static SiriAIBackendConfiguration CreateMiniMindOVoiceConfiguration()
+        {
+            var entry = new SiriAIModelCatalog().SearchModels("MiniMind-o", 0).Find(model => model.repository == MNNMiniMindO.Repository);
+            return new SiriAIBackendConfiguration
+            {
+                mode = SiriAIConversationMode.RealtimeSpeech, automaticLocalModels = false,
+                speechOutput = true, textOnly = false, allowFallback = false,
+                filterVoiceInput = false, endRealtimeOnExitIntent = false,
+                useVoiceActivityModel = true, useTurnDetectionModel = true,
+                requireMeasuredRealtime = false, allowBufferedSpeech = true,
+                threads = 4, maximumReplyTokens = 128, maximumUtteranceSeconds = 20, maximumHistoryMessages = 8,
+                instructions = "你是语音助手，请使用中文简短回答。",
+                model = new SiriAIEndpointConfiguration
+                {
+                    location = SiriAIProviderLocation.LocalMnn, backend = MNNBackendType.CPU,
+                    model = entry.modelId, localManifestId = entry.modelId, localModel = entry.remote,
+                    acceptsAudioInput = true
+                }
+            };
+        }
+    }
+}
