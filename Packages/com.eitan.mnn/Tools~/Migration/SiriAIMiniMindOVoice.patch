+using System;
+using System.Linq;
+using MNN.Unity;
+using NUnit.Framework;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIMiniMindOVoiceTests
+    {
+        private static SiriAIModelAdapter Kind => (SiriAIModelAdapter)MNNConversationModelAdapter.MiniMindO;
+        [Test]
+        public void DedicatedAdapterIsNamedAndSelectableForTheModelStage()
+        {
+            Assert.True(Enum.IsDefined(typeof(SiriAIModelAdapter), Kind));
+            var entry = new SiriAIModelCatalog().SearchModels("MiniMind-o", 0).Single();
+            Assert.True(SiriAIModelCatalog.CanSelect(entry, 0));
+            Assert.True(SiriAIModelCatalog.SupportsStage(Kind, 0));
+        }
+        [TestCase(SiriAIConversationMode.Automatic)]
+        [TestCase(SiriAIConversationMode.RealtimeSpeech)]
+        public void VoiceModesRetainMiniMindInsteadOfReplacingIt(SiriAIConversationMode mode)
+        {
+            Assert.True(SiriAISettingsConstraints.SupportsModel(Kind, mode));
+        }
+        [Test]
+        public void AutomaticUsesTheModelsOwnSpeech()
+        {
+            var c = new SiriAIBackendConfiguration { mode = SiriAIConversationMode.Automatic };
+            var e = new SiriAIModelCatalog().SearchModels("MiniMind-o", 0).Single();
+            c.model.model = e.modelId; c.model.localManifestId = e.modelId;
+            Assert.True(SiriAISettingsConstraints.UsesModelSpeech(c, new SiriAIModelCatalog()));
+        }
+        [Test]
+        public void BufferedDirectSpeechRoutePassesQualification()
+        {
+            var model = MNNConversationLocalProviders.DescribeCapabilities(MNNConversationModelAdapter.MiniMindO);
+            var device = new MNNRealtimeCapabilities(MNNRealtimeFeature.DuplexDevice | MNNRealtimeFeature.PresentationClock |
+                MNNRealtimeFeature.HalfDuplexDevice, "Test PCM ports", "Deterministic buffered device", execution: MNNRealtimeExecution.Managed);
+            var vad = SiriAIStageRegistration.Energy.Capabilities;
+            var report = MNNRealtimePreflight.Check(MNNRealtimeRoute.EndToEndSpeech, model, device, vad: vad,
+                requireMeasuredSpeech: false, allowBufferedSpeech: true);
+            Assert.True(report.CanStart, report.ToString());
+        }
+        [Test]
+        public void VoicePresetRetainsVadAndTurnModelsWithoutSeparateAsrOrTts()
+        {
+            var c = SiriAIConfigurableBackend.CreateMiniMindOVoiceConfiguration();
+            var catalog = new SiriAIModelCatalog();
+            SiriAISettingsConstraints.Normalize(c, catalog);
+            SiriAISettingsConstraints.Validate(c, catalog);
+            Assert.AreEqual(MNNMiniMindO.Repository, c.model.localModel.repositoryId);
+            Assert.True(c.useVoiceActivityModel);
+            Assert.True(c.useTurnDetectionModel);
+            Assert.False(c.automaticLocalModels);
+            Assert.False(c.textOnly);
+            Assert.True(c.speechOutput);
+            Assert.False(c.filterVoiceInput);
+            Assert.False(c.endRealtimeOnExitIntent);
+            Assert.False(SiriAISettingsConstraints.UsesSynthesis(c));
+            CollectionAssert.AreEqual(new[] { "model", "vad", "turn" }, SiriAIStagePlan.ForRoute(c, MNNRealtimeRoute.EndToEndSpeech).Endpoints(c).Select(pair => pair.Key));
+        }
+    }
+}
