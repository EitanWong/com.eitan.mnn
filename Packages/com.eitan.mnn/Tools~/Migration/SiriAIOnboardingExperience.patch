+                    var card = SiriAITestAccess.Field<RectTransform>(view, "_setupCard");
+                    var available = SiriAITestAccess.Field<Rect>(view, "_availableViewport");
+                    Assert.LessOrEqual(card.rect.width, available.width); Assert.LessOrEqual(card.rect.height, available.height);
+                    Assert.GreaterOrEqual(SiriAITestAccess.Field<Button>(view, "_setupNext").GetComponent<RectTransform>().rect.height, 44);
+                    string directory = Environment.GetEnvironmentVariable("SIRIAI_SETUP_EXPERIENCE_ARTIFACTS");
+                    if (!string.IsNullOrEmpty(directory))
+                    {
+                        Directory.CreateDirectory(directory);
+                        File.WriteAllBytes(Path.Combine(directory, stage + "-" + (dark ? "dark" : "light") + "-" + width + ".png"), pixels.EncodeToPNG());
+                    }
+                }
+            }
+            finally
+            {
+                RenderTexture.active = previous; Object.DestroyImmediate(owner); Object.DestroyImmediate(cameraOwner);
+                Object.DestroyImmediate(target); Object.DestroyImmediate(pixels);
+            }
+        }
