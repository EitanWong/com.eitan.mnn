+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private const float SetupWindowInset = 24f;
+        private static readonly Color SetupTint = new Color(.48f, .65f, 1f, 1f);
+        private RectTransform _setupHero, _setupStageRail, _setupStageProgress, _setupTransferFill;
+        private SiriAIActionIcon _setupHeroIcon;
+        private SiriAIRoundedRect _setupStageFill;
+        private readonly SiriAIActionIcon[] _setupStageIcons = new SiriAIActionIcon[4];
+        private readonly Text[] _setupStageNames = new Text[4];
+        private CanvasGroup _setupContentReveal;
+        private Text _setupProgressLabel;
+        private float _setupReveal = 1f, _setupStageAmount, _setupTransferAmount;
+        private float _setupTransferTarget = -1f;
+        private static readonly string[] SetupStageNames = { "Welcome", "Permissions", "Models", "Ready" };
+        private static readonly SiriAIActionGlyph[] SetupStageGlyphs = {
+            SiriAIActionGlyph.Orb, SiriAIActionGlyph.Keyboard, SiriAIActionGlyph.Models, SiriAIActionGlyph.Check };
+
+        private int SetupStageIndex => _setupFlow.Step == SiriAISetupStep.Welcome ? 0 :
+            _setupFlow.Step == SiriAISetupStep.Ready ? 3 : _setupFlow.Step == SiriAISetupStep.Preparation ? 2 : 1;
+
+        private void StyleSetupPrimary(Button button)
+        {
+            if (_primaryGlassMaterial != null) button.targetGraphic.material = _primaryGlassMaterial;
+            SetAppearanceColor(button.targetGraphic, new Color(.25f, .43f, .92f, .94f));
+            SetAppearanceColor(button.GetComponentInChildren<Text>(), Ink);
+        }
+
+        private void BuildSetupVisuals()
+        {
+            _setupHero = RectObject("Setup Hero", _setupCard);
+            var halo = _setupHero.gameObject.AddComponent<SiriAIRoundedRect>();
+            halo.Radius = 20; halo.raycastTarget = false;
+            SetAppearanceColor(halo, new Color(SetupTint.r, SetupTint.g, SetupTint.b, .16f));
+            var symbol = RectObject("Setup Hero Icon", _setupHero); Stretch(symbol);
+            symbol.offsetMin = Vector2.one * 13; symbol.offsetMax = -Vector2.one * 13;
+            _setupHeroIcon = symbol.gameObject.AddComponent<SiriAIActionIcon>();
+            _setupHeroIcon.raycastTarget = false; SetAppearanceColor(_setupHeroIcon, SetupTint);
+            _setupStageRail = RectObject("Setup Stages", _setupCard);
+            for (int i = 0; i < 4; ++i)
+            {
+                var cell = RectObject("Stage " + i, _setupStageRail);
+                cell.anchorMin = new Vector2(i / 4f, 0); cell.anchorMax = new Vector2((i + 1) / 4f, 1);
+                cell.offsetMin = cell.offsetMax = Vector2.zero;
+                var icon = RectObject("Stage Icon", cell);
+                Place(icon, new Rect(0, 5, 20, 20));
+                _setupStageIcons[i] = icon.gameObject.AddComponent<SiriAIActionIcon>();
+                _setupStageIcons[i].raycastTarget = false;
+                _setupStageNames[i] = Label(cell, SetupStageNames[i], 13, Muted);
+                _setupStageNames[i].alignment = TextAnchor.MiddleLeft;
+                var label = _setupStageNames[i].rectTransform;
+                Stretch(label); label.offsetMin = new Vector2(27, 0); label.offsetMax = new Vector2(-4, 0);
+            }
+            _setupStageProgress = RectObject("Setup Stage Progress", _setupCard);
+            var track = _setupStageProgress.gameObject.AddComponent<SiriAIRoundedRect>();
+            track.Radius = 2; track.raycastTarget = false;
+            SetAppearanceColor(track, new Color(.6f, .7f, .9f, .14f));
+            var fill = RectObject("Completed stages", _setupStageProgress); Stretch(fill);
+            _setupStageFill = fill.gameObject.AddComponent<SiriAIRoundedRect>();
+            _setupStageFill.Radius = 2; _setupStageFill.raycastTarget = false;
+            SetAppearanceColor(_setupStageFill, SetupTint);
+        }
+
+        private void LayoutSetupVisuals(float width, float height)
+        {
+            Place(_setupHero, new Rect(SetupWindowInset, height - 84, 56, 56));
+            Place(_setupStageRail, new Rect(SetupWindowInset, height - 126, width - SetupWindowInset * 2, 30));
+            Place(_setupStageProgress, new Rect(SetupWindowInset, height - 139, width - SetupWindowInset * 2, 3));
+            bool showNames = width >= 420;
+            for (int i = 0; i < _setupStageNames.Length; ++i)
+            {
+                _setupStageNames[i].gameObject.SetActive(showNames);
+                var icon = _setupStageIcons[i].rectTransform;
+                if (showNames) Place(icon, new Rect(0, 5, 20, 20));
+                else
+                {
+                    icon.anchorMin = icon.anchorMax = icon.pivot = new Vector2(.5f, .5f);
+                    icon.anchoredPosition = Vector2.zero; icon.sizeDelta = Vector2.one * 20;
+                }
+            }
+        }
+
+        private void BeginSetupStepReveal()
+        {
+            _setupEntryChecked = false;
+            _setupReveal = SettingsMotion ? .2f : 1f;
+            if (_setupContentReveal == null) _setupContentReveal = _setupContent.gameObject.AddComponent<CanvasGroup>();
+            _setupContentReveal.alpha = _setupReveal;
+            _setupHeroIcon.Glyph = SetupStageGlyphs[SetupStageIndex];
+            for (int i = 0; i < 4; ++i)
+            {
+                _setupStageIcons[i].Glyph = i < SetupStageIndex ? SiriAIActionGlyph.Check : SetupStageGlyphs[i];
+                SetAppearanceColor(_setupStageIcons[i], i <= SetupStageIndex ? SetupTint : Muted);
+                SetAppearanceColor(_setupStageNames[i], i == SetupStageIndex ? Ink : Muted);
+                _setupStageNames[i].fontStyle = FontStyle.Normal;
+            }
+            TickSetupVisuals(0);
+        }
+
+        private void TickSetupVisuals(float deltaTime)
+        {
+            if (_setupFlow == null || _setupHero == null) return;
+            bool motion = SettingsMotion && SiriAIGraphicsQuality.Current.UiAnimations;
+            float blend = motion ? 1f - Mathf.Exp(-14f * Mathf.Max(0, deltaTime)) : 1f;
+            _setupReveal = Mathf.Lerp(_setupReveal, 1f, blend);
+            if (_setupContentReveal != null) _setupContentReveal.alpha = _setupReveal;
+            _setupStageAmount = Mathf.Lerp(_setupStageAmount, (SetupStageIndex + 1) / 4f, blend);
+            _setupStageFill.rectTransform.anchorMax = new Vector2(_setupStageAmount, 1);
+            bool busy = _setupPreparing || _setupRequestBusy;
+            float pulse = motion && busy ? Mathf.Sin(Time.unscaledTime * 2.4f) : 0;
+            _setupHero.localScale = Vector3.one * (1f + pulse * .035f);
+            _setupHeroIcon.Glyph = !string.IsNullOrEmpty(_setupFailure) ? SiriAIActionGlyph.Alert :
+                busy ? SiriAIActionGlyph.Reload : SetupStageGlyphs[SetupStageIndex];
+            _setupHeroIcon.rectTransform.localRotation = busy && motion ?
+                Quaternion.Euler(0, 0, -Time.unscaledTime * 90f) : Quaternion.identity;
+            if (_setupTransferFill == null) return;
+            if (_setupTransferTarget < 0)
+            {
+                float start = motion && busy ? Mathf.PingPong(Time.unscaledTime * .4f, .72f) : .36f;
+                _setupTransferFill.anchorMin = new Vector2(start, 0);
+                _setupTransferFill.anchorMax = new Vector2(start + .28f, 1);
+            }
+            else
+            {
+                _setupTransferAmount = Mathf.Lerp(_setupTransferAmount, _setupTransferTarget, blend);
+                _setupTransferFill.anchorMin = Vector2.zero;
+                _setupTransferFill.anchorMax = new Vector2(_setupTransferAmount, 1);
+            }
+        }
+
+        private void BuildSetupTransferProgress()
+        {
+            _setupProgressLabel = SetupDescription("Ready to prepare", 16);
+            var track = RectObject("Setup Transfer Progress", _setupContent);
+            FixedHeight(track.gameObject, 6);
+            var background = track.gameObject.AddComponent<SiriAIRoundedRect>();
+            background.Radius = 3; background.raycastTarget = false;
+            SetAppearanceColor(background, new Color(.6f, .7f, .9f, .16f));
+            _setupTransferFill = RectObject("Transfer Fill", track); Stretch(_setupTransferFill);
+            var fill = _setupTransferFill.gameObject.AddComponent<SiriAIRoundedRect>();
+            fill.Radius = 3; fill.raycastTarget = false; SetAppearanceColor(fill, SetupTint);
+            _setupTransferAmount = 0; _setupTransferTarget = 0;
+        }
+
+        private void SetupModeAction(string title, string detail, SiriAIActionGlyph glyph, int value, int selected)
+        {
+            var button = SetupAction(title, () => SelectSetupMode(value));
+            FixedHeight(button.gameObject, 76);
+            var heading = button.GetComponentInChildren<Text>();
+            heading.alignment = TextAnchor.MiddleLeft;
+            Stretch(heading.rectTransform);
+            heading.rectTransform.offsetMin = new Vector2(56, 44);
+            heading.rectTransform.offsetMax = new Vector2(-52, -10);
+            heading.fontStyle = FontStyle.Normal;
+            var hint = Label(button.transform, detail, 13, Muted);
+            hint.alignment = TextAnchor.MiddleLeft; hint.horizontalOverflow = HorizontalWrapMode.Wrap;
+            Stretch(hint.rectTransform);
+            hint.rectTransform.offsetMin = new Vector2(56, 10); hint.rectTransform.offsetMax = new Vector2(-52, -36);
+            hint.resizeTextForBestFit = true; hint.resizeTextMinSize = 11; hint.resizeTextMaxSize = 13;
+            var icon = RectObject("Mode Icon", button.transform);
+            Place(icon, new Rect(16, 26, 24, 24));
+            var graphic = icon.gameObject.AddComponent<SiriAIActionIcon>(); graphic.Glyph = glyph;
+            graphic.raycastTarget = false; SetAppearanceColor(graphic, value == selected ? SetupTint : Muted);
+            if (value != selected) return;
+            var check = RectObject("Selected mode", button.transform);
+            check.anchorMin = check.anchorMax = new Vector2(1, .5f); check.pivot = new Vector2(.5f, .5f);
+            check.anchoredPosition = new Vector2(-26, 0); check.sizeDelta = Vector2.one * 20;
+            var mark = check.gameObject.AddComponent<SiriAIActionIcon>(); mark.Glyph = SiriAIActionGlyph.Check;
+            mark.raycastTarget = false; SetAppearanceColor(mark, SetupTint);
+        }
+
+        private void ResetSetupVisuals()
+        {
+            _setupHero = _setupStageRail = _setupStageProgress = _setupTransferFill = null;
+            _setupHeroIcon = null; _setupStageFill = null; _setupContentReveal = null; _setupProgressLabel = null;
+            _setupStageAmount = _setupTransferAmount = 0; _setupReveal = 1;
+            System.Array.Clear(_setupStageIcons, 0, 4); System.Array.Clear(_setupStageNames, 0, 4);
+        }
+    }
+}
