+
+        private static float TransmissionEdgeRms(Color[] pixels, out float mean)
+        {
+            float gradient = 0, light = 0; int count = 0, size = SiriAIOrbStyleView.Size;
+            for (int y = 1; y < size; ++y)
+            for (int x = 1; x < size; ++x)
+            {
+                Vector2 p = new Vector2(x + .5f - size * .5f, y + .5f - size * .5f) * (2.36f / size);
+                if (p.sqrMagnitude < .78f * .78f || p.sqrMagnitude > .96f * .96f) continue;
+                Color c = pixels[y * size + x];
+                // A blur preserves the total variation across a broad step.
+                // Edge RMS measures whether that step's light spreads out.
+                float horizontal = c.r - pixels[y * size + x - 1].r;
+                float vertical = c.r - pixels[(y - 1) * size + x].r;
+                gradient += horizontal * horizontal + vertical * vertical;
+                light += c.r; ++count;
+            }
+            mean = light / count;
+            return Mathf.Sqrt(gradient / (2 * count));
+        }
