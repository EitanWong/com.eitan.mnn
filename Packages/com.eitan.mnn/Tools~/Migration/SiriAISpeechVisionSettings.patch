@@ -0,0 +1,41 @@
+using System;
+
+namespace MNN.Unity
+{
+    /// <summary>Device-local enrollment. Embeddings are model-specific; raw pictures and recordings are not stored.</summary>
+    [Serializable]
+    public sealed class MNNInteractionIdentity
+    {
+        public string id;
+        public bool allowed = true;
+        public float[] face = Array.Empty<float>();
+        public float[] voice = Array.Empty<float>();
+        public string faceModel, voiceModel;
+
+        public MNNInteractionIdentity Snapshot() => new MNNInteractionIdentity
+        {
+            id = id, allowed = allowed, faceModel = faceModel, voiceModel = voiceModel,
+            face = (float[])(face ?? Array.Empty<float>()).Clone(), voice = (float[])(voice ?? Array.Empty<float>()).Clone()
+        };
+
+        public void Validate()
+        {
+            if (string.IsNullOrWhiteSpace(id)) throw new ArgumentException("An enrollment needs an identifier.");
+            ValidateVector(face, 512); ValidateVector(voice, null);
+        }
+
+        private static void ValidateVector(float[] vector, int? size)
+        {
+            if (vector == null) throw new ArgumentException("Enrollment vectors cannot be null.");
+            if (vector.Length == 0) return;
+            if (size.HasValue && vector.Length != size.Value) throw new ArgumentException("Incompatible enrollment vector.");
+            double energy = 0;
+            foreach (float value in vector)
+            {
+                if (float.IsNaN(value) || float.IsInfinity(value)) throw new ArgumentException("Enrollment must be finite.");
+                energy += value * (double)value;
+            }
+            if (energy <= 1e-12) throw new ArgumentException("Enrollment needs a usable signal.");
+        }
+    }
+}
