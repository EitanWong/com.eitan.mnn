+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using MNN.Unity;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private RectTransform _identityGuide;
+        private CancellationTokenSource _identityCapture;
+
+        private void BuildIdentitySettings(bool visual)
+        {
+            var settings = _settingsDraft.Acoustics.interaction;
+            settings.identities = settings.identities ?? Array.Empty<MNNInteractionIdentity>();
+            AddSettingsTitle(visual ? "Face access" : "Voice access", "Optional. Everyone can interact unless you enable restrictions. Recordings stay on this device; save to apply changes.");
+            if (!visual)
+            {
+                AddBoolField("Registered voices only", "Record an allowed voice first. Unrecognized or ambiguous voices are rejected.",
+                    () => settings.voiceRecognition, enabled => UpdateAudioSettings(() =>
+                    { settings.voiceRecognition = enabled; if (enabled) settings.separateSpeakers = true; }),
+                    settings.voiceRecognition || Array.Exists(settings.identities, person => person.allowed && person.voice.Length > 0));
+                if (settings.voiceRecognition && !settings.referenceSpeaker && !settings.separateSpeakers)
+                    BuildTargetSpeakerModel(_settingsDraft.Acoustics);
+            }
+            if (visual ? settings.faceRecognition && !settings.identities.Any(person => person.allowed && person.face.Length == 512) :
+                settings.voiceRecognition && !settings.identities.Any(person => person.allowed && person.voice.Length > 0))
+                SettingsDescription("No allowed people. Register someone or turn off restrictions to allow interaction.");
+            var add = SettingsButton(_settingsContent, "Add person", GlassInset, Ink);
+            add.name = visual ? "Add face" : "Add voice"; FixedHeight(add.gameObject, 44);
+            add.onClick.AddListener(() => OpenIdentityGuide(null, visual, !visual));
+            for (int i = 0; i < settings.identities.Length; ++i)
+            {
+                var person = settings.identities[i];
+                int number = i + 1;
+                var row = AddSettingsField(LocalizeFormat("Person {0}", number), Localize(person.allowed ? "Allowed" : "Blocked") + " · " +
+                    Localize(person.face.Length > 0 ? "Face recorded" : "No face recording") + " · " +
+                    Localize(person.voice.Length > 0 ? "Voice recorded" : "No voice recording"));
+                var manage = SettingsButton(row, "Manage", GlassInset, Ink); FixedHeight(manage.gameObject, 44);
+                manage.onClick.AddListener(() => OpenSettingsOptions((RectTransform)manage.transform,
+                    LocalizeFormat("Person {0}", number), new[] { Localize(person.allowed ? "Block interaction" : "Allow interaction"),
+                        Localize("Update recording"), Localize("Delete registration") }, -1, selected =>
+                    {
+                        if (selected == 1) { OpenIdentityGuide(person.id, visual, !visual); return; }
+                        UpdateAudioSettings(() =>
+                        {
+                            if (selected == 0) person.allowed = !person.allowed;
+                            else settings.identities = settings.identities.Where(entry => entry.id != person.id).ToArray();
+                            UpdateIdentityPolicy(settings);
+                        });
+                    }, false));
+            }
+        }
+
+        private static void UpdateIdentityPolicy(MNNInteractionSettings settings)
+        {
+            settings.allowedIdentities = settings.identities.Where(person => person.allowed && person.face.Length == 512).Select(person => person.id).ToArray();
+        }
+
+        private void OpenIdentityGuide(string id, bool face, bool voice)
+        {
+            if (!ReadSettingsFields()) return;
+            CloseIdentityGuide();
+            _identityGuide = RectObject("Identity Registration Guide", _settingsRoot);
+            Stretch(_identityGuide); _identityGuide.SetAsLastSibling();
+            _identityGuide.gameObject.AddComponent<Image>().color = new Color(0, 0, 0, .6f);
+            var card = RectObject("Registration Card", _identityGuide);
+            card.anchorMin = card.anchorMax = new Vector2(.5f, .5f); card.pivot = new Vector2(.5f, .5f);
+            card.sizeDelta = new Vector2(Mathf.Min(440, Mathf.Max(240, _settingsPanel.rect.width - 32)), 0);
+            var surface = card.gameObject.AddComponent<SiriAIRoundedRect>(); surface.Radius = SettingsSheetRadius;
+            surface.color = new Color(.06f, .08f, .12f, 1);
+            var layout = card.gameObject.AddComponent<VerticalLayoutGroup>();
+            layout.padding = new RectOffset(20, 20, 20, 20); layout.spacing = 16;
+            layout.childControlWidth = layout.childControlHeight = true; layout.childForceExpandHeight = false;
+            card.gameObject.AddComponent<ContentSizeFitter>().verticalFit = ContentSizeFitter.FitMode.PreferredSize;
+            Label(card, "Register person", 24, Ink).gameObject.AddComponent<LayoutElement>().minHeight = 36;
+            if (face)
+            {
+                var preview = RectObject("Registration Camera", card);
+                FixedHeight(preview.gameObject, 160);
+                var image = preview.gameObject.AddComponent<RawImage>(); image.texture = _chat?.VisualCamera;
+                image.uvRect = new Rect(0, 0, 1, 1);
+            }
+            var instructions = Label(card, face ? "Look at the camera alone, then click Record. Only your face features are saved." :
+                "Click Record, then speak alone for four seconds. Only your voice features are saved.", 17, Ink);
+            instructions.gameObject.AddComponent<LayoutElement>().minHeight = 90;
+            var record = SettingsButton(card, "Record", GlassInset, Ink); FixedHeight(record.gameObject, 48);
+            var close = SettingsButton(card, "Cancel", GlassInset, Ink); FixedHeight(close.gameObject, 44);
+            close.onClick.AddListener(CloseIdentityGuide);
+            record.onClick.AddListener(async () =>
+            {
+                if (_identityCapture != null) return;
+                if (_editorPreview) { instructions.text = Localize("Preview only. Camera is not started."); return; }
+                var cancellation = _identityCapture = new CancellationTokenSource();
+                int generation = _settingsGeneration;
+                SetSettingsBusy(true, allowClose: true);
+                record.interactable = false;
+                instructions.text = Localize(face ? "Capturing a fresh face image…" : "Recording… Speak alone for four seconds.");
+                try
+                {
+                    var captured = await _chat.CaptureIdentityAsync(_settingsDraft.Acoustics.Snapshot(), face, voice, cancellation.Token);
+                    cancellation.Token.ThrowIfCancellationRequested();
+                    if (this == null || generation != _settingsGeneration || !IsSettingsOpen) return;
+                    var settings = _settingsDraft.Acoustics.interaction;
+                    var people = new List<MNNInteractionIdentity>(settings.identities);
+                    var previous = people.Find(person => person.id == id);
+                    if (previous != null)
+                    {
+                        if (face) { previous.face = captured.face; previous.faceModel = captured.faceModel; }
+                        if (voice) { previous.voice = captured.voice; previous.voiceModel = captured.voiceModel; }
+                    }
+                    else people.Add(captured);
+                    settings.identities = people.ToArray(); UpdateIdentityPolicy(settings);
+                    CloseIdentityGuide(); ShowSettingsTab(_settingsTab, false);
+                    SetSettingsNotice("Registration complete. Save to apply.");
+                }
+                catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
+                catch (Exception error) { if (instructions != null) { instructions.text = Localize(error.Message); record.interactable = true; } }
+                finally
+                {
+                    if (_identityCapture == cancellation) _identityCapture = null;
+                    cancellation.Dispose();
