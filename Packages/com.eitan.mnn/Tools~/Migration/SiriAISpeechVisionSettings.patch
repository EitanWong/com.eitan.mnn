@@ -0,0 +1,98 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using MNN.Unity;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChat
+    {
+        private bool _enrollingIdentity;
+
+        internal async Task<MNNInteractionIdentity> CaptureIdentityAsync(SiriAIAcousticSettings settings, bool face, bool voice, CancellationToken token)
+        {
+            if (_enrollingIdentity || _context == null || IsRecordingVoice || IsPreparingConversation)
+                throw new InvalidOperationException("Wait for the microphone and conversation to become ready.");
+            _enrollingIdentity = true;
+            bool resume = IsRealtimeConversation;
+            var identity = new MNNInteractionIdentity { id = Guid.NewGuid().ToString("N"),
+                faceModel = settings.interaction.recognizerDirectory, voiceModel = settings.speakerDirectory };
+            try
+            {
+                await SetRealtimeConversationAsync(false);
+                await InterruptAsync();
+                token.ThrowIfCancellationRequested();
+                string root = SiriAIModelInstallation.ModelsDirectory;
+                if (face)
+                {
+                    if (_interaction == null || _interactionCamera == null || !HasReadableVisualCameraFrame(_interactionCamera))
+                        throw new InvalidOperationException("Enable vision and save before recording a face.");
+                    var frame = new TaskCompletionSource<MNNRgbImage>(TaskCreationOptions.RunContinuationsAsynchronously);
+                    Action<MNNRgbImage, double> capture = (image, _) => frame.TrySetResult(image);
+                    _interaction.Camera.FrameCaptured += capture;
+                    MNNRgbImage image;
+                    try
+                    {
+                        using (var deadline = CancellationTokenSource.CreateLinkedTokenSource(token))
+                        {
+                            deadline.CancelAfter(3000);
+                            using (deadline.Token.Register(() => frame.TrySetCanceled())) image = await frame.Task;
+                        }
+                    }
+                    catch (OperationCanceledException) when (!token.IsCancellationRequested)
+                    { throw new TimeoutException("No fresh camera frame. Check vision and try recording again."); }
+                    finally { _interaction.Camera.FrameCaptured -= capture; }
+                    identity.face = await Task.Run(() =>
+                    {
+                        using (var detector = MNNImageTask.Load(SiriAIAcousticModelResources.ResolvePath(root, settings.interaction.detectorDirectory)))
+                        using (var recognizer = MNNImageTask.Load(SiriAIAcousticModelResources.ResolvePath(root, identity.faceModel)))
+                        {
+                            var faces = detector.Process(image, token);
+                            if (faces.Detections == null || faces.Detections.Length != 1 || faces.FaceKeypoints?.Length != 1)
+                                throw new InvalidOperationException("Keep exactly one face in the camera and try again.");
+                            return recognizer.Process(MNNImageTask.AlignFace(image, faces.FaceKeypoints[0]), token).Vector;
+                        }
+                    }, token);
+                }
+                if (voice)
+                {
+                    if (!await Commands.BeginEnrollmentRecordingAsync()) throw new InvalidOperationException("The microphone is busy. Try again.");
+                    await Task.Delay(4000, token);
+                    var samples = await Commands.FinishEnrollmentRecordingAsync();
+                    token.ThrowIfCancellationRequested();
+                    identity.voice = await Task.Run(() =>
+                    {
+                        if (!HasEnrollmentSpeech(samples)) throw new InvalidOperationException("No clear voice was recorded. Speak alone and try again.");
+                        using (var speaker = MNNSpeakerEncoder.Load(SiriAIAcousticModelResources.ResolvePath(root, identity.voiceModel)))
+                            return speaker.Encode(samples, 16000, token);
+                    }, token);
+                }
+                token.ThrowIfCancellationRequested();
+                identity.Validate();
+                return identity;
+            }
+            finally
+            {
+                try { if (IsRecordingVoice) CancelVoiceRecording(); }
+                finally
+                {
+                    _enrollingIdentity = false;
+                    if (resume && _stopTask == null && isActiveAndEnabled) await SetRealtimeConversationAsync(true);
+                }
+            }
+        }
+
+        private static bool HasEnrollmentSpeech(float[] audio)
+        {
+            if (audio == null || audio.Length < 16000) return false;
+            int voiced = 0;
+            for (int offset = 0; offset + 512 <= audio.Length; offset += 512)
+            {
+                double sum = 0, energy = 0;
+                for (int i = offset; i < offset + 512; ++i) { sum += audio[i]; energy += audio[i] * (double)audio[i]; }
+                if (energy / 512 - sum * sum / (512 * 512) > .000009) ++voiced;
+            }
+            return voiced >= 16;
+        }
+    }
+}
