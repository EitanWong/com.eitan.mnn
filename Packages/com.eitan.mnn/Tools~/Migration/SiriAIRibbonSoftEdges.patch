+                peak = Mathf.Max(peak, value); floor = Mathf.Min(floor, value);
+                if (y > bottom)
+                    slope = Mathf.Max(slope, Mathf.Abs(value - DisplayLuminance(pixels[(y - 1) * size + x])) / pixel);
+            }
+            Assert.Greater(peak - floor, .03f, "Keep visible ribbon light at both inner-wall approaches.");
+            Assert.Less(slope, 12f,
+                "The reference's end at .84 sphere radii has a soft 3–4 luminance/radius falloff, not a sharp white wire.");
+            Assert.Less(slope / (peak - floor), 35f,
+                "Reduce the endpoint's relative sharpness as well as its brightness.");
+        }
 
