+using System;
+using System.IO;
+using MNN.Unity;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChatView
+    {
+        private Func<string> _speechModelsDirectory = () => SiriAIModelInstallation.ModelsDirectory;
+
+        private void BuildLocalSpeechVoiceSettings(SiriAIEndpointConfiguration endpoint)
+        {
+            MNNSpeechVoiceOptions options;
+            try
+            {
+                string directory = SiriAISpeechVoices.DirectoryFor(_speechModelsDirectory(), endpoint, _settingsDraft.Catalog);
+                options = MNNSpeechSynthesizer.GetVoiceOptions(directory);
+            }
+            catch (Exception error) when (error is InvalidDataException || error is IOException || error is ArgumentException || error is UnauthorizedAccessException)
+            {
+                SettingsDescription("Voice metadata unavailable. Verify or reinstall the selected model.");
+                return;
+            }
+            if (options.ModelKind == MNNSpeechModelKind.Unknown)
+            {
+                SettingsDescription("Install the selected model, then reopen these settings to choose its voices.");
+                return;
+            }
+            if (!options.SupportsVoice(endpoint.voice))
+            {
+                endpoint.voice = "";
+                SetSettingsNotice("The previous voice is unavailable. The model default is selected.");
+            }
+            if (options.RequiresReferenceAudio)
+            {
+                SettingsDescription("This model uses your reference recording as its voice.");
+                return;
+            }
+            string[] ids = options.VoiceIds;
+            var labels = new string[ids.Length + 1];
+            labels[0] = "Model default";
+            Array.Copy(ids, 0, labels, 1, ids.Length);
+            AddEnumField("Voice", "Choose a voice provided by the selected model.",
+                () => string.IsNullOrWhiteSpace(endpoint.voice) ? 0 : Array.IndexOf(ids, endpoint.voice) + 1,
+                selected => endpoint.voice = selected == 0 ? "" : ids[selected - 1], labels);
+        }
+    }
+}
