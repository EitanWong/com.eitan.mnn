+using System.Linq;
+using MNN.Unity;
+
+namespace MNN.Samples.SiriAI
+{
+    internal static class SiriAISpeechVoices
+    {
+        internal static string DirectoryFor(string root, SiriAIEndpointConfiguration endpoint, SiriAIModelCatalog catalog)
+        {
+            var entry = catalog?.Entries.FirstOrDefault(item => item.modelId == endpoint.model);
+            if (entry?.installedDirectory != null) return entry.installedDirectory;
+            var remote = endpoint.HasRemoteModel ? endpoint.localModel : entry?.remote;
+            if (remote != null) return SiriAIModelInstallation.DirectoryFor(root, remote);
+            return string.IsNullOrWhiteSpace(endpoint.model) ? null : MNNModelAssetDownloader.ResolvePath(root, endpoint.model);
+        }
+    }
+}
