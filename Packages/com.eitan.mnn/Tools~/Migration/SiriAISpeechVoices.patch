+using System;
+using System.IO;
+using System.Linq;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.UI;
+using Object = UnityEngine.Object;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAISpeechVoiceSettingsTests
+    {
+        private GameObject _root;
+        private SiriAIChatView _view;
+        private string _models;
+        private RectTransform Content => SiriAITestAccess.Field<RectTransform>(_view, "_settingsContent");
+        private SiriAIEndpointConfiguration Endpoint => _view.SettingsDraft.Configuration.tts;
+
+        [SetUp]
+        public void Open()
+        {
+            _models = Path.GetFullPath(Path.Combine("TestArtifacts~", "SpeechVoiceSettings", Guid.NewGuid().ToString("N")));
+            Directory.CreateDirectory(Path.Combine(_models, "voice-fixture"));
+            _root = new GameObject("Voice selection");
+            var backend = _root.AddComponent<SiriAIConfigurableBackend>();
+            _root.AddComponent<SiriAIChat>().SetBackend(backend);
+            _view = _root.AddComponent<SiriAIChatView>();
+            _view.TickEditorPreview(new Rect(0, 0, 390, 844), 1);
+            _view.OpenSettings();
+            _view.SettingsDraft.Appearance.language = SiriAILanguage.English;
+            SiriAITestAccess.Field<SiriAIChatViewPreferences>(_view, "_viewPreferences").language = SiriAILanguage.English;
+            SiriAITestAccess.Set(_view, "_speechModelsDirectory", (Func<string>)(() => _models));
+            Endpoint.model = "voice-fixture";
+            Endpoint.localModel = null;
+            Endpoint.voice = "";
+        }
+
+        [TearDown]
+        public void Close()
+        {
+            Object.DestroyImmediate(_root);
+            Directory.Delete(_models, true);
+        }
+
+        private void Metadata(string name, string text) => File.WriteAllText(Path.Combine(_models, "voice-fixture", name), text);
+        private void Build() => SiriAITestAccess.Call(_view, "BuildLocalSpeechVoiceSettings", Endpoint);
+
+        [Test]
+        public void LocalVoiceIsAChoiceAndSelectionUsesTheExactModelId()
+        {
+            Metadata("mnn_hojo_tts.json", "{\"voices\":[\"hojo_zh_f_01\",\"hojo_en_m_02\"]}");
+            Build();
+            var field = Content.Find("Voice");
+            Assert.NotNull(field);
+            Assert.IsNull(field.GetComponentInChildren<InputField>(), "Local voices must not accept free text.");
+            field.GetComponentInChildren<Button>().onClick.Invoke();
+            var choices = SiriAITestAccess.Field<RectTransform>(_view, "_settingsOptionsContent");
+            Assert.False(choices.GetComponentsInChildren<Text>().Any(text => text.text.Contains("Custom value")));
+            choices.GetComponentsInChildren<Button>().First(button => button.GetComponentInChildren<Text>().text == "hojo_en_m_02").onClick.Invoke();
+            Assert.AreEqual("hojo_en_m_02", Endpoint.voice);
+        }
+
+        [Test]
+        public void SavedUnsupportedVoiceReturnsToModelDefault()
+        {
+            Metadata("mnn_hojo_tts.json", "{\"voices\":[\"hojo_zh_f_01\"]}");
+            Endpoint.voice = "voice-from-another-model";
+            Build();
+            Assert.AreEqual("", Endpoint.voice);
+            Assert.NotNull(Content.Find("Voice"));
+        }
+
+        [Test]
+        public void ReferenceModelHasNoPretendPresetPicker()
+        {
+            Metadata("gpt_prefill_fp16.mnn", "");
+            Build();
+            Assert.IsNull(Content.Find("Voice"));
+            Assert.True(Content.GetComponentsInChildren<Text>().Any(text => text.text.Contains("reference recording")));
+        }
+
+        [Test]
+        public void MissingExportDoesNotOfferOtherModelsVoicesOrEraseSavedSelection()
+        {
+            Endpoint.voice = "previous-choice";
+            Build();
+            Assert.IsNull(Content.Find("Voice"));
+            Assert.AreEqual("previous-choice", Endpoint.voice);
+        }
+
+        [Test]
+        public void CorruptMetadataShowsARecoveryMessageWithoutATextInput()
+        {
+            Metadata("mnn_hojo_tts.json", "{}");
+            Build();
+            Assert.IsNull(Content.Find("Voice"));
+            Assert.True(Content.GetComponentsInChildren<Text>().Any(text => text.text.Contains("Voice metadata unavailable")));
+        }
+    }
+}
