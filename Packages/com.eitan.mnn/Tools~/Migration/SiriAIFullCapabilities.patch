+using System;
+using System.Reflection;
+namespace MNN.Samples.SiriAI.Tests
+{
+    /// <summary>Shared fixture access to package-owned device state after the migration. Assertions retain their original behavior.</summary>
+    public static class SiriAIDeviceSessionTestAccess
+    {
+        private const BindingFlags Flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
+        private static FieldInfo FindField(object target, string name)
+        {
+            for (var type = target.GetType(); type != null; type = type.BaseType)
+            { var field = type.GetField(name, Flags); if (field != null) return field; }
+            throw new MissingFieldException(target.GetType().FullName, name);
+        }
+        public static T Field<T>(object target, string name)
+        {
+            if (target is SiriAIUnityAudio unity && name == "_closed") return (T)(object)unity.DeviceSession.IsClosed;
+            if (target is SiriAIAudioEndpoint && TryDeviceOwner(target, name, out var owner, out var field))
+                return (T)FindField(owner, field).GetValue(owner);
+            return (T)FindField(target, name).GetValue(target);
+        }
+        public static void Set(object target, string name, object value)
+        {
+            if (target is SiriAIAudioEndpoint && TryDeviceOwner(target, name, out var owner, out var field))
+            {
+                if (name == "_ready" || name == "_used")
+                {
+                    bool enabled = (bool)value;
+                    int current = (int)FindField(owner, "_state").GetValue(owner);
+                    value = enabled ? (name == "_ready" || current == 2 ? 2 : 1) : 0;
+                    if (name == "_used")
+                    { FindField(owner, "_inputOwned").SetValue(owner, (int)value != 0); FindField(owner, "_outputOwned").SetValue(owner, (int)value != 0); }
+                }
+                else if (name == "_echoControlActive") value = (int)value != 0 ? long.MaxValue : 0L;
+                else if (name == "_inputWorker" && value != null)
+                    value = value.GetType().GetField("Shared", Flags)?.GetValue(value) ?? value;
+                FindField(owner, field).SetValue(owner, value); return;
+            }
+            FindField(target, name).SetValue(target, value);
+        }
+        // Lifetime assertions target the real package owner after device orchestration migration.
+        private static bool TryDeviceOwner(object target, string name, out object owner, out string field)
+        {
+            owner = null; field = name;
+            var sessionProperty = target.GetType().GetProperty("DeviceSession");
+            if (sessionProperty == null) return false;
+            switch (name)
+            {
+                case "_output": case "_presentedThrough": owner = sessionProperty.GetValue(target); return true;
+                case "_ready": case "_used": owner = sessionProperty.GetValue(target); field = "_state"; return true;
+                case "_inputWorker": owner = sessionProperty.GetValue(target); field = "_echo"; return true;
+                case "_echoControlActive": case "_echoHealthyUntil":
+                    owner = ((MNN.Unity.MNNRealtimeDeviceSession)sessionProperty.GetValue(target)).BackendEchoHealth; field = "_healthyUntil"; return true;
+                case "_outputSource": case "_speakerClip":
+                    if (!(target is SiriAIUnityAudio unity)) return false;
+                    owner = unity.DeviceBinding; field = name == "_outputSource" ? "_source" : name; return true;
+                default: return false;
+            }
+        }
+
+    }
+}
