     public sealed class SiriAIVisualCameraTests
     {
         private const BindingFlags Private = BindingFlags.Instance | BindingFlags.NonPublic;
+
+        [UnityTest]
+        public IEnumerator DisablingChatReleasesCameraBeforeAudioShutdownCompletes()
+        {
+            yield return new EnterPlayMode();
+            yield return DisableDuringAudioShutdown();
+            yield return new ExitPlayMode();
+        }
+
+        private static IEnumerator DisableDuringAudioShutdown()
+        {
+            var root = new GameObject("Immediate camera owner release");
+            var chat = root.AddComponent<SiriAIChat>();
+            var audio = root.AddComponent<SiriAIRetryTestAudio>();
+            audio.CloseGate = new TaskCompletionSource<bool>();
+            SiriAITestAccess.Set(chat, "_audio", audio);
+            // Creating an unopened texture exercises ownership without requesting device access.
+            SiriAITestAccess.Set(chat, "_interactionCamera", new WebCamTexture());
+            try
+            {
+                chat.enabled = false;
+                bool released = chat.VisualCamera == null;
+                TestContext.WriteLine("audioShutdownPending=" + !audio.CloseGate.Task.IsCompleted +
+                    " cameraReleased=" + released);
+                audio.CloseGate.TrySetResult(true);
+                Task stopping = chat.StopConversationAsync();
+                while (!stopping.IsCompleted) yield return null;
+                stopping.GetAwaiter().GetResult();
+                Assert.IsTrue(released, "Disabling the owner must release its camera before awaiting audio shutdown.");
+            }
+            finally { audio.CloseGate.TrySetResult(true); UnityEngine.Object.DestroyImmediate(root); }
+        }
+
+        [UnityTest]
+        public IEnumerator VisionWaitsUntilAudioEndpointFinishesOpening()
+        {
+            var root = new GameObject("Ordered visual startup");
+            var chat = root.AddComponent<SiriAIChat>();
+            var audio = root.AddComponent<SiriAIRetryTestAudio>();
+            audio.OpenGate = new TaskCompletionSource<bool>();
+            var backend = root.AddComponent<SiriAIRetryTestBackend>();
+            backend.FailuresRemaining = 0;
+            try
+            {
+                chat.Configure(audio, root.AddComponent<MNNRealtimeSessionComponent>());
+                chat.SetBackend(backend);
+                chat.SetAcousticSettings(new SiriAIAcousticSettings
+                {
+                    enabled = false,
+                    interaction = new MNNInteractionSettings { visualPresence = true }
+                });
+                Task starting = chat.StartConversationAsync();
+                bool visualStartedBeforeAudio = chat.Interaction != null;
+                TestContext.WriteLine("audioPending=" + !audio.OpenGate.Task.IsCompleted +
+                    " visualStartedBeforeAudio=" + visualStartedBeforeAudio);
+                // Shut down before releasing the pending endpoint: this also checks that a
+                // canceled startup cannot acquire a camera after its owner has stopped.
+                Task stopping = chat.StopConversationAsync();
+                audio.OpenGate.TrySetCanceled();
+                while (!stopping.IsCompleted) yield return null;
+                stopping.GetAwaiter().GetResult();
+                Assert.IsTrue(starting.IsCanceled);
+                Assert.IsNull(chat.VisualCamera);
+                Assert.IsFalse(visualStartedBeforeAudio,
+                    "Camera startup must wait for the audio endpoint to finish configuring the capture device.");
+            }
+            finally { audio.OpenGate.TrySetCanceled(); UnityEngine.Object.DestroyImmediate(root); }
+        }
+
+        [UnityTest, Explicit("Runs the actual SiriAI scene with saved settings and installed models; counts frames only."), Timeout(180000)]
+        public IEnumerator ActualSiriAISceneStartsCameraWithSavedSettings()
+        {
+            for (int cycle = 0; cycle < 2; ++cycle)
+            {
+                yield return new EnterPlayMode();
+                yield return StartActualScene();
+                yield return new ExitPlayMode();
+            }
+        }
+
+        private static IEnumerator StartActualScene()
+        {
+            var loading = UnityEditor.SceneManagement.EditorSceneManager.LoadSceneAsyncInPlayMode(
+                "Assets/Samples/SiriAI/Scenes/SiriAI.unity",
+                new UnityEngine.SceneManagement.LoadSceneParameters(UnityEngine.SceneManagement.LoadSceneMode.Single));
+            while (!loading.isDone) yield return null;
+            // Let the actual view/onboarding lifecycle run before issuing the same idempotent start command.
+            for (int frame = 0; frame < 5; ++frame) yield return null;
+            var chat = UnityEngine.Object.FindObjectOfType<SiriAIChat>();
+            Assert.IsNotNull(chat);
+            Assert.IsTrue(chat.AcousticProcessing.ReadSettings().interaction.visualPresence,
+                "Enable vision in the saved SiriAI settings before running this physical scene check.");
+            Task starting = chat.StartConversationAsync();
+            double deadline = Time.realtimeSinceStartupAsDouble + 120;
+            while ((!starting.IsCompleted || chat.VisualCamera == null || chat.VisualCamera.width <= 16) &&
+                Time.realtimeSinceStartupAsDouble < deadline)
+            {
+                if (starting.IsFaulted) starting.GetAwaiter().GetResult();
+                yield return null;
+            }
+            TestContext.WriteLine("Actual SiriAI scene: startup=" + starting.Status + " camera=" + chat.VisualCameraStatus);
+            Assert.IsTrue(starting.IsCompleted, "Conversation startup must finish.");
+            starting.GetAwaiter().GetResult();
+            Assert.IsNotNull(chat.VisualCamera, chat.VisualCameraStatus);
+            Assert.Greater(chat.VisualCamera.width, 16, chat.VisualCameraStatus);
+            Assert.That(chat.VisualCamera.GetPixels32().Length, Is.EqualTo(chat.VisualCamera.width * chat.VisualCamera.height));
+            int frames = 0;
+            deadline = Time.realtimeSinceStartupAsDouble + 2;
+            while (Time.realtimeSinceStartupAsDouble < deadline)
+            {
+                if (chat.VisualCamera.didUpdateThisFrame) ++frames;
+                yield return null;
+            }
+            TestContext.WriteLine("Actual SiriAI scene: size=" + chat.VisualCamera.width + "x" + chat.VisualCamera.height +
+                " frames=" + frames + " camera=" + chat.VisualCamera.deviceName);
+            Assert.Greater(frames, 0);
+            Task stopping = chat.StopConversationAsync();
+            while (!stopping.IsCompleted) yield return null;
+            stopping.GetAwaiter().GetResult();
+        }
 
