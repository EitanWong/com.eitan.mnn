diff --git a/Assets/Samples/SiriAI/Scripts/Runtime/Core/Presentation/SiriAICameraAccess.cs b/Assets/Samples/SiriAI/Scripts/Runtime/Core/Presentation/SiriAICameraAccess.cs
new file mode 100644
--- /dev/null
+++ b/Assets/Samples/SiriAI/Scripts/Runtime/Core/Presentation/SiriAICameraAccess.cs
@@ -0,0 +1,56 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI
+{
+    /// <summary>Camera authorization for the process that macOS actually attributes capture to.</summary>
+    internal static class SiriAICameraAccess
+    {
+        internal static bool HasSystemAccess
+        {
+            get
+            {
+#if UNITY_STANDALONE_OSX || UNITY_EDITOR_OSX
+                return MacWindow.CameraAuthorizationStatus == 3;
+#else
+                return Application.HasUserAuthorization(UserAuthorization.WebCam);
+#endif
+            }
+        }
+
+#if UNITY_STANDALONE_OSX || UNITY_EDITOR_OSX
+        internal static Task<bool> RequestAsync(CancellationToken token)
+        {
+            token.ThrowIfCancellationRequested();
+            // AVFoundation automatically prompts when WebCamTexture creates its device input.
+            // Unity 2021's RequestUserAuthorization only implements iOS/WebGL camera prompts.
+            int status = MacWindow.CameraAuthorizationStatus;
+            return Task.FromResult(status == 0 || status == 3);
+        }
+#else
+        internal static async Task<bool> RequestAsync(CancellationToken token)
+        {
+            token.ThrowIfCancellationRequested();
+            var completion = new TaskCompletionSource<bool>();
+            var operation = Application.RequestUserAuthorization(UserAuthorization.WebCam);
+            operation.completed += _ => completion.TrySetResult(true);
+            if (operation.isDone) completion.TrySetResult(true);
+            using (token.Register(() => completion.TrySetCanceled())) await completion.Task;
+            return HasSystemAccess;
+        }
+#endif
+
+        internal static Exception StartupFailure(string deviceFailure)
+        {
+#if UNITY_STANDALONE_OSX || UNITY_EDITOR_OSX
+            if (!HasSystemAccess) return new UnauthorizedAccessException(
+                "macOS has not authorized camera capture for this launch. " +
+                "If Unity was opened by Unity Hub, quit the Editor and open Unity.app directly, " +
+                "then allow camera access in System Settings > Privacy & Security > Camera. " + deviceFailure);
+#endif
+            return new TimeoutException(deviceFailure);
+        }
+    }
+}
