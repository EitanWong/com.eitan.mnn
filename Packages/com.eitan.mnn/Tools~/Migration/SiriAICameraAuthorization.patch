--- /dev/null
+++ b/Assets/Samples/SiriAI/Tools~/Testing/open_editor_macos.command
@@ -0,0 +1,23 @@
+#!/bin/sh
+# LaunchServices gives the Editor its own macOS camera authorization identity.
+set -eu
+script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
+project_root=$(CDPATH= cd "$script_dir/../../../../.." && pwd)
+version_file="$project_root/ProjectSettings/ProjectVersion.txt"
+if [ ! -f "$version_file" ]; then
+    printf '%s\n' 'Unity project settings not found beside this SiriAI import.' >&2
+    exit 66
+fi
+editor_version=$(awk '/^m_EditorVersion: / { print $2; exit }' "$version_file")
+editor_app=${UNITY_EDITOR_APP:-"/Applications/Unity/Hub/Editor/$editor_version/Unity.app"}
+if [ ! -x "$editor_app/Contents/MacOS/Unity" ]; then
+    printf 'Unity Editor not found: %s\n' "$editor_app" >&2
+    exit 69
+fi
+if [ -f "$project_root/Temp/UnityLockfile" ] && /usr/sbin/lsof -t "$project_root/Temp/UnityLockfile" >/dev/null 2>&1; then
+    printf '%s\n' 'Quit this project’s existing Unity Editor, then run this launcher again.' >&2
+    exit 75
+fi
+printf 'Opening independently: %s\nProject: %s\n' "$editor_app" "$project_root"
+printf '%s\n' 'Quit the existing Editor before using this launcher. Allow Unity camera access if macOS asks.'
+exec /usr/bin/open -n "$editor_app" --args -projectPath "$project_root"
