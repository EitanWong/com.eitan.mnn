+        [Test]
+        public void SleepingDefersBackgroundSpeechUntilPresenceReturns()
+        {
+            var root = new GameObject("Sleeping background presentation");
+            MNNRealtimeSession session = null;
+            try
+            {
+                var chat = root.AddComponent<SiriAIChat>();
+                var endpoint = root.AddComponent<SiriAIRecordingAudioEndpoint>();
+                var component = root.AddComponent<MNNRealtimeSessionComponent>();
+                var backend = root.AddComponent<SiriAITestBackend>(); chat.Configure(endpoint, component);
+                session = new MNNRealtimeSession(backend, new MNNRealtimeOutputPipeline(new MNNPcmFormat(16000, 1), 160));
+                SiriAITestAccess.Set(component, "_session", session); session.StartAsync().GetAwaiter().GetResult();
+                int calls = 0;
+                var caps = new MNNRealtimeCapabilities(MNNRealtimeFeature.None, "fixture", null);
+                SiriAITestAccess.Set(chat, "_registration", new SiriAIBackendRegistration(backend, caps, caps,
+                    tryBeginEventReply: (input, token) => { ++calls; return null; }));
+                var owner = root.AddComponent<MNNInteractionComponent>();
+                var settings = new MNNInteractionSettings { visualPresence = true, confirmationSeconds = 0 };
+                owner.Configure(settings);
+                SiriAITestAccess.Set(chat, "_interaction", owner); SiriAITestAccess.Set(chat, "_interactionSettings", settings);
+                Assert.True(chat.CanPresentBackgroundResult);
+                SiriAITestAccess.Set(chat, "_visualReady", true);
+                Assert.False(chat.CanPresentBackgroundResult);
+                chat.TryBeginEventReply(null, CancellationToken.None); Assert.Zero(calls);
+                owner.Presence.Report(new MNNPresenceObservation(Time.realtimeSinceStartupAsDouble, MNNPresenceKind.Face, "person", 1));
+                Assert.True(chat.CanPresentBackgroundResult);
+                chat.TryBeginEventReply(null, CancellationToken.None); Assert.AreEqual(1, calls);
+            }
+            finally { session?.StopAsync().GetAwaiter().GetResult(); Object.DestroyImmediate(root); }
+        }
