+            var requests = new List<SiriAISetupPermission>();
+            SiriAISetupPermissions.RequestAsync(camera | SiriAISetupPermission.Microphone,
+                p => { requests.Add(p); return Task.CompletedTask; }, CancellationToken.None).GetAwaiter().GetResult();
+            CollectionAssert.AreEqual(new[] { SiriAISetupPermission.Microphone, camera }, requests);
+            Assert.False(flow.CanFinish, "Request completion alone is not evidence of authorization.");
+            flow.Refresh(camera, camera, true, false);
+            Assert.True(flow.CanFinish);
+        }
+
+        [Test]
+        public void AutoCreatedCameraUsesSleepPollingAndRestoresOnPresence()
+        {
+            var root = new GameObject("Low power camera");
+            try
+            {
+                var owner = root.AddComponent<MNNInteractionComponent>();
+                var wrongOwner = new GameObject("Other rig");
+                wrongOwner.transform.SetParent(root.transform);
+                SiriAITestAccess.Set(owner.Camera, "_presence", wrongOwner.AddComponent<MNNPresenceComponent>());
+                owner.Configure(new MNNInteractionSettings { visualPresence = true, confirmationSeconds = 0 });
+                var rate = typeof(MNNFaceCameraComponent).GetProperty("CurrentDetectionFramesPerSecond");
+                Assert.NotNull(rate, "Polling must use the same presence owner as interaction.");
+                Assert.AreEqual(2, rate.GetValue(owner.Camera));
+                owner.Presence.Report(new MNNPresenceObservation(Time.realtimeSinceStartupAsDouble, MNNPresenceKind.Face, "person", 1));
+                Assert.AreEqual(MNNPresenceState.Present, owner.Presence.Current.State);
+                Assert.AreEqual(10, rate.GetValue(owner.Camera));
+                owner.Configure(new MNNInteractionSettings());
+                Assert.False(owner.Camera.enabled, "An image preference must never start a camera.");
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+
+        [TestCase(SiriAIOrbStyle.Original)]
+        [TestCase(SiriAIOrbStyle.LiquidSpectrum)]
+        [TestCase(SiriAIOrbStyle.ClassicSiri)]
+        public void SleepingOrbIgnoresVoiceDimsBreathesAndRestoresAuthoredAppearance(SiriAIOrbStyle style)
+        {
+            var root = new GameObject("Sleeping orb");
+            try
+            {
+                var orb = root.AddComponent<SiriAIRenderer>(); orb.Style = style; orb.Refresh();
+                var sleep = typeof(SiriAIRenderer).GetMethod("SetSleeping");
+                Assert.NotNull(sleep, "A visible sleep animation must be driven independently of voice.");
+                var color = orb.Strands.color; float intensity = orb.Strands.intensity;
+                sleep.Invoke(orb, new object[] { true });
+                for (int i = 0; i < 300; ++i)
+                {
+                    orb.SetListening(true, 1); orb.SetSpeechLevel(1);
+                    SiriAITestAccess.Call(orb, "AdvanceSleepAnimation", 1f / 30);
+                    SiriAITestAccess.Call(orb, "AdvanceSpeechAnimation", 1f / 30);
+                }
+                orb.Refresh(); var material = root.GetComponent<MeshRenderer>().sharedMaterial;
+                Assert.Greater(material.GetFloat("_SleepBlend"), .99f);
+                Assert.That(material.GetFloat("_SleepBreath"), Is.InRange(-1f, 1f));
+                Assert.Less(orb.SpeechLevel, .001f);
+                Assert.AreEqual(1f, orb.ListeningScale, .001f);
+                float breath = material.GetFloat("_SleepBreath");
+                SiriAITestAccess.Call(orb, "AdvanceSleepAnimation", 1f); orb.Refresh();
+                Assert.AreNotEqual(breath, material.GetFloat("_SleepBreath"), "Sleep retains a slow, audio-independent breath.");
+                sleep.Invoke(orb, new object[] { false });
+                for (int i = 0; i < 150; ++i) SiriAITestAccess.Call(orb, "AdvanceSleepAnimation", 1f / 30);
+                orb.SetListening(true, 1);
+                for (int i = 0; i < 60; ++i) SiriAITestAccess.Call(orb, "AdvanceSpeechAnimation", 1f / 60);
+                orb.Refresh();
+                Assert.Less(material.GetFloat("_SleepBlend"), .001f);
+                Assert.Greater(orb.SpeechLevel, .1f);
+                Assert.AreEqual(color, orb.Strands.color); Assert.AreEqual(intensity, orb.Strands.intensity);
+                TestContext.WriteLine(style + " sleep: voice=0, sleepBlend>0.99, breath changes; wake: voice>0.1, sleepBlend<0.001, authored settings preserved");
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+    }
