@@ -0,0 +1,35 @@
+using UnityEngine;
+
+public sealed partial class SiriAIRenderer
+{
+    private bool sleeping;
+    private float sleepBlend, sleepVelocity;
+    private double sleepTime;
+    private static readonly int SleepBlendId = Shader.PropertyToID("_SleepBlend");
+    private static readonly int SleepBreathId = Shader.PropertyToID("_SleepBreath");
+    public bool IsSleeping => sleeping;
+
+    /// <summary>Audio-independent dim breathing. Authored appearance remains intact for wake.</summary>
+    public void SetSleeping(bool value)
+    {
+        if (sleeping == value) return;
+        sleeping = value;
+        if (value)
+        {
+            ClearSpeechWaveform();
+            SetState(AnimationState.Strands);
+        }
+    }
+
+    private void AdvanceSleepAnimation(float dt)
+    {
+        AdvanceMorph(ref sleepBlend, ref sleepVelocity, sleeping ? 1f : 0f, sleeping ? 1.4f : .5f, dt);
+        sleepTime += Mathf.Max(0, dt);
+    }
+
+    private void ApplySleepSettings()
+    {
+        SetFloatIfChanged(SleepBlendId, sleepBlend);
+        SetFloatIfChanged(SleepBreathId, (float)System.Math.Sin(sleepTime * System.Math.PI / 3));
+    }
+}
