--- /dev/null
+++ b/Assets/Samples/SiriAI/Scripts/Runtime/Components/Conversation/SiriAIChat.LowPower.cs
@@ -0,0 +1,57 @@
+using System;
+using MNN.Unity;
+using UnityEngine;
+
+namespace MNN.Samples.SiriAI
+{
+    public sealed partial class SiriAIChat
+    {
+        private bool _presenceLowPower, _presenceCleanupPending;
+        private double _presenceCleanupAt;
+        private AsyncOperation _presenceUnload;
+        private int _presenceSleepRevision;
+        public int SleepCleanupCount { get; private set; }
+        /// <summary>Visual sleep only. Explicit interaction and active work keep normal resources available.</summary>
+        public bool IsPresenceSleeping => isActiveAndEnabled && _stopTask == null && _interactionSettings?.visualPresence == true && _visualReady &&
+            _interaction != null && _interaction.Presence.Current.State == MNNPresenceState.Sleeping &&
+            !IsProcessing && !IsRecordingVoice && !_voiceFinishing && !IsPreparingConversation && !IsResettingConversation;
+        public bool IsLowPowerMode => _presenceLowPower;
+
+        private void UpdatePresenceLowPower()
+        {
+            SetPresenceLowPower(IsPresenceSleeping);
+            if (!_presenceLowPower || !_presenceCleanupPending || _presenceUnload != null ||
+                Time.realtimeSinceStartupAsDouble < _presenceCleanupAt || !_interaction.Camera.Completion.IsCompleted) return;
+            _presenceCleanupPending = false;
+            _interaction.VisionContext.Clear();
+            AcousticFrontend?.DiscardWake();
+            // Reclaim only unreferenced Unity assets. Live models, capture and wake detector stay owned.
+            int revision = _presenceSleepRevision;
+            _presenceUnload = Resources.UnloadUnusedAssets();
+            _presenceUnload.completed += _ =>
+            {
+                _presenceUnload = null;
+                if (this == null || !_presenceLowPower || revision != _presenceSleepRevision) return;
+                GC.Collect();
+                ++SleepCleanupCount;
+            };
+        }
+
+        private void SetPresenceLowPower(bool sleeping)
+        {
+            if (_presenceLowPower == sleeping) return;
+            _presenceLowPower = sleeping;
+            ++_presenceSleepRevision;
+            _presenceCleanupPending = sleeping;
+            _presenceCleanupAt = Time.realtimeSinceStartupAsDouble + 2;
+            if (_context != null)
+            {
+                _context.AutomaticInputSuspended = sleeping;
+                // Invalidate queued audio/idle-exit requests, and give wake a fresh inactivity window.
+                if (_context.Input.Realtime) _context.Input.SetRealtime(true);
+                _context.SetCaptureEnabled(_stopTask == null && (_context.Input.Realtime || _context.Input.Recording));
+            }
+            if (sleeping) { _interaction?.VisionContext.Clear(); DiscardWakeActivation(); }
+        }
+    }
+}
