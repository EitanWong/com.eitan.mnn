+            var root = new GameObject("C930c low frequency wake probe");
+            var camera = new WebCamTexture(device.name);
+            try
+            {
+                camera.Play(); double deadline = Time.realtimeSinceStartupAsDouble + 15;
+                while ((camera.width <= 16 || !camera.didUpdateThisFrame) && Time.realtimeSinceStartupAsDouble < deadline)
