+        public void CameraOffIdleSleepsAndExplicitActivityWakesWithoutStartingCamera()
+        {
+            var root = new GameObject("Camera-off idle sleep");
+            try
+            {
+                var chat = root.AddComponent<SiriAIChat>();
+                var context = new SiriAIChatContext(new EmptyCapture(), () => null);
+                SiriAITestAccess.Set(chat, "_context", context);
+                SiriAITestAccess.Set(chat, "_interactionSettings", new MNNInteractionSettings { visualPresence = false, sleepSeconds = 15 });
+                var tick = typeof(SiriAIChat).GetMethod("UpdatePresenceLowPower", BindingFlags.Instance | BindingFlags.NonPublic);
+                tick.Invoke(chat, null);
+                Assert.False(chat.IsPresenceSleeping, "A new session gets a full idle window.");
+                var activity = typeof(SiriAIChat).GetMethod("NotifyInteractionActivity");
+                Assert.NotNull(activity, "Manual interaction must wake camera-off idle sleep.");
+                SiriAITestAccess.Set(chat, "_lastInteractionActivity", Time.realtimeSinceStartupAsDouble - 16);
+                tick.Invoke(chat, null);
+                Assert.True(chat.IsPresenceSleeping);
