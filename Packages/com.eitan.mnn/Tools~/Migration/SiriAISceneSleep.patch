+                Assert.DoesNotThrow(() => { SiriAITestAccess.Set(chat, "_presenceCleanupAt", 0d); tick.Invoke(chat, null); });
+                activity.Invoke(chat, null);
+                Assert.False(chat.IsPresenceSleeping);
+                Assert.False(chat.IsLowPowerMode);
