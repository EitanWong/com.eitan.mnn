     public sealed class SiriAIWovenRibbonTests
     {
         private const int Size = 256;
+
+        [TestCase(false)]
+        [TestCase(true)]
+        public void BrightFoldFollowsTheReferenceTurnAfterExposure(bool mobile)
+        {
+            using (var view = new SiriAIOrbStyleView(SiriAIOrbStyle.Original, false))
+            {
+                if (mobile) view.Material.shader = Shader.Find("Hidden/SiriAI/OrbMobile");
+                view.EnableCameraQuality();
+                var quality = SiriAIGraphicsQuality.Selection;
+                var tonemapping = SiriAIGraphicsQuality.TonemappingMode;
+                try
+                {
+                    SiriAIGraphicsQuality.Apply(SiriAIQualityTier.Ultra, SiriAITonemappingMode.Aces);
+                    view.SetScale(1);
+                    view.Material.SetFloat("_StrandWidth", 1.54f * 1.8f);
+                    view.Material.SetFloat("_StrandSaturation", .38f);
+                    view.Material.SetFloat("_StrandLevel", .802f);
+                    var pixels = view.Render(4f, level: 1, motionTime: 4f * 6.37f / 3.05f);
+                    float fall = BrightFoldHeight(pixels, -1) - BrightFoldHeight(pixels, 1);
+                    Assert.That(fall, Is.InRange(.07f, .16f),
+                        "The measured 4 s reference bright ridge falls .116 sphere radii from left to right; illumination must follow that turn.");
+                }
+                finally { SiriAIGraphicsQuality.Apply(quality, tonemapping); }
+            }
+        }
+
+        private static float BrightFoldHeight(Color[] pixels, int side)
+        {
+            double moment = 0, weight = 0;
+            int size = SiriAIOrbStyleView.Size;
+            for (int y = 0; y < size; ++y)
+            for (int x = 0; x < size; ++x)
+            {
+                Vector2 p = new Vector2(x + .5f - size * .5f, y + .5f - size * .5f) * (2.36f / size);
+                if (p.x * side < .20f || p.x * side > .45f || Mathf.Abs(p.y) > .3f) continue;
+                float w = Mathf.Pow(Mathf.Max(DisplayLuminance(pixels[y * size + x]) - .5f, 0), 2);
+                moment += p.y * w; weight += w;
+            }
+            Assert.Greater(weight, 1, "Measure a visible luminous fold.");
+            return (float)(moment / weight);
+        }
 
         [TestCase(false)]
         [TestCase(true)]
