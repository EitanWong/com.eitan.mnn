+using System;
+using System.IO;
+using System.Linq;
+using MNN.Unity;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIFaceAccessGuideTests
+    {
+        private GameObject _root;
+        private SiriAIChatView _view;
+        private Action _restore;
+        private RectTransform Content => SiriAITestAccess.Field<RectTransform>(_view, "_settingsContent");
+
+        [SetUp]
+        public void SetUp()
+        {
+            _restore = SiriAIViewPreferencesStore.CaptureRestore();
+            _root = new GameObject("Face access guide");
+            var acoustic = _root.AddComponent<SiriAIAcousticProcessing>();
+            SiriAITestAccess.Set(acoustic, "preferencesKey", "");
+            _root.AddComponent<SiriAIChat>().enabled = false;
+            _view = _root.AddComponent<SiriAIChatView>();
+            _view.TickEditorPreview(new Rect(0, 0, 390, 844), 1);
+            _view.OpenSettings();
+            _view.SettingsDraft.Acoustics.interaction.visualPresence = true;
+            SiriAITestAccess.Call(_view, "ShowSettingsTab", 13, false);
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            UnityEngine.Object.DestroyImmediate(_root);
+            _restore?.Invoke();
+        }
+
+        [Test]
+        public void OneFaceAccessChoiceExplainsAndSetsRealtimeAdmission()
+        {
+            bool singleChoice = Content.Find("Realtime voice access") != null;
+            TestContext.WriteLine("face-access=" + (singleChoice ? "one explained choice" : "separate switches"));
+            Assert.True(singleChoice, "Face permissions need one explicit choice beside enrolled people.");
+            Assert.IsNull(Content.Find("Recognized identities only"));
+            Assert.IsNull(Content.Find("Require visible face for voice"));
+            SiriAITestAccess.SelectSetting(_view, "Realtime voice access", "Recorded faces only");
+            var settings = _view.SettingsDraft.Acoustics.interaction;
+            Assert.True(settings.faceRecognition && settings.requirePresenceForVoice && settings.RequiresPresenceForVoice);
+            Assert.True(Content.GetComponentsInChildren<Text>().Any(text => text.text.Contains("No allowed face")), "An empty list must explicitly explain that listening stays paused.");
+            SiriAITestAccess.SelectSetting(_view, "Realtime voice access", "Anyone visible");
+            Assert.False(settings.faceRecognition);
+            Assert.True(settings.requirePresenceForVoice);
+            SiriAITestAccess.SelectSetting(_view, "Realtime voice access", "Visible target speaker");
+            Assert.True(settings.audioVisualSpeech && settings.RequiresPresenceForVoice);
+            Assert.NotNull(Content.Find("Audio-visual extraction model"));
+            Assert.IsNull(Content.Find("Audio-visual target speech"), "The mode is the only owner of visual pickup.");
+            SiriAITestAccess.SelectSetting(_view, "Realtime voice access", "Anyone visible");
+            Assert.False(settings.audioVisualSpeech);
+            Assert.True(settings.RequiresPresenceForVoice);
+            Assert.False(_root.GetComponent<SiriAIChat>().GetAcousticSettings().interaction.visualPresence, "Choices remain drafts until Save.");
+        }
+
+        [Test]
+        public void ExistingFaceBlocksRemainExplicitWhenTheAllowListIsOff()
+        {
+            var settings = _view.SettingsDraft.Acoustics.interaction;
+            settings.identities = new[] { new MNNInteractionIdentity { id = "blocked", allowed = false, face = new float[512] } };
+            SiriAITestAccess.Call(_view, "ShowSettingsTab", 13, false);
+            SiriAITestAccess.SelectSetting(_view, "Realtime voice access", "Anyone visible");
+            Assert.True(settings.RequiresPresenceForVoice, "An existing block must never be silently cleared by changing the allow-list choice.");
+            Assert.False(settings.identities[0].allowed);
+            Assert.True(Content.Find("Realtime voice access").GetComponentsInChildren<Text>().Any(text => text.text.Contains("Blocked people stay blocked")));
+        }
+
+        [Test]
+        public void RecordingRequiresReviewAndCanBeRetakenOrCancelledWithoutSaving()
+        {
+            Content.Find("Add face").GetComponent<Button>().onClick.Invoke();
+            var captured = new MNNInteractionIdentity { id = "new-face", face = new float[512], faceModel = "face-model" };
+            SiriAITestAccess.Call(_view, "ShowIdentityCaptureFrame", new MNNRgbImage(new byte[4 * 2 * 3], 4, 2));
+            SiriAITestAccess.Call(_view, "ReviewIdentityRecording", captured);
+            var guide = SiriAITestAccess.Field<RectTransform>(_view, "_identityGuide");
+            Assert.IsEmpty(_view.SettingsDraft.Acoustics.interaction.identities, "Capturing must not silently add a person before confirmation.");
+            guide.GetComponentsInChildren<Button>().Single(button => button.name == "Retake").onClick.Invoke();
+            Assert.IsNull(SiriAITestAccess.Field<Texture2D>(_view, "_identityCapturedFrame"));
+            Assert.IsEmpty(_view.SettingsDraft.Acoustics.interaction.identities);
+            SiriAITestAccess.Call(_view, "ReviewIdentityRecording", captured);
+            guide.GetComponentsInChildren<Button>().Single(button => button.name == "Record").onClick.Invoke();
+            Assert.AreEqual(1, _view.SettingsDraft.Acoustics.interaction.identities.Length);
+            Assert.IsEmpty(_root.GetComponent<SiriAIChat>().GetAcousticSettings().interaction.identities, "Using a recording only edits the draft.");
+            Content.Find("Add face").GetComponent<Button>().onClick.Invoke();
+            SiriAITestAccess.Call(_view, "ReviewIdentityRecording", new MNNInteractionIdentity { id = "cancelled", face = new float[512] });
+            SiriAITestAccess.Call(_view, "CloseIdentityGuide");
+            Assert.AreEqual(1, _view.SettingsDraft.Acoustics.interaction.identities.Length);
+            Assert.IsNull(SiriAITestAccess.Field<Texture2D>(_view, "_identityCapturedFrame"));
+        }
+
+        [TestCase(390, 844)]
+        [TestCase(844, 390)]
+        [TestCase(320, 568)]
+        public void FaceGuideFitsViewportAndPreservesCameraAspect(int width, int height)
+        {
+            _view.TickEditorPreview(new Rect(0, 0, width, height), 1);
+            Content.Find("Add face").GetComponent<Button>().onClick.Invoke();
+            var guide = SiriAITestAccess.Field<RectTransform>(_view, "_identityGuide");
+            var card = (RectTransform)guide.Find("Registration Card");
+            Canvas.ForceUpdateCanvases();
+            var preview = guide.GetComponentsInChildren<RawImage>().Single();
+            var aspect = preview.GetComponentInParent<AspectRatioFitter>();
+            TestContext.WriteLine("preview=" + (aspect == null ? "stretched" : "aspect fit") + "; viewport=" + width + "x" + height);
+            Assert.NotNull(aspect, "Recording preview must preserve camera aspect rather than stretch the face.");
+            Assert.AreEqual(AspectRatioFitter.AspectMode.FitInParent, aspect.aspectMode);
+            var texture = new Texture2D(640, 480);
+            try
+            {
+                SiriAITestAccess.Call(_view, "UpdateIdentityGuidePreview", texture, 90, true);
+                Canvas.ForceUpdateCanvases();
+                SiriAITestAccess.Call(_view, "UpdateIdentityGuidePreview", texture, 90, true);
+                Assert.AreEqual(.75f, aspect.aspectRatio, .001f);
+                Assert.AreEqual(-1, preview.uvRect.height);
+                Assert.LessOrEqual(card.rect.height, guide.rect.height - 24);
+                Assert.LessOrEqual(card.rect.width, guide.rect.width - 24);
+                var corners = new Vector3[4]; card.GetWorldCorners(corners);
+                Assert.True(corners.All(point => guide.rect.Contains((Vector2)guide.InverseTransformPoint(point))), "The card must stay inside the visible guide, including its position.");
+                Assert.NotNull(guide.GetComponentInChildren<ScrollRect>(), "Long instructions scroll while the actions stay visible.");
+                if (width > height)
+                {
+                    var viewport = (RectTransform)guide.GetComponentInChildren<ScrollRect>().viewport;
+                    var instructions = SiriAITestAccess.Field<Text>(_view, "_identityInstructions").rectTransform;
+                    AssertInsideViewport(instructions, viewport, "Landscape must show the capture instruction before scrolling.");
+                    AssertInsideViewport((RectTransform)aspect.transform.parent, viewport, "Landscape must show the preview beside the capture instruction without scrolling.");
+                }
+                var actions = (RectTransform)card.Find("Guide Actions");
+                Assert.GreaterOrEqual(actions.offsetMin.y, 16);
+                Assert.Less(actions.offsetMax.y, ((RectTransform)card.Find("Guide Scroll")).offsetMin.y);
+                Assert.IsEmpty(guide.GetComponentsInChildren<InputField>());
+                guide.GetComponentsInChildren<Button>().Single(button => button.name == "Cancel").onClick.Invoke();
+                Assert.IsNull(SiriAITestAccess.Field<RectTransform>(_view, "_identityGuide"));
+                Assert.IsEmpty(_view.SettingsDraft.Acoustics.interaction.identities);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(texture); }
+        }
+
+        [TestCase(390, 844)]
+        [TestCase(844, 390)]
+        [TestCase(320, 568)]
+        public void RenderChineseGuideForLayoutReview(int width, int height)
+        {
+            if (SystemInfo.graphicsDeviceType == UnityEngine.Rendering.GraphicsDeviceType.Null) Assert.Ignore("Requires --graphics for visual layout review.");
+            string output = Environment.GetEnvironmentVariable("SIRIAI_FACE_GUIDE_ARTIFACTS");
+            if (string.IsNullOrEmpty(output)) Assert.Ignore("Set SIRIAI_FACE_GUIDE_ARTIFACTS to save visual review artifacts.");
+            SiriAITestAccess.Field<SiriAIChatViewPreferences>(_view, "_viewPreferences").language = SiriAILanguage.SimplifiedChinese;
+            SiriAITestAccess.Call(_view, "ShowSettingsTab", 13, false);
+            _view.TickEditorPreview(new Rect(0, 0, width, height), 1);
+            Content.Find("Add face").GetComponent<Button>().onClick.Invoke();
+            var target = new RenderTexture(width, height, 24);
+            var cameraOwner = new GameObject("Guide layout camera");
+            var texture = new Texture2D(640, 480);
+            var pixels = new Texture2D(width, height, TextureFormat.RGB24, false);
+            var previous = RenderTexture.active;
+            try
+            {
+                var calibration = new Color32[640 * 480];
+                for (int y = 0; y < 480; ++y)
+                    for (int x = 0; x < 640; ++x)
+                    {
+                        bool circle = Math.Abs(Math.Sqrt((x - 320) * (x - 320) + (y - 240) * (y - 240)) - 150) < 4;
+                        calibration[y * 640 + x] = circle ? new Color32(90, 200, 170, 255) : new Color32(25, 42, 57, 255);
+                    }
+                texture.SetPixels32(calibration); texture.Apply();
+                SiriAITestAccess.Call(_view, "UpdateIdentityGuidePreview", texture, 0, false);
+                Canvas.ForceUpdateCanvases();
+                SiriAITestAccess.Call(_view, "UpdateIdentityGuidePreview", texture, 0, false);
+                var camera = cameraOwner.AddComponent<Camera>(); camera.targetTexture = target;
+                camera.clearFlags = CameraClearFlags.SolidColor; camera.backgroundColor = new Color(.025f, .03f, .045f);
+                var canvas = SiriAITestAccess.Field<GameObject>(_view, "_canvasRoot").GetComponent<Canvas>();
+                canvas.renderMode = RenderMode.ScreenSpaceCamera; canvas.worldCamera = camera; canvas.planeDistance = 1;
+                Canvas.ForceUpdateCanvases();
+                SiriAITestAccess.Call(_view, "LayoutIdentityGuide");
+                Canvas.ForceUpdateCanvases();
+                SiriAITestAccess.Call(_view, "UpdateIdentityGuidePreview", texture, 0, false);
+                FollowRenderedControls(canvas);
+                camera.Render(); RenderTexture.active = target;
+                pixels.ReadPixels(new Rect(0, 0, width, height), 0, 0); pixels.Apply();
+                Directory.CreateDirectory(output);
+                File.WriteAllBytes(Path.Combine(output, "guide-" + width + "x" + height + ".png"), pixels.EncodeToPNG());
+                SiriAITestAccess.Call(_view, "ReviewIdentityRecording", new MNNInteractionIdentity { id = "review", face = new float[512] });
+                Canvas.ForceUpdateCanvases(); FollowRenderedControls(canvas); camera.Render();
+                pixels.ReadPixels(new Rect(0, 0, width, height), 0, 0); pixels.Apply();
+                File.WriteAllBytes(Path.Combine(output, "review-" + width + "x" + height + ".png"), pixels.EncodeToPNG());
+                Assert.Greater(pixels.GetPixels32().Count(pixel => pixel.g > 80), 1000, "The rendered guide must contain visible content.");
+            }
+            finally
+            {
+                RenderTexture.active = previous;
+                UnityEngine.Object.DestroyImmediate(cameraOwner); UnityEngine.Object.DestroyImmediate(target);
+                UnityEngine.Object.DestroyImmediate(texture); UnityEngine.Object.DestroyImmediate(pixels);
+            }
+        }
+
+        private static void FollowRenderedControls(Canvas canvas)
+        {
+            // Camera.Render does not run the normal LateUpdate after layout.
+            foreach (var shadow in canvas.GetComponentsInChildren<SiriAIComposerShadow>())
+                SiriAITestAccess.Call(shadow, "FollowTarget");
+        }
+
+        private static void AssertInsideViewport(RectTransform item, RectTransform viewport, string message)
+        {
+            var corners = new Vector3[4]; item.GetWorldCorners(corners);
+            Assert.True(corners.All(point =>
+            {
+                var local = viewport.InverseTransformPoint(point);
+                return local.x >= viewport.rect.xMin - .5f && local.x <= viewport.rect.xMax + .5f &&
+                    local.y >= viewport.rect.yMin - .5f && local.y <= viewport.rect.yMax + .5f;
+            }), message);
+        }
+    }
+}
