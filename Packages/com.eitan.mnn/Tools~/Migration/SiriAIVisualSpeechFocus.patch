+            if (EventSystem.current != null) EventSystem.current.SetSelectedGameObject(cancel.gameObject);
+        }
+
+        private void BuildIdentityGuideCamera(RectTransform body)
+        {
+            var frame = RectObject("Registration Camera", body); FixedHeight(frame.gameObject, 190);
+            _identityCameraLayout = frame.GetComponent<LayoutElement>();
+            frame.gameObject.AddComponent<Image>().color = new Color(.025f, .03f, .04f);
+            frame.gameObject.AddComponent<RectMask2D>();
+            _identitySurface = RectObject("Upright Registration Surface", frame); Stretch(_identitySurface);
+            _identityAspect = _identitySurface.gameObject.AddComponent<AspectRatioFitter>();
+            _identityAspect.aspectMode = AspectRatioFitter.AspectMode.FitInParent; _identityAspect.aspectRatio = 4f / 3;
+            _identityPreview = RectObject("Registration Image", _identitySurface).gameObject.AddComponent<RawImage>();
+            _identityPreview.raycastTarget = false;
+            _identityCameraHint = Label(body, "", 15, Muted); _identityCameraHint.name = "Camera readiness";
+            _identityCameraHint.gameObject.AddComponent<LayoutElement>().minHeight = 40;
+        }
+
+        private void LayoutIdentityGuide()
+        {
+            if (_identityGuide == null || _identityCard == null) return;
+            var available = _identityGuide.rect.size;
+            var size = new Vector2(Mathf.Min(480, Mathf.Max(0, available.x - 32)), Mathf.Min(620, Mathf.Max(0, available.y - 32)));
+            var bounds = new Rect((available - size) * .5f, size);
+            if (_identityGuideBounds == bounds) return;
+            _identityGuideBounds = bounds;
+            _identityCard.anchorMin = _identityCard.anchorMax = _identityCard.pivot = Vector2.zero;
+            _identityCard.anchoredPosition = bounds.position;
+            _identityCard.sizeDelta = size;
+            if (_identitySurface != null)
+            {
+                // Leave the first instruction and the preview visible together in short viewports.
+                float previewHeight = size.y < 420 ? Mathf.Max(72, size.y - 262) : Mathf.Clamp(size.y * .36f, 100, 220);
+                _identityCameraLayout.minHeight = _identityCameraLayout.preferredHeight = previewHeight;
+            }
+            _identityTransition?.CaptureExpandedBounds();
+        }
+
+        private void UpdateIdentityGuidePreview(Texture texture, int rotation, bool mirrored)
+        {
+            if (_identityPreview == null || texture == null || texture.width < 1 || texture.height < 1) return;
+            _identityPreview.enabled = true; _identityPreview.texture = texture;
+            LayoutUprightCamera(_identityPreview, _identitySurface, _identityAspect, texture.width, texture.height, rotation, mirrored);
+        }
+
+        private void TickIdentityGuide()
+        {
+            if (_identityGuide == null) return;
+            LayoutIdentityGuide();
+            if (_identityCapturedFrame != null)
+            { UpdateIdentityGuidePreview(_identityCapturedFrame, 0, true); return; }
+            bool ready = !_editorPreview;
+            if (_identityFace)
+            {
+                var camera = _chat?.VisualCamera;
+                ready &= camera != null && camera.isPlaying && camera.width > 16;
+                if (ready) UpdateIdentityGuidePreview(camera, camera.videoRotationAngle, camera.videoVerticallyMirrored);
+                else { _identityPreview.enabled = false; _identityPreview.texture = null; }
+                string hint = _editorPreview ? "Preview only. Camera is not started." :
+                    ready ? "Keep one face in view, look straight ahead and use even lighting." : "Camera not ready. Enable vision, save settings and check the camera preview first.";
+                var observation = _chat?.Interaction?.Camera.LatestObservation;
+                if (ready && observation.HasValue && Time.realtimeSinceStartupAsDouble - observation.Value.CapturedAt <= .75)
+                {
+                    var count = observation.Value.DetectionFrame?.Detections.Count;
+                    if (count == 0) { hint = "No face in view. Move into the camera frame."; ready = false; }
+                    else if (count > 1) { hint = "Several faces in view. Keep only the person being recorded in frame."; ready = false; }
+                }
+                _identityCameraHint.text = Localize(hint);
+            }
+            if (_identityResult == null) _identityRecord.interactable = _identityCapture == null && ready;
+        }
+
+        private void ResetIdentityGuide()
+        {
+            if (_identityCapturedFrame != null) Release(_identityCapturedFrame);
+            _identityCapturedFrame = null; _identityResult = null;
+            _identityStep.text = Localize("1 · Prepare");
+            _identityInstructions.text = Localize(_identityFace
+                ? "Keep only your face in view. Capture starts after a three-second countdown. Then review before adding it."
+                : "Record four seconds of your voice in a quiet place. Then review before adding it.");
+            _identityRecord.GetComponentInChildren<Text>().text = Localize(_identityFace ? "Capture face" : "Record voice");
+            _identityRetake.gameObject.SetActive(false); _identityProgress.gameObject.SetActive(false);
+            TickIdentityGuide();
+        }
+
+        private async void HandleIdentityRecord()
+        {
+            if (_identityResult != null) { ApplyIdentityRecording(); return; }
+            if (_identityCapture != null || _editorPreview) return;
+            ResetIdentityGuide();
+            var guide = _identityGuide;
+            var cancellation = _identityCapture = new CancellationTokenSource();
+            int generation = _settingsGeneration;
+            SetSettingsBusy(true, allowClose: true); _identityRecord.interactable = false;
+            _identityStep.text = Localize("2 · Capture");
+            try
+            {
+                if (_identityFace)
+                    for (int remaining = 3; remaining > 0; --remaining)
+                    {
+                        _identityInstructions.text = LocalizeFormat("Look at the camera · {0}", remaining);
+                        await Task.Delay(1000, cancellation.Token);
+                    }
+                _identityInstructions.text = Localize(_identityFace ? "Checking the captured face…" : "Recording… Speak alone for four seconds.");
+                _identityProgress.gameObject.SetActive(true);
+                _identityProgress.SetIndeterminate("");
+                var captured = await _chat.CaptureIdentityAsync(_settingsDraft.Acoustics.Snapshot(), _identityFace, _identityVoice,
+                    cancellation.Token, image => { if (_identityGuide == guide && !cancellation.IsCancellationRequested) ShowIdentityCaptureFrame(image); });
+                cancellation.Token.ThrowIfCancellationRequested();
+                if (this == null || generation != _settingsGeneration || _identityGuide != guide || !IsSettingsOpen) return;
+                ReviewIdentityRecording(captured);
+            }
+            catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
+            catch (Exception error)
+            {
+                if (_identityGuide == guide && _identityInstructions != null)
+                {
+                    _identityInstructions.text = Localize(error.Message);
+                    _identityRecord.GetComponentInChildren<Text>().text = Localize("Try again");
+                    _identityRecord.interactable = true;
+                    _identityRetake.gameObject.SetActive(true);
+                }
+            }
+            finally
+            {
+                if (_identityCapture == cancellation) _identityCapture = null;
+                cancellation.Dispose();
+                if (_identityGuide == guide && _identityProgress != null) _identityProgress.gameObject.SetActive(false);
+                if (this != null && generation == _settingsGeneration && IsSettingsOpen) SetSettingsBusy(false);
+            }
+        }
+
+        private void ShowIdentityCaptureFrame(MNNRgbImage image)
+        {
+            if (_identityCapturedFrame != null) Release(_identityCapturedFrame);
+            _identityCapturedFrame = new Texture2D(image.Width, image.Height, TextureFormat.RGB24, false) { hideFlags = HideFlags.DontSave };
+            _identityCapturedFrame.LoadRawTextureData(image.ToArray()); _identityCapturedFrame.Apply();
+            UpdateIdentityGuidePreview(_identityCapturedFrame, 0, true);
+            _identityCameraHint.text = Localize("Captured frame · this image is cleared when you leave this guide.");
+        }
+
+        private void ReviewIdentityRecording(MNNInteractionIdentity captured)
+        {
+            _identityResult = captured;
+            _identityStep.text = Localize("3 · Review");
+            _identityInstructions.text = Localize("Recording ready. Use recording adds it to your draft. Save settings afterward to apply access rules.");
+            _identityRecord.GetComponentInChildren<Text>().text = Localize("Use recording");
+            _identityRecord.interactable = true; _identityRetake.gameObject.SetActive(true);
+        }
+
+        private void ApplyIdentityRecording()
+        {
+            var settings = _settingsDraft.Acoustics.interaction;
+            var people = new List<MNNInteractionIdentity>(settings.identities);
+            var previous = people.Find(person => person.id == _identityUpdating);
+            if (previous == null) people.Add(_identityResult);
+            else
+            {
+                if (_identityFace) { previous.face = _identityResult.face; previous.faceModel = _identityResult.faceModel; }
+                if (_identityVoice) { previous.voice = _identityResult.voice; previous.voiceModel = _identityResult.voiceModel; }
+            }
+            settings.identities = people.ToArray(); UpdateIdentityPolicy(settings);
+            CloseIdentityGuide(); ShowSettingsTab(_settingsTab, false);
+            SetSettingsNotice("Registration complete. Save to apply.");
+        }
+
+        private void CloseIdentityGuide()
+        {
+            _identityCapture?.Cancel();
+            var guide = _identityGuide; var transition = _identityTransition;
+            _identityGuide = _identityCard = _identitySurface = null; _identityTransition = null;
+            _identityCameraLayout = null;
+            _identityPreview = null; _identityResult = null;
+            if (_identityCapturedFrame != null) Release(_identityCapturedFrame);
+            _identityCapturedFrame = null;
+            if (guide == null) return;
+            if (transition != null) transition.SetOpen(false, () => { if (guide != null) Release(guide.gameObject); });
+            else Release(guide.gameObject);
+        }
+    }
+}
