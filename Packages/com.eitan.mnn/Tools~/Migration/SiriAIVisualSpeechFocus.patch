@@ -0,0 +1,27 @@
+using System;
+
+namespace MNN.Unity
+{
+    /// <summary>Conservative five-landmark head-facing proxy. Not eye gaze, calibrated depth or trained 3D pose.</summary>
+    public static class MNNFaceFacing
+    {
+        public static float Estimate(MNNImagePoint[] points)
+        {
+            if (points == null || points.Length != 5) return 0;
+            foreach (var point in points)
+                if (float.IsNaN(point.X) || float.IsInfinity(point.X) || float.IsNaN(point.Y) || float.IsInfinity(point.Y)) return 0;
+            double dx = points[1].X - points[0].X, dy = points[1].Y - points[0].Y;
+            double distance = Math.Sqrt(dx * dx + dy * dy);
+            if (distance < 1) return 0;
+            double x = (points[0].X + points[1].X) * .5, y = (points[0].Y + points[1].Y) * .5;
+            double nx = points[2].X - x, ny = points[2].Y - y;
+            double mouthX = (points[3].X + points[4].X) * .5 - x, mouthY = (points[3].Y + points[4].Y) * .5 - y;
+            double down = (-dy * mouthX + dx * mouthY) / distance;
+            if (down < distance * .35) return 0;
+            double yaw = Math.Abs(dx * nx + dy * ny) / (distance * distance);
+            double pitch = (-dy * nx + dx * ny) / (distance * down);
+            double roll = Math.Abs(Math.Atan2(dy, dx));
+            return (float)(Math.Max(0, 1 - yaw / .45) * Math.Max(0, 1 - Math.Abs(pitch - .5) / .45) * Math.Max(0, 1 - roll / 1.2));
+        }
+    }
+}
