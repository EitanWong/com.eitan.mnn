+using System;
+using System.Collections.Generic;
+
+namespace MNN.Unity
+{
+    public enum MNNVisualSpeechActivityState { WaitingForVideo, FacingAway, Quiet, Speaking }
+
+    /// <summary>Timestamped visual VAD evidence for one automatically selected face.
+    /// Mouth changes must exceed upper-face motion; uniform lighting shifts do not count.
+    /// Thresholds are conservative heuristics, not a calibrated lip-reading/3D-pose model.</summary>
+    public sealed class MNNVisualSpeechActivity
+    {
+        private readonly object _gate = new object();
+        private readonly Queue<Motion> _motion = new Queue<Motion>();
+        private readonly Queue<Facing> _facing = new Queue<Facing>();
+        private float[] _previous;
+        private string _track;
+        private double _previousTime;
+
+        public void Observe(float[] crop, double capturedAt, string track)
+        {
+            if (crop == null || crop.Length != 112 * 112) throw new ArgumentException("Supply a normalized 112x112 face crop.", nameof(crop));
+            Validate(capturedAt, track);
+            foreach (float value in crop) if (float.IsNaN(value) || float.IsInfinity(value)) throw new ArgumentException("Crop must be finite.", nameof(crop));
+            lock (_gate)
+            {
+                Track(track);
+                if (_previous != null && capturedAt <= _previousTime) return;
+                bool active = false;
+                if (_previous != null && capturedAt - _previousTime <= .12)
+                {
+                    double lighting = Difference(crop, _previous, 26, 28, 86, 64, 0, false);
+                    double upper = Difference(crop, _previous, 26, 28, 86, 64, lighting, true);
+                    double mouth = Difference(crop, _previous, 34, 76, 78, 104, lighting, true);
+                    active = mouth >= .04 && mouth > upper * 1.8 + .015;
+                }
+                _previous = (float[])crop.Clone(); _previousTime = capturedAt;
+                while (_motion.Count >= 160) _motion.Dequeue();
+                _motion.Enqueue(new Motion(capturedAt, active));
+            }
+        }
+
+        public void ObserveFacing(float confidence, double capturedAt, string track)
+        {
+            Validate(capturedAt, track);
+            if (float.IsNaN(confidence) || confidence < 0 || confidence > 1) throw new ArgumentOutOfRangeException(nameof(confidence));
+            lock (_gate)
+            {
+                Track(track);
+                if (_facing.Count > 0 && capturedAt <= _lastFacingTime) return;
+                while (_facing.Count >= 64) _facing.Dequeue();
+                _facing.Enqueue(new Facing(capturedAt, confidence)); _lastFacingTime = capturedAt;
+            }
+        }
+        private double _lastFacingTime;
+
+        public MNNVisualSpeechActivityState GetState(double audioCapturedAt)
+        {
+            MNNPresenceOptions.RequireTime(audioCapturedAt, nameof(audioCapturedAt));
+            lock (_gate)
+            {
+                double nearestVideo = double.PositiveInfinity, nearestFacing = double.PositiveInfinity;
+                float facing = 0; int moving = 0;
+                foreach (var sample in _motion)
+                {
+                    double age = audioCapturedAt - sample.Time;
+                    if (age < -.08) continue;
+                    nearestVideo = Math.Min(nearestVideo, Math.Abs(age));
+                    if (sample.Active && age >= -.08 && age <= .22) ++moving;
+                }
+                foreach (var sample in _facing)
+                {
+                    double age = audioCapturedAt - sample.Time;
+                    if (age < -.08 || age > .2 || Math.Abs(age) >= nearestFacing) continue;
+                    nearestFacing = Math.Abs(age); facing = sample.Confidence;
+                }
+                if (nearestVideo > .12 || double.IsPositiveInfinity(nearestFacing)) return MNNVisualSpeechActivityState.WaitingForVideo;
+                if (facing < .35) return MNNVisualSpeechActivityState.FacingAway;
+                return moving >= 2 ? MNNVisualSpeechActivityState.Speaking : MNNVisualSpeechActivityState.Quiet;
+            }
+        }
+
+        public void Clear() { lock (_gate) { _track = null; _previous = null; _motion.Clear(); _facing.Clear(); _previousTime = _lastFacingTime = 0; } }
+        private void Track(string track)
+        {
+            if (_track == track) return;
+            _track = track; _previous = null; _motion.Clear(); _facing.Clear(); _previousTime = _lastFacingTime = 0;
+        }
+        private static void Validate(double time, string track)
+        {
+            MNNPresenceOptions.RequireTime(time, nameof(time));
+            if (string.IsNullOrWhiteSpace(track)) throw new ArgumentException("Supply a target track.", nameof(track));
+        }
+        private static double Difference(float[] next, float[] previous, int left, int top, int right, int bottom, double lighting, bool absolute)
+        {
+            double sum = 0;
+            for (int y = top; y < bottom; ++y)
+                for (int x = left; x < right; ++x)
+                { double change = next[y * 112 + x] - previous[y * 112 + x] - lighting; sum += absolute ? Math.Abs(change) : change; }
+            return sum / ((right - left) * (bottom - top));
+        }
+        private readonly struct Motion
+        {
+            internal readonly double Time; internal readonly bool Active;
+            internal Motion(double time, bool active) { Time = time; Active = active; }
+        }
+        private readonly struct Facing
+        {
+            internal readonly double Time; internal readonly float Confidence;
+            internal Facing(double time, float confidence) { Time = time; Confidence = confidence; }
+        }
+    }
+}
