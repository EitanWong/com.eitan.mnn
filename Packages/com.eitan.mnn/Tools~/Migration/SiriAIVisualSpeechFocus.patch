@@ -0,0 +1,61 @@
+using NUnit.Framework;
+
+namespace MNN.Unity.Tests
+{
+    public sealed class VisualSpeechActivityTests
+    {
+        private static float[] Crop(float mouth = 0, float light = 0)
+        {
+            var crop = new float[112 * 112];
+            for (int y = 0; y < 112; ++y)
+                for (int x = 0; x < 112; ++x) crop[y * 112 + x] = light + (x >= 34 && x < 78 && y >= 76 && y < 104 ? mouth : 0);
+            return crop;
+        }
+
+        [Test]
+        public void SilentTargetCannotQualifyBystanderAudioAndLightingCannotImitateLips()
+        {
+            var activity = new MNNVisualSpeechActivity();
+            activity.ObserveFacing(1, 1, "target");
+            for (int i = 0; i < 5; ++i) activity.Observe(Crop(light: i * .2f), 1 + i * .04, "target");
+            Assert.AreEqual(MNNVisualSpeechActivityState.Quiet, activity.GetState(1.16));
+        }
+
+        [Test]
+        public void MovingMouthAndFacingEvidenceStartAndEndIndependentlyOfBackgroundSound()
+        {
+            var activity = new MNNVisualSpeechActivity();
+            activity.ObserveFacing(1, 1, "target");
+            activity.Observe(Crop(), 1, "target");
+            activity.Observe(Crop(.3f), 1.04, "target");
+            activity.Observe(Crop(), 1.08, "target");
+            Assert.AreEqual(MNNVisualSpeechActivityState.Speaking, activity.GetState(1.08));
+            for (int i = 3; i <= 12; ++i)
+            { activity.Observe(Crop(), 1 + i * .04, "target"); activity.ObserveFacing(1, 1 + i * .04, "target"); }
+            Assert.AreEqual(MNNVisualSpeechActivityState.Quiet, activity.GetState(1.48));
+        }
+
+        [Test]
+        public void TurnedHeadStaleVideoAndDifferentTargetsNeverReuseOldSpeechEvidence()
+        {
+            var activity = new MNNVisualSpeechActivity();
+            activity.ObserveFacing(.1f, 1, "target");
+            activity.Observe(Crop(), 1, "target"); activity.Observe(Crop(.3f), 1.04, "target"); activity.Observe(Crop(), 1.08, "target");
+            Assert.AreEqual(MNNVisualSpeechActivityState.FacingAway, activity.GetState(1.08));
+            Assert.AreEqual(MNNVisualSpeechActivityState.WaitingForVideo, activity.GetState(2));
+            activity.Observe(Crop(.4f), 2.04, "new-target");
+            Assert.AreEqual(MNNVisualSpeechActivityState.WaitingForVideo, activity.GetState(2.04));
+        }
+
+        [Test]
+        public void FacingEstimateUsesHeadGeometryWithoutClaimingEyeGaze()
+        {
+            var points = new[] { new MNNImagePoint(38, 52), new MNNImagePoint(74, 52), new MNNImagePoint(56, 72),
+                new MNNImagePoint(42, 92), new MNNImagePoint(70, 92) };
+            Assert.Greater(MNNFaceFacing.Estimate(points), .9);
+            points[2] = new MNNImagePoint(78, 72);
+            Assert.Less(MNNFaceFacing.Estimate(points), .35);
+            Assert.AreEqual(0, MNNFaceFacing.Estimate(null));
+        }
+    }
+}
