+                    TestContext.WriteLine(style + " absent brightness ratio=" + dim/bright + " alpha ratio=" + fadedAlpha/alpha + "; hidden desktop RGBA=0; hidden scene=background");
+                }
+                finally { Shader.SetGlobalFloat("_SiriDesktopMode", desktop); Shader.SetGlobalFloat("_SiriDesktopBackdropAvailable", available); }
+            }
