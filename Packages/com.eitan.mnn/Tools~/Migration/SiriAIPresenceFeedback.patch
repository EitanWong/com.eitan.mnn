+                    var awake = view.Render(1);
+                    view.Material.SetFloat("_PresenceVisibility", .25f);
+                    var absent = view.Render(1);
+                    double bright = 0, dim = 0, alpha = 0, fadedAlpha = 0;
+                    for (int i = 0; i < awake.Length; ++i)
+                    { bright += awake[i].grayscale; dim += absent[i].grayscale; alpha += awake[i].a; fadedAlpha += absent[i].a; }
+                    Assert.Less(dim, bright * .5);
