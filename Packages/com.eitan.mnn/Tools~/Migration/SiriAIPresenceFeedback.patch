+// Preserve the unbent scene when fading; desktop output is premultiplied RGBA for the OS compositor.
+float4 siriPresenceComposite(float4 foreground, float3 background)
+{
+    float amount = saturate(_PresenceVisibility);
+    foreground.rgb *= lerp(.35, 1.0, amount);
+    return _SiriDesktopMode > .5 ? foreground * amount : lerp(float4(background, 1), foreground, amount);
+}
+float3 siriPresenceLight(float3 color)
+{
+    float amount = saturate(_PresenceVisibility);
+    return color * amount * lerp(.35, 1.0, amount);
+}
 #endif
