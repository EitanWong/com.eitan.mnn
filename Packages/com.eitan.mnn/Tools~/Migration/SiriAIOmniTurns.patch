+                legacy.vadMode = SiriAIVadMode.Energy;
+                legacy.turnMode = SiriAITurnMode.Silence;
+                Directory.CreateDirectory(Path.GetDirectoryName(file));
+                File.WriteAllText(file, JsonUtility.ToJson(legacy));
+                Assert.True(backend.LoadSettings());
+                var loaded = backend.GetConfiguration();
+                Assert.True(loaded.useVoiceActivityModel, "Saved false flags must not disable local Omni endpointing.");
+                Assert.True(loaded.useTurnDetectionModel);
+                Assert.AreEqual(SiriAIVadMode.Provider, loaded.EffectiveVadMode);
+                Assert.AreEqual(SiriAITurnMode.Provider, loaded.EffectiveTurnMode);
+                Assert.AreEqual(legacy.model.model, loaded.model.model);
+                var saved = JsonUtility.FromJson<SiriAIBackendConfiguration>(File.ReadAllText(file));
+                Assert.True(saved.useVoiceActivityModel && saved.useTurnDetectionModel);
+                string normalized = File.ReadAllText(file);
+                Assert.True(backend.LoadSettings());
+                Assert.AreEqual(normalized, File.ReadAllText(file), "Reload is idempotent.");
+                CollectionAssert.AreEqual(new[] { "model", "vad", "turn" },
+                    SiriAIStagePlan.ForRoute(loaded, MNNRealtimeRoute.EndToEndSpeech).Endpoints(loaded).Select(pair => pair.Key));
+            }
+            finally
+            {
+                if (File.Exists(file)) File.Delete(file);
+                UnityEngine.Object.DestroyImmediate(root);
+            }
+        }
+
+        [Test]
+        public void SwitchingToLocalOmniEnablesProviderDetectionAndPreservesCascadedPreferences()
+        {
+            var config = new SiriAIBackendConfiguration { mode = SiriAIConversationMode.Cascaded,
+                useVoiceActivityModel = false, useTurnDetectionModel = false };
+            var catalog = new SiriAIModelCatalog();
+            SiriAISettingsConstraints.Normalize(config, catalog);
+            Assert.False(config.useVoiceActivityModel || config.useTurnDetectionModel);
+            config.mode = SiriAIConversationMode.RealtimeSpeech;
+            SiriAISettingsConstraints.Normalize(config, catalog);
+            Assert.True(config.useVoiceActivityModel && config.useTurnDetectionModel);
+            Assert.AreEqual(SiriAIVadMode.Provider, config.EffectiveVadMode);
+            Assert.AreEqual(SiriAITurnMode.Provider, config.EffectiveTurnMode);
+        }
+    }
