+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using MNN.Unity;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIOmniEndpointingNativeTests
+    {
+        [UnityTest, Explicit("Uses installed MiniMind-o, Silero and SmartTurn. Generated speech with a noise tail; software capture/playback, not a physical microphone or duplex acceptance.")]
+        public IEnumerator LegacyOmniProfileEndsTwoCapturedTurnsAndReportsLatency()
+        {
+            string directory = Path.Combine(Application.streamingAssetsPath, "MNN/Models", MNNMiniMindO.InstallationName);
+            Assert.True(MNNMiniMindO.IsComplete(directory));
+            float[] speech;
+            using (var seed = MNNMiniMindO.Load(directory))
+                speech = MNNAudioResampling.Resample(seed.Generate("请说：你好。", 128).Waveform
+                    .Select(x => Math.Max(-1, Math.Min(1, x))).ToArray(), 24000, 16000);
+            Assert.Greater(speech.Length, 1600);
+            var random = new System.Random(7);
+            // RMS ~0.029 exceeds the old energy threshold. Silero must distinguish noise from speech.
+            var input = speech.Concat(Enumerable.Range(0, 48000).Select(_ => (float)(random.NextDouble() * .1 - .05))).ToArray();
+            var root = new GameObject("Omni endpointing native acceptance"); root.SetActive(false);
+            var backend = SiriAITestAccess.CreateBackend(root);
+            string settings = Path.Combine(backend.StorageDirectory, "settings.json");
+            var legacy = SiriAIConfigurableBackend.CreateMiniMindOVoiceConfiguration();
+            legacy.useVoiceActivityModel = legacy.useTurnDetectionModel = false;
+            Directory.CreateDirectory(Path.GetDirectoryName(settings));
+            File.WriteAllText(settings, JsonUtility.ToJson(legacy));
+            Assert.True(backend.LoadSettings());
+            var capture = new Capture();
+            var output = new MNNRealtimeOutputPipeline(new MNNPcmFormat(24000, 1), 240, blockCapacity: 1024);
+            var device = new MNNRealtimeCapabilities(MNNRealtimeFeature.DuplexDevice | MNNRealtimeFeature.PresentationClock |
+                MNNRealtimeFeature.HalfDuplexDevice, "Software PCM latency fixture", "No acoustic echo-control qualification", execution: MNNRealtimeExecution.Managed);
+            MNNRealtimeSession session = null;
+            var context = new SiriAIChatContext(capture, () => session, device);
+            var registration = backend.CreateRegistration(context);
+            var report = MNNRealtimeRouteSelector.SelectBest(registration.Model, registration.Device, registration.Tts,
+                registration.Asr, registration.Vad, registration.ExcludedRoutes, registration.RequireMeasuredSpeech,
+                registration.AllowBufferedSpeech).RequireSelected();
+            Assert.AreEqual(MNNRealtimeRoute.EndToEndSpeech, report.Route);
+            Assert.IsNull(registration.Asr); Assert.IsNull(registration.Tts);
+            var creating = registration.Factory.CreateAsync(report, output, CancellationToken.None);
+            while (!creating.IsCompleted) yield return null;
+            var runtime = creating.GetAwaiter().GetResult();
+            session = new MNNRealtimeSession(runtime, output);
+            var clock = System.Diagnostics.Stopwatch.StartNew();
+            var rendered = new List<float>();
+            var pcm = new float[240];
+            long presented = 0;
+            var measurements = new List<string>();
+            try
+            {
+                var start = session.StartAsync();
+                while (!start.IsCompleted) yield return null;
+                start.GetAwaiter().GetResult();
+                CollectionAssert.AreEquivalent(new[] { "model", "vad", "turn" }, backend.RuntimeModels.Select(entry => entry.Stage));
+                foreach (var entry in backend.RuntimeModels)
+                    TestContext.WriteLine("PREPARED=" + entry.Stage + " | " + entry.Model + " | " + entry.State + " | " + entry.Backend);
+                context.Input.SetRealtime(true);
+                for (int turn = 1; turn <= 2; ++turn)
+                {
+                    int sent = 0, samplesBefore = rendered.Count;
+                    double speechEnd = -1, submitted = -1, firstPcm = -1;
+                    double nextCapture = clock.Elapsed.TotalSeconds, nextRender = nextCapture;
+                    double deadline = nextCapture + 60;
+                    while (clock.Elapsed.TotalSeconds < deadline)
+                    {
+                        double now = clock.Elapsed.TotalSeconds;
+                        if (sent < input.Length && now >= nextCapture)
+                        {
+                            capture.Push(input, sent); sent += 512; nextCapture += .032;
+                            if (speechEnd < 0 && sent >= speech.Length) speechEnd = now;
+                        }
+                        while (context.TryReadTranscript(out var notice))
+                        {
+                            TestContext.WriteLine("TRANSCRIPT=" + notice.Text);
+                            if (!notice.Assistant && submitted < 0) submitted = now;
+                        }
+                        if (now >= nextRender)
+                        {
+                            nextRender = now + .01;
+                            output.Render(pcm, 0, pcm.Length);
+                            if (pcm.Any(x => Math.Abs(x) > 1e-6f))
+                            {
+                                if (firstPcm < 0) firstPcm = now;
+                                rendered.AddRange(pcm);
+                            }
+                            presented += pcm.Length;
+                            output.DrainReceipts(4096); output.AcknowledgePresentation(presented, false);
+                        }
+                        if (session.Fault != null) throw session.Fault;
+                        if (sent >= input.Length && firstPcm > 0 && output.QueuedFrames == 0) break;
+                        yield return null;
+                    }
+                    TestContext.WriteLine("INPUT_DIAGNOSTICS=" + ((MNNConversationRuntime)runtime).InputDiagnostics);
+                    Assert.Greater(submitted, 0, "A captured sentence must be submitted despite above-threshold background noise.");
+                    Assert.Greater(firstPcm, submitted, "Submission must produce software-rendered model speech.");
+                    Assert.Greater(rendered.Count, samplesBefore + 2400);
+                    double submitMs = (submitted - speechEnd) * 1000, firstMs = (firstPcm - speechEnd) * 1000;
+                    measurements.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
+                        "TURN={0} END_TO_SUBMIT_MS={1:F3} END_TO_FIRST_PCM_MS={2:F3} RENDERED_SAMPLES={3}",
+                        turn, submitMs, firstMs, rendered.Count - samplesBefore));
+                    Assert.Less(submitMs, 2500, "Endpointing should not wait for the recording limit.");
+                    var join = session.InterruptAsync();
+                    while (!join.IsCompleted) yield return null;
+                    join.GetAwaiter().GetResult();
+                }
+                string artifacts = Environment.GetEnvironmentVariable("SIRIAI_MINIMINDO_ARTIFACTS");
+                File.WriteAllLines(Path.Combine(artifacts, "endpointing-latency.txt"), measurements);
+                File.WriteAllBytes(Path.Combine(artifacts, "endpointing-replies.wav"), MNNWaveAudio.EncodePcm16(
+                    rendered.Select(x => Math.Max(-1, Math.Min(1, x))).ToArray(), 24000));
+                foreach (string measurement in measurements) TestContext.WriteLine(measurement);
+                TestContext.WriteLine("MODEL_NATIVE_FULL_DUPLEX=false; PHYSICAL_AUDIO_VERIFIED=false; ROUTE=" + report.Route);
+            }
+            finally
+            {
+                session.StopAsync().GetAwaiter().GetResult();
+                registration.ReleaseAsync?.Invoke().GetAwaiter().GetResult();
+                if (File.Exists(settings)) File.Delete(settings);
+                UnityEngine.Object.DestroyImmediate(root);
+            }
+        }
+
+        private sealed class Capture : IMNNAudioCaptureSource
+        {
+            private readonly MNNAudioCaptureBuffer _queue = new MNNAudioCaptureBuffer(128, 512);
+            private long _sequence;
+            public MNNPcmFormat CaptureFormat => new MNNPcmFormat(16000, 1);
+            public int MaximumCaptureSamples => 512;
+            public long DroppedCaptureBlocks => _queue.DroppedBlocks;
+            public bool HasPendingCaptureFrames => _queue.HasPendingFrames;
+            internal void Push(float[] source, int offset)
+            {
+                var block = new float[512]; Array.Copy(source, offset, block, 0, Math.Min(512, source.Length - offset));
+                var info = new MNNAudioFrameInfo(1, 1, _sequence, _sequence * 512,
+                    System.Diagnostics.Stopwatch.GetTimestamp(), CaptureFormat); ++_sequence;
+                Assert.True(_queue.TryWrite(block, 0, block.Length, info));
+            }
+            public bool TryReadCapture(float[] target, int offset, out MNNAudioFrameInfo info, out int count) =>
+                _queue.TryRead(target, offset, out info, out count);
+        }
+    }
+}
