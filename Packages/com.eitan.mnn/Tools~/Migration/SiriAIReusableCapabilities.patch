new file mode 100644
--- /dev/null
+++ b/Assets/Samples/SiriAI/Scripts/Tests/Runtime/Presentation/SiriAIMarkdownImagePlayerTests.cs
@@ -0,0 +1,62 @@
+using System.Collections;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+using UnityEngine.UI;
+
+namespace MNN.Samples.SiriAI.Tests
+{
+    public sealed class SiriAIMarkdownImagePlayerTests
+    {
+        [UnityTest]
+        [UnityPlatform(exclude = new[] { RuntimePlatform.WebGLPlayer })]
+        public IEnumerator HiddenPendingImageRestartsItsPlayerCoroutineAndReleasesItsTexture()
+        {
+            Assert.True(Application.isPlaying, "This check must exercise the Player coroutine rather than the Editor poller.");
+            var source = new Texture2D(3, 2, TextureFormat.RGBA32, false);
+            byte[] png = source.EncodeToPNG();
+            UnityEngine.Object.Destroy(source);
+            var server = new SiriAIDelayedImageServer(png);
+            var root = new GameObject("Markdown Player lifecycle", typeof(RectTransform), typeof(RawImage),
+                typeof(SiriAIMarkdownImageLoader));
+            try
+            {
+                var raw = root.GetComponent<RawImage>();
+                root.GetComponent<SiriAIMarkdownImageLoader>().Configure(raw, server.Url);
+                float deadline = Time.realtimeSinceStartup + 10;
+                while (!server.FirstRequestAccepted.IsCompleted && Time.realtimeSinceStartup < deadline) yield return null;
+                Assert.True(server.FirstRequestAccepted.IsCompleted, "The first real request must be in flight before hiding.");
+                server.FirstRequestAccepted.GetAwaiter().GetResult();
+                Assert.IsNull(raw.texture, "The first local response is deliberately held pending.");
+                root.SetActive(false);
+                yield return null;
+                Assert.IsNull(raw.texture);
+                root.SetActive(true);
+                deadline = Time.realtimeSinceStartup + 10;
+                while (raw.texture == null && Time.realtimeSinceStartup < deadline) yield return null;
+                Assert.IsNotNull(raw.texture, "Showing the unchanged binding must start a new Player coroutine.");
+                Assert.AreEqual(2, server.Requests, "The delayed first request cannot supply the displayed image.");
+                Assert.AreEqual(3, raw.texture.width);
+                Assert.AreEqual(2, raw.texture.height);
+                var texture = raw.texture;
+                root.SetActive(false);
+                SiriAIMarkdownImageLoader.SharedCache.Clear();
+                Assert.IsTrue(texture != null, "Native destruction is deferred until Unity completes the frame.");
+                yield return null;
+                Assert.IsTrue(texture == null, "Hiding the binding and clearing cache ownership release the native image.");
+                server.Dispose();
+                deadline = Time.realtimeSinceStartup + 10;
+                while (!server.Completion.IsCompleted && Time.realtimeSinceStartup < deadline) yield return null;
+                Assert.True(server.Completion.IsCompleted, "The local request owner must quiesce.");
+                server.Completion.GetAwaiter().GetResult();
+            }
+            finally
+            {
+                root.SetActive(false);
+                UnityEngine.Object.Destroy(root);
+                SiriAIMarkdownImageLoader.ReleaseSharedCache();
+                server.Dispose();
+            }
+        }
+    }
+}
