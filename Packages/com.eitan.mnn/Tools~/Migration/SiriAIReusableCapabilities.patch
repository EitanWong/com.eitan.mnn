+        private int _requests, _disposed;
+        public string Url { get; }
+        public Task FirstRequestAccepted => _firstAccepted.Task;
+        public Task Completion { get; }
+        public int Requests => Volatile.Read(ref _requests);
+
+        public SiriAIDelayedImageServer(byte[] png)
+        {
+            if (png == null || png.Length == 0) throw new ArgumentException("Supply a local PNG body.", nameof(png));
+            _listener.Start();
+            Url = "http://127.0.0.1:" + ((IPEndPoint)_listener.LocalEndpoint).Port + "/image.png";
+            Completion = AcceptAsync(png, _stop.Token);
+        }
+
+        private async Task AcceptAsync(byte[] png, CancellationToken token)
+        {
+            var responses = new List<Task>(2);
+            try
+            {
+                for (int request = 0; request < 2; ++request)
+                {
+                    var client = await _listener.AcceptTcpClientAsync().ConfigureAwait(false);
+                    lock (_clients)
+                    {
+                        if (Volatile.Read(ref _disposed) != 0) { client.Dispose(); break; }
+                        _clients.Add(client);
+                    }
+                    responses.Add(RespondAsync(client, request == 0, png, token));
+                }
+            }
+            catch (ObjectDisposedException) { }
+            catch (SocketException) when (token.IsCancellationRequested) { }
+            finally { await Task.WhenAll(responses).ConfigureAwait(false); }
+        }
+
+        private async Task RespondAsync(TcpClient client, bool first, byte[] png, CancellationToken token)
+        {
+            try
+            {
+                using (client)
+                using (var stream = client.GetStream())
+                {
+                    await ReadHeadersAsync(stream, token).ConfigureAwait(false);
+                    Interlocked.Increment(ref _requests);
+                    if (first)
+                    {
+                        _firstAccepted.TrySetResult(true);
+                        await _holdFirst.Task.ConfigureAwait(false);
+                    }
+                    byte[] response = Encoding.ASCII.GetBytes("HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: " +
+                        png.Length + "\r\nConnection: close\r\n\r\n");
+                    await stream.WriteAsync(response, 0, response.Length, token).ConfigureAwait(false);
+                    await stream.WriteAsync(png, 0, png.Length, token).ConfigureAwait(false);
+                }
+            }
+            catch (OperationCanceledException) when (token.IsCancellationRequested) { }
+            catch (ObjectDisposedException) { }
+            catch (IOException) { }
+            catch (SocketException) { }
+            finally { lock (_clients) _clients.Remove(client); }
+        }
+
+        private static async Task ReadHeadersAsync(Stream stream, CancellationToken token)
+        {
+            var buffer = new byte[1024];
+            var headers = new StringBuilder();
+            while (headers.ToString().IndexOf("\r\n\r\n", StringComparison.Ordinal) < 0)
+            {
+                int read = await stream.ReadAsync(buffer, 0, buffer.Length, token).ConfigureAwait(false);
+                if (read == 0 || headers.Length + read > 8192) throw new IOException("Incomplete local image request.");
+                headers.Append(Encoding.ASCII.GetString(buffer, 0, read));
+            }
+        }
+
+        public void Dispose()
+        {
+            if (Interlocked.Exchange(ref _disposed, 1) != 0) return;
+            _stop.Cancel();
+            _holdFirst.TrySetCanceled();
+            _listener.Stop();
+            TcpClient[] clients;
+            lock (_clients) clients = _clients.ToArray();
+            foreach (var client in clients) client.Dispose();
+            _stop.Dispose();
+        }
+    }
+}
